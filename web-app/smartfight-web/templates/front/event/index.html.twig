{% extends 'base.html.twig' %}

{% block title %}Events — SmartFight{% endblock %}

{% block body %}
<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="section-title mb-0">
            <i class="fas fa-calendar-alt me-2"></i>SmartFight <span>Events</span>
        </h1>
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
            <i class="fas fa-home me-1"></i>Home
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-secondary me-2" style="font-size:.85rem;letter-spacing:1px;text-transform:uppercase;">
                <i class="fas fa-filter me-1"></i>Filter:
            </span>
            <a href="{{ path('app_front_event_index') }}"
               class="btn btn-sm {{ status is null ? 'btn-danger' : 'btn-outline-secondary text-light' }}">
                <i class="fas fa-th me-1"></i>All
            </a>
            <a href="{{ path('app_front_event_index', {'status': 'SCHEDULED'}) }}"
               class="btn btn-sm {{ status == 'SCHEDULED' ? 'btn-danger' : 'btn-outline-secondary text-light' }}">
                <i class="fas fa-clock me-1"></i>Scheduled
            </a>
            <a href="{{ path('app_front_event_index', {'status': 'ONGOING'}) }}"
               class="btn btn-sm {{ status == 'ONGOING' ? 'btn-danger' : 'btn-outline-secondary text-light' }}">
                <i class="fas fa-play me-1"></i>Ongoing
            </a>
            <a href="{{ path('app_front_event_index', {'status': 'COMPLETED'}) }}"
               class="btn btn-sm {{ status == 'COMPLETED' ? 'btn-danger' : 'btn-outline-secondary text-light' }}">
                <i class="fas fa-check me-1"></i>Completed
            </a>
            <a href="{{ path('app_front_event_index', {'status': 'CANCELLED'}) }}"
               class="btn btn-sm {{ status == 'CANCELLED' ? 'btn-danger' : 'btn-outline-secondary text-light' }}">
                <i class="fas fa-ban me-1"></i>Cancelled
            </a>
        </div>
    </div>

    <!-- Events Grid -->
    {% if events is empty %}
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-5x text-secondary mb-4"></i>
            <h4 class="text-secondary">No events found</h4>
            <p class="text-secondary">No public events match your filter.</p>
            <a href="{{ path('app_front_event_index') }}" class="btn btn-danger mt-2">
                <i class="fas fa-sync me-1"></i>View all events
            </a>
        </div>
    {% else %}
        <div class="row g-4">
            {% for event in events %}
                <div class="col-xl-4 col-md-6">
                    <div class="event-card h-100">
                        <div class="event-card-banner"></div>
                        <div class="event-card-body d-flex flex-column">
                            <!-- Status + Visibility -->
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge badge-{{ event.status|lower }} px-3 py-2">
                                    {% if event.status == 'SCHEDULED' %}<i class="fas fa-clock me-1"></i>Scheduled
                                    {% elseif event.status == 'ONGOING' %}<i class="fas fa-play me-1"></i>Ongoing
                                    {% elseif event.status == 'COMPLETED' %}<i class="fas fa-check me-1"></i>Completed
                                    {% else %}<i class="fas fa-ban me-1"></i>Cancelled{% endif %}
                                </span>
                                <span class="badge bg-secondary px-3 py-2">
                                    {% if event.visibility == 'PUBLIC' %}
                                        <i class="fas fa-globe me-1"></i>Public
                                    {% else %}
                                        <i class="fas fa-lock me-1"></i>Private
                                    {% endif %}
                                </span>
                            </div>

                            <!-- Name -->
                            <h5 class="event-name">{{ event.name }}</h5>

                            <!-- Meta -->
                            <div class="event-meta d-flex flex-column gap-2 flex-grow-1">
                                <span>
                                    <i class="fas fa-play-circle"></i>
                                    Start: <strong class="text-light">{{ event.startDate|date('d/m/Y') }}</strong>
                                </span>
                                <span>
                                    <i class="fas fa-stop-circle"></i>
                                    End: <strong class="text-light">{{ event.endDate|date('d/m/Y') }}</strong>
                                </span>
                                {% if event.venue %}
                                    <span>
                                        <i class="fas fa-map-marker-alt"></i>
                                        {{ event.venue.name }}{% if event.venue.city %}, {{ event.venue.city }}{% endif %}
                                    </span>
                                {% endif %}
                                {% if event.discipline %}
                                    <span>
                                        <i class="fas fa-running"></i>
                                        {{ event.discipline.name }}
                                    </span>
                                {% endif %}
                                <span>
                                    <i class="fas fa-users"></i>
                                    Capacity: <strong class="text-light">{{ event.capacity }}</strong> seats
                                </span>
                            </div>

                            <!-- Action -->
                            <div class="mt-3">
                                <a href="{{ path('app_front_event_show', {'id': event.id}) }}"
                                   class="btn btn-outline-danger btn-sm w-100">
                                    <i class="fas fa-eye me-1"></i>View details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mt-4 text-secondary small">
            <i class="fas fa-info-circle me-1"></i>
            {{ events|length }} event(s) displayed
        </div>
    {% endif %}
</div>
{% endblock %}
