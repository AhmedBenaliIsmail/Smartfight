<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SmartFight{% endblock %}</title>

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&family=Exo+2:wght@300;400;600;700;900&display=swap');

        :root {
            --sf-red:    #e50914;
            --sf-dark:   #0a0a0a;
            --sf-navy:   #1a1a2e;
            --sf-blue:   #16213e;
            --sf-card:   #12122a;
            --sf-border: #2a2a4e;
            --sf-gold:   #ffd700;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--sf-dark);
            color: #e8e8f0;
            font-family: 'Exo 2', 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        /* ── Navbar ── */
        .navbar {
            background: linear-gradient(135deg, var(--sf-navy) 0%, var(--sf-blue) 100%);
            border-bottom: 2px solid var(--sf-red);
            padding: 0.75rem 0;
            box-shadow: 0 4px 20px rgba(229,9,20,0.3);
        }
        .navbar-brand {
            color: var(--sf-red) !important;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: 3px;
            text-shadow: 0 0 20px rgba(229,9,20,0.5);
        }
        .navbar-brand:hover { text-shadow: 0 0 30px rgba(229,9,20,0.9); }
        .nav-link {
            color: #c8c8d8 !important;
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
            padding: 0.5rem 1rem !important;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0; left: 50%; right: 50%;
            height: 2px;
            background: var(--sf-red);
            transition: all 0.3s;
        }
        .nav-link:hover { color: #ffffff !important; }
        .nav-link:hover::after { left: 0; right: 0; }
        .btn-admin {
            background: var(--sf-red) !important;
            border-color: var(--sf-red) !important;
            color: #fff !important;
            border-radius: 4px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-admin:hover {
            background: #b8000e !important;
            box-shadow: 0 0 15px rgba(229,9,20,0.5);
            transform: translateY(-1px);
        }

        /* ── Cards ── */
        .card {
            background: var(--sf-card);
            border: 1px solid var(--sf-border);
            border-radius: 12px;
            color: #e8e8f0;
            transition: all 0.3s;
        }
        .card:hover { transform: translateY(-4px); border-color: var(--sf-red); box-shadow: 0 8px 30px rgba(229,9,20,0.2); }
        .card-header { background: rgba(229,9,20,0.1); border-bottom: 1px solid var(--sf-border); }

        /* ── Badges ── */
        .badge-scheduled { background: #3498db; color: #fff; }
        .badge-ongoing   { background: #27ae60; color: #fff; }
        .badge-completed { background: #7f8c8d; color: #fff; }
        .badge-cancelled { background: #e74c3c; color: #fff; }
        .badge-pending   { background: #f39c12; color: #fff; }
        .badge-in_review { background: #3498db; color: #fff; }
        .badge-resolved  { background: #27ae60; color: #fff; }
        .badge-rejected  { background: #e74c3c; color: #fff; }

        /* ── Buttons ── */
        .btn-danger  { background: var(--sf-red); border-color: var(--sf-red); }
        .btn-danger:hover { background: #b8000e; }
        .btn-outline-danger { border-color: var(--sf-red); color: var(--sf-red); }
        .btn-outline-danger:hover { background: var(--sf-red); color: #fff; }

        /* ── Flash ── */
        .alert { border-radius: 0; }

        /* ── Form controls ── */
        .form-control, .form-select {
            background: #1e1e3a;
            border: 1px solid var(--sf-border);
            color: #e8e8f0;
            border-radius: 8px;
        }
        .form-control:focus, .form-select:focus {
            background: #1e1e3a;
            border-color: var(--sf-red);
            box-shadow: 0 0 0 3px rgba(229,9,20,0.15);
            color: #fff;
        }
        .form-label { color: #a8a8c8; font-weight: 500; }

        /* ── Sections ── */
        .section-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            border-left: 4px solid var(--sf-red);
            padding-left: 1rem;
            margin-bottom: 1.5rem;
        }
        .section-title span { color: var(--sf-red); }

        /* ── Footer ── */
        footer {
            background: var(--sf-navy);
            border-top: 2px solid var(--sf-red);
            color: #8a8a9a;
        }
        footer strong { color: var(--sf-red); }

        /* ── Hero ── */
        .hero-section {
            background: linear-gradient(135deg, #0a0a0a 0%, #1a0a0a 40%, #0a0a1a 100%);
            position: relative;
            overflow: hidden;
            padding: 6rem 0;
        }
        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at center, rgba(229,9,20,0.08) 0%, transparent 70%);
        }
        .hero-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 700;
            letter-spacing: 8px;
            color: #fff;
            text-shadow: 0 0 40px rgba(229,9,20,0.5);
        }
        .hero-title span { color: var(--sf-red); }
        .hero-subtitle { color: #8a8aaa; font-size: 1.1rem; letter-spacing: 2px; }

        /* ── Stat cards ── */
        .stat-card {
            background: var(--sf-card);
            border: 1px solid var(--sf-border);
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--sf-red);
        }
        .stat-number {
            font-family: 'Rajdhani', sans-serif;
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--sf-red);
            line-height: 1;
        }
        .stat-label { color: #8a8aaa; font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; margin-top: 0.5rem; }

        /* ── Event cards ── */
        .event-card {
            height: 100%;
            background: var(--sf-card);
            border: 1px solid var(--sf-border);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s;
        }
        .event-card:hover {
            transform: translateY(-6px);
            border-color: var(--sf-red);
            box-shadow: 0 12px 40px rgba(229,9,20,0.25);
        }
        .event-card-banner {
            height: 6px;
            background: linear-gradient(90deg, var(--sf-red), #ff4d4d);
        }
        .event-card-body { padding: 1.5rem; }
        .event-name { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.75rem; }
        .event-meta { color: #8a8aaa; font-size: 0.85rem; }
        .event-meta i { color: var(--sf-red); width: 16px; }

        /* ── Filter bar ── */
        .filter-bar { background: var(--sf-navy); border: 1px solid var(--sf-border); border-radius: 12px; padding: 1rem 1.5rem; }

        /* ── Tables ── */
        .table-dark-custom { background: var(--sf-card); border-radius: 12px; overflow: hidden; }
        .table-dark-custom table { margin: 0; }
        .table-dark-custom th { background: rgba(229,9,20,0.15); color: #fff; border-color: var(--sf-border); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; }
        .table-dark-custom td { border-color: var(--sf-border); color: #c8c8d8; vertical-align: middle; }
        .table-dark-custom tr:hover td { background: rgba(229,9,20,0.05); }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- ── Navbar ── -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="fas fa-fist-raised me-2"></i>SMARTFIGHT
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">
                        <i class="fas fa-home me-1"></i>Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_front_event_index') }}">
                        <i class="fas fa-calendar-alt me-1"></i>Events
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_reclamation_new') }}">
                        <i class="fas fa-envelope me-1"></i>Contact Us
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_reclamation_index') }}">
                        <i class="fas fa-list me-1"></i>My Reclamations
                    </a>
                </li>
                <li class="nav-item ms-2">
                    <a class="nav-link btn-admin px-3 py-2" href="{{ path('app_admin_event_index') }}">
                        <i class="fas fa-cog me-1"></i>Admin
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ── Flash messages ── -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 py-2" role="alert">
        <div class="container"><i class="fas fa-check-circle me-2"></i>{{ message }}</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 py-2" role="alert">
        <div class="container"><i class="fas fa-exclamation-circle me-2"></i>{{ message }}</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endfor %}

<main>
    {% block body %}{% endblock %}
</main>

<!-- ── Footer ── -->
<footer class="py-4 mt-5">
    <div class="container text-center">
        <p class="mb-1">
            <strong>SMARTFIGHT</strong> — Combat Sports Management Platform
        </p>
        <p class="mb-0 small">
            © 2025 ESPRIT Tunisia | 3rd Year PIDEV Project
            <span class="mx-2">|</span>
            <a href="{{ path('app_admin_event_index') }}" class="text-danger text-decoration-none">Admin</a>
        </p>
    </div>
</footer>

<!-- Bootstrap 5.3 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
