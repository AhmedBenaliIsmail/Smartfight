{% extends 'base.html.twig' %}

{% block title %}SmartFight — Plateforme de Sports de Combat{% endblock %}

{% block body %}

<!-- ── Hero Section ── -->
<section class="hero-section text-center">
    <div class="container position-relative">
        <p class="hero-subtitle mb-3">
            <i class="fas fa-star text-danger me-2"></i>OFFICIAL COMBAT SPORTS PLATFORM<i class="fas fa-star text-danger ms-2"></i>
        </p>
        <h1 class="hero-title mb-3">
            SMART<span>FIGHT</span>
        </h1>
        <p class="hero-subtitle mb-5">
            Manage your events · Track your fighters · Dominate the ring
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="{{ path('app_front_event_index') }}" class="btn btn-danger btn-lg px-4 py-3">
                <i class="fas fa-calendar-alt me-2"></i>View Events
            </a>
            <a href="{{ path('app_reclamation_new') }}" class="btn btn-outline-light btn-lg px-4 py-3">
                <i class="fas fa-envelope me-2"></i>Submit a Reclamation
            </a>
        </div>
    </div>
</section>

<!-- ── Statistics ── -->
<section class="py-5" style="background: linear-gradient(180deg, #0a0a0a, #12121f);">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="stat-number">{{ totalEvents }}</div>
                    <i class="fas fa-calendar-alt fa-lg text-danger my-2"></i>
                    <div class="stat-label">Registered Events</div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="stat-number">{{ totalVenues }}</div>
                    <i class="fas fa-map-marker-alt fa-lg text-danger my-2"></i>
                    <div class="stat-label">Competition Venues</div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="stat-card">
                    <div class="stat-number">{{ totalDisciplines }}</div>
                    <i class="fas fa-running fa-lg text-danger my-2"></i>
                    <div class="stat-label">Sport Disciplines</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Upcoming Events ── -->
<section class="py-5">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-bolt text-danger me-2"></i>Upcoming <span>Events</span>
        </h2>

        {% if upcomingEvents is empty %}
            <div class="text-center py-5">
                <i class="fas fa-calendar-times fa-4x text-secondary mb-3"></i>
                <p class="text-secondary fs-5">No upcoming events at the moment.</p>
                <a href="{{ path('app_admin_event_new') }}" class="btn btn-danger mt-2">
                    <i class="fas fa-plus me-1"></i>Create an event
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for event in upcomingEvents %}
                    <div class="col-xl-4 col-md-6">
                        <div class="event-card h-100">
                            <div class="event-card-banner"></div>
                            <div class="event-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="badge badge-{{ event.status|lower }} fs-6">
                                        {% if event.status == 'SCHEDULED' %}Scheduled
                                        {% elseif event.status == 'ONGOING' %}Ongoing
                                        {% elseif event.status == 'COMPLETED' %}Completed
                                        {% else %}Cancelled{% endif %}
                                    </span>
                                    <span class="badge bg-secondary">{{ event.visibility == 'PUBLIC' ? 'Public' : 'Private' }}</span>
                                </div>
                                <h5 class="event-name">{{ event.name }}</h5>
                                <div class="event-meta d-flex flex-column gap-1">
                                    <span><i class="fas fa-calendar me-2"></i>{{ event.startDate|date('d/m/Y') }}</span>
                                    {% if event.venue %}
                                        <span><i class="fas fa-map-marker-alt me-2"></i>{{ event.venue.name }}{% if event.venue.city %}, {{ event.venue.city }}{% endif %}</span>
                                    {% endif %}
                                    {% if event.discipline %}
                                        <span><i class="fas fa-running me-2"></i>{{ event.discipline.name }}</span>
                                    {% endif %}
                                    <span><i class="fas fa-users me-2"></i>{{ event.capacity }} seats</span>
                                </div>
                                <div class="mt-3">
                                    <a href="{{ path('app_front_event_show', {'id': event.id}) }}"
                                       class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-eye me-1"></i>View details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-5">
                <a href="{{ path('app_front_event_index') }}" class="btn btn-danger btn-lg px-5">
                    <i class="fas fa-list me-2"></i>View all events
                </a>
            </div>
        {% endif %}
    </div>
</section>

<!-- ── CTA ── -->
<section class="py-5" style="background: linear-gradient(135deg, #1a0505, #0a0a1a);">
    <div class="container text-center">
        <h3 class="mb-3" style="font-family:'Rajdhani',sans-serif;font-size:2rem;color:#fff;">
            Do you have a <span style="color:#e50914;">reclamation</span>?
        </h3>
        <p class="text-secondary mb-4">Our team handles all requests as quickly as possible.</p>
        <a href="{{ path('app_reclamation_new') }}" class="btn btn-danger btn-lg px-5">
            <i class="fas fa-paper-plane me-2"></i>Submit a Reclamation
        </a>
    </div>
</section>

{% endblock %}
