<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SmartFight Admin{% endblock %}</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 4 (required by AdminLTE) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
    <!-- AdminLTE -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Exo+2:wght@400;600&display=swap');

        :root { --sf-red: #e50914; }

        .brand-link { background: var(--sf-red) !important; border-bottom: none !important; }
        .brand-link:hover { background: #b8000e !important; }
        .brand-text { font-family: 'Rajdhani', sans-serif; letter-spacing: 3px; font-size: 1.3rem; }

        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active,
        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active:hover {
            background-color: var(--sf-red) !important;
            color: #fff !important;
        }
        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link:hover {
            background-color: rgba(229,9,20,0.15) !important;
            color: #fff !important;
        }
        .main-header { border-bottom: 1px solid #dee2e6; }
        .content-wrapper { background: #f0f0f5; }
        .card { border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); border: none; }
        .card-header { font-weight: 600; }
        .btn-primary { background: var(--sf-red); border-color: var(--sf-red); }
        .btn-primary:hover { background: #b8000e; border-color: #b8000e; }
        .badge-scheduled { background: #3498db; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-ongoing   { background: #27ae60; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-completed { background: #7f8c8d; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-cancelled { background: #e74c3c; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-pending   { background: #f39c12; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-in-review { background: #3498db; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-resolved  { background: #27ae60; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .badge-rejected  { background: #e74c3c; color: #fff; padding: 4px 8px; border-radius: 4px; }
        .main-sidebar { z-index: 1050; }
        .nav-sidebar .nav-link p { font-family: 'Exo 2', sans-serif; font-weight: 600; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <!-- ── Top Navbar ── -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                    <i class="fas fa-bars"></i>
                </a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <a href="{{ path('app_home') }}" class="nav-link">
                    <i class="fas fa-home"></i> Home
                </a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a href="{{ path('app_home') }}" class="nav-link" title="View public site">
                    <i class="fas fa-globe"></i>
                    <span class="d-none d-md-inline ml-1">Public Site</span>
                </a>
            </li>
            <li class="nav-item">
                <span class="nav-link">
                    <i class="fas fa-shield-alt text-danger"></i>
                    <span class="d-none d-md-inline ml-1" style="color:#e50914;font-weight:600;">ADMIN</span>
                </span>
            </li>
        </ul>
    </nav>

    <!-- ── Sidebar ── -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('app_home') }}" class="brand-link">
            <i class="fas fa-fist-raised ml-2 mr-2"></i>
            <span class="brand-text font-weight-bold">SMARTFIGHT</span>
        </a>

        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    <i class="fas fa-user-shield fa-2x ml-1" style="color:#e50914;"></i>
                </div>
                <div class="info">
                    <a href="#" class="d-block">Administrator</a>
                </div>
            </div>

            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">

                    <li class="nav-header">NASSIR MODULE</li>

                    <li class="nav-item">
                        <a href="{{ path('app_admin_event_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_event' %}active{% endif %}">
                            <i class="nav-icon fas fa-calendar-alt"></i>
                            <p>Events</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_venue_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_venue' %}active{% endif %}">
                            <i class="nav-icon fas fa-map-marker-alt"></i>
                            <p>Venues</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_discipline_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_discipline' %}active{% endif %}">
                            <i class="nav-icon fas fa-running"></i>
                            <p>Disciplines</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_admin_reclamation_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_reclamation' %}active{% endif %}">
                            <i class="nav-icon fas fa-exclamation-triangle"></i>
                            <p>Reclamations</p>
                        </a>
                    </li>

                    <li class="nav-header">OTHER MODULES</li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Fighters <span class="badge badge-secondary right">Other</span></p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-trophy"></i>
                            <p>Rankings <span class="badge badge-secondary right">Other</span></p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-fist-raised"></i>
                            <p>Results <span class="badge badge-secondary right">Other</span></p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-user-cog"></i>
                            <p>Users <span class="badge badge-secondary right">Other</span></p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-dumbbell"></i>
                            <p>Coaches <span class="badge badge-secondary right">Other</span></p>
                        </a>
                    </li>

                    <li class="nav-header">NAVIGATION</li>
                    <li class="nav-item">
                        <a href="{{ path('app_front_event_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-eye"></i>
                            <p>Public View</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_reclamation_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-envelope"></i>
                            <p>User Area</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- ── Content Wrapper ── -->
    <div class="content-wrapper">

        <!-- Page Header -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0" style="font-family:'Rajdhani',sans-serif;font-weight:700;">
                            {% block page_title %}Dashboard{% endblock %}
                        </h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_admin_event_index') }}">Admin</a>
                            </li>
                            {% block breadcrumb %}{% endblock %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="content">
            <div class="container-fluid">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        <i class="icon fas fa-check mr-2"></i> {{ message }}
                    </div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        <i class="icon fas fa-ban mr-2"></i> {{ message }}
                    </div>
                {% endfor %}

                {% block body %}{% endblock %}

            </div>
        </div>
    </div>

    <!-- ── Footer ── -->
    <footer class="main-footer">
        <strong>SmartFight Admin</strong> — ESPRIT Tunisia 2025/2026
        <div class="float-right d-none d-sm-inline-block">
            <b>Version</b> 1.0 | Module Nassir
        </div>
    </footer>

</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap 4 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- AdminLTE JS -->
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
