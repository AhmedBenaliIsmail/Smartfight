{% extends 'admin/base_admin.html.twig' %}
{% block title %}Process Reclamation #{{ reclamation.id }} — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-reply mr-2" style="color:#e50914;"></i>Process Reclamation #{{ reclamation.id }}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_reclamation_index') }}">Reclamations</a></li>
    <li class="breadcrumb-item active">#{{ reclamation.id }}</li>
{% endblock %}

{% block body %}
<div class="row">

    <!-- Original Reclamation -->
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h3 class="card-title"><i class="fas fa-envelope mr-2"></i>Original Reclamation</h3>
            </div>
            <div class="card-body">
                <dl>
                    <dt class="text-muted small">FROM</dt>
                    <dd>
                        {% if reclamation.user %}
                            <strong>{{ reclamation.user }}</strong>
                            <div class="small text-muted">{{ reclamation.user.email }}</div>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </dd>

                    <dt class="text-muted small">SUBJECT</dt>
                    <dd><strong>{{ reclamation.subject }}</strong></dd>

                    <dt class="text-muted small">DESCRIPTION</dt>
                    <dd>
                        <div class="p-3 rounded" style="background:#f8f9fa;border-left:3px solid #6c757d;">
                            {{ reclamation.description }}
                        </div>
                    </dd>

                    <dt class="text-muted small">SUBMISSION DATE</dt>
                    <dd>{{ reclamation.createdAt ? reclamation.createdAt|date('d/m/Y H:i') : '—' }}</dd>

                    <dt class="text-muted small">CURRENT STATUS</dt>
                    <dd>
                        {% if reclamation.status == 'PENDING' %}
                            <span class="badge badge-warning p-2">Pending</span>
                        {% elseif reclamation.status == 'IN_REVIEW' %}
                            <span class="badge badge-info p-2">In Review</span>
                        {% elseif reclamation.status == 'RESOLVED' %}
                            <span class="badge badge-success p-2">Resolved</span>
                        {% else %}
                            <span class="badge badge-danger p-2">Rejected</span>
                        {% endif %}
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Admin Response Form -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="background:#e50914;color:#fff;">
                <h3 class="card-title"><i class="fas fa-reply mr-2"></i>Your Response</h3>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="form-group">
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status) }}
                    {% if form_errors(form.status) is not empty %}
                        <div class="text-danger small mt-1">{{ form_errors(form.status) }}</div>
                    {% endif %}
                </div>

                <div class="form-group">
                    {{ form_label(form.adminResponse) }}
                    {{ form_widget(form.adminResponse) }}
                    {% if form_errors(form.adminResponse) is not empty %}
                        <div class="text-danger small mt-1">{{ form_errors(form.adminResponse) }}</div>
                    {% endif %}
                    <small class="text-muted">This response will be visible to the user.</small>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-danger btn-block">
                        <i class="fas fa-save mr-1"></i>Save Response
                    </button>
                    <a href="{{ path('app_admin_reclamation_index') }}" class="btn btn-secondary btn-block mt-2">
                        <i class="fas fa-arrow-left mr-1"></i>Back to list
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

</div>
{% endblock %}
