{% extends 'admin/base_admin.html.twig' %}
{% block title %}Edit: {{ discipline.name }} — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-edit mr-2" style="color:#e50914;"></i>Edit: {{ discipline.name }}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_discipline_index') }}">Disciplines</a></li>
    <li class="breadcrumb-item active">Edit</li>
{% endblock %}
{% block body %}
<div class="row"><div class="col-lg-8">
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h3 class="card-title"><i class="fas fa-edit mr-2"></i>Edit Discipline</h3>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {% for field in form %}
                {% if field.vars.name != '_token' %}
                    <div class="form-group">
                        {{ form_label(field) }}
                        {{ form_widget(field) }}
                        {% if form_errors(field) is not empty %}
                            <div class="text-danger small mt-1">{{ form_errors(field) }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            <div class="form-group">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save</button>
                <a href="{{ path('app_admin_discipline_index') }}" class="btn btn-secondary ml-2">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div></div>
{% endblock %}
