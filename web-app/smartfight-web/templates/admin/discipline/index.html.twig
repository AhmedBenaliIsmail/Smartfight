{% extends 'admin/base_admin.html.twig' %}
{% block title %}Disciplines Management — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-running mr-2" style="color:#e50914;"></i>Disciplines Management{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Disciplines</li>{% endblock %}
{% block body %}
<div class="row mb-3">
    <div class="col-12 text-right">
        <a href="{{ path('app_admin_discipline_new') }}" class="btn btn-success">
            <i class="fas fa-plus mr-1"></i>Add a discipline
        </a>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-table mr-2"></i>Disciplines List</h3>
        <span class="badge badge-primary ml-2">{{ disciplines|length }}</span>
    </div>
    <div class="card-body p-0">
        {% if disciplines is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-dumbbell fa-4x mb-3"></i>
                <p>No disciplines registered.</p>
                <a href="{{ path('app_admin_discipline_new') }}" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i>Create the first discipline
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Events</th>
                            <th width="160">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for discipline in disciplines %}
                            <tr>
                                <td>{{ discipline.id }}</td>
                                <td><strong>{{ discipline.name }}</strong></td>
                                <td>{{ discipline.description ? discipline.description|slice(0,80) ~ '...' : '—' }}</td>
                                <td><span class="badge badge-info">{{ discipline.events|length }}</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_admin_discipline_show', {'id': discipline.id}) }}" class="btn btn-info"><i class="fas fa-eye"></i></a>
                                        <a href="{{ path('app_admin_discipline_edit', {'id': discipline.id}) }}" class="btn btn-warning"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteModal{{ discipline.id }}"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% for discipline in disciplines %}
<div class="modal fade" id="deleteModal{{ discipline.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Discipline</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">Delete <strong>"{{ discipline.name }}"</strong>?</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('app_admin_discipline_delete', {'id': discipline.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ discipline.id) }}">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i>Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
