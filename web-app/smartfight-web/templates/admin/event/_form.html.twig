{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
<div class="row">
    {% for field in form %}
        {% if field.vars.name != '_token' %}
            <div class="col-md-{% if field.vars.name in ['description', 'venue', 'discipline'] %}12{% else %}6{% endif %} mb-3">
                <div class="form-group">
                    {{ form_label(field) }}
                    {{ form_widget(field) }}
                    {% if form_errors(field) is not empty %}
                        <div class="text-danger small mt-1">
                            <i class="fas fa-exclamation-circle mr-1"></i>{{ form_errors(field) }}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>
<div class="form-group mt-3">
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save mr-1"></i>{{ submitLabel }}
    </button>
    <a href="{{ cancelUrl }}" class="btn btn-secondary ml-2">
        <i class="fas fa-times mr-1"></i>Cancel
    </a>
</div>
{{ form_end(form) }}
