{% extends 'admin/base_admin.html.twig' %}

{% block title %}Events Management — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-calendar-alt mr-2" style="color:#e50914;"></i>Events Management{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Events</li>{% endblock %}

{% block body %}

<!-- Controls Row -->
<div class="row mb-3">
    <div class="col-md-6">
        <form method="GET" action="{{ path('app_admin_event_index') }}" class="input-group">
            <input type="text" name="q" class="form-control" placeholder="Search by name..."
                   value="{{ q ?? '' }}">
            <div class="input-group-append">
                <button class="btn btn-danger" type="submit">
                    <i class="fas fa-search"></i>
                </button>
                {% if q %}
                    <a href="{{ path('app_admin_event_index') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
    <div class="col-md-6 text-right">
        <a href="{{ path('app_admin_event_new') }}" class="btn btn-success">
            <i class="fas fa-plus mr-1"></i>Add an event
        </a>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="fas fa-table mr-2"></i>Events List</h3>
        <span class="badge badge-primary">{{ events|length }} result(s)</span>
    </div>
    <div class="card-body p-0">
        {% if events is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-calendar-times fa-4x mb-3"></i>
                <p>No event found{% if q %} for "{{ q }}"{% endif %}.</p>
                <a href="{{ path('app_admin_event_new') }}" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i>Create the first event
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th width="50">#</th>
                            <th>Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Venue</th>
                            <th>Discipline</th>
                            <th width="80">Capacity</th>
                            <th width="160">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td><strong>{{ event.id }}</strong></td>
                                <td>
                                    <a href="{{ path('app_admin_event_show', {'id': event.id}) }}"
                                       class="font-weight-bold text-dark">
                                        {{ event.name }}
                                    </a>
                                    {% if event.visibility == 'PRIVATE' %}
                                        <span class="badge badge-secondary ml-1">Private</span>
                                    {% endif %}
                                </td>
                                <td>{{ event.startDate|date('d/m/Y') }}</td>
                                <td>{{ event.endDate|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge badge-{{ event.status|lower }}">
                                        {% if event.status == 'SCHEDULED' %}Scheduled
                                        {% elseif event.status == 'ONGOING' %}Ongoing
                                        {% elseif event.status == 'COMPLETED' %}Completed
                                        {% else %}Cancelled{% endif %}
                                    </span>
                                </td>
                                <td>{{ event.venue ? event.venue.name : '—' }}</td>
                                <td>{{ event.discipline ? event.discipline.name : '—' }}</td>
                                <td class="text-center">{{ event.capacity }}</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_admin_event_show', {'id': event.id}) }}"
                                           class="btn btn-info" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_admin_event_edit', {'id': event.id}) }}"
                                           class="btn btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-danger"
                                                title="Delete"
                                                data-toggle="modal"
                                                data-target="#deleteModal{{ event.id }}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

<!-- Delete Modals -->
{% for event in events %}
    <div class="modal fade" id="deleteModal{{ event.id }}" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirm Deletion
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this event:</p>
                    <p class="font-weight-bold text-danger">"{{ event.name }}"</p>
                    <p class="text-muted small">This action is irreversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <form method="POST"
                          action="{{ path('app_admin_event_delete', {'id': event.id}) }}"
                          style="display:inline;">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete' ~ event.id) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash mr-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endfor %}

{% endblock %}
