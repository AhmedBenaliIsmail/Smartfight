{% extends 'admin/base_admin.html.twig' %}

{% block title %}Add an Event — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-plus-circle mr-2" style="color:#e50914;"></i>Add an Event{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_event_index') }}">Events</a></li>
    <li class="breadcrumb-item active">Add</li>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-10 col-xl-8">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h3 class="card-title"><i class="fas fa-calendar-plus mr-2"></i>New Event</h3>
            </div>
            <div class="card-body">
                {% include 'admin/event/_form.html.twig' with {
                    'submitLabel': "Create Event",
                    'cancelUrl': path('app_admin_event_index')
                } %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
