{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ event.name }} — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-calendar mr-2" style="color:#e50914;"></i>{{ event.name }}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_event_index') }}">Events</a></li>
    <li class="breadcrumb-item active">{{ event.name }}</li>
{% endblock %}

{% block body %}

<!-- Action Buttons -->
<div class="mb-3">
    <a href="{{ path('app_admin_event_edit', {'id': event.id}) }}" class="btn btn-warning mr-2">
        <i class="fas fa-edit mr-1"></i>Edit
    </a>
    <a href="{{ path('app_front_event_show', {'id': event.id}) }}" class="btn btn-info mr-2" target="_blank">
        <i class="fas fa-eye mr-1"></i>Public View
    </a>
    <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteModal">
        <i class="fas fa-trash mr-1"></i>Delete
    </button>
    <a href="{{ path('app_admin_event_index') }}" class="btn btn-secondary ml-2">
        <i class="fas fa-arrow-left mr-1"></i>Back
    </a>
</div>

<div class="row">

    <!-- Main Info -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>General Information</h3>
                <div class="card-tools">
                    <span class="badge badge-{{ event.status|lower }} px-3 py-2">
                        {% if event.status == 'SCHEDULED' %}Scheduled
                        {% elseif event.status == 'ONGOING' %}Ongoing
                        {% elseif event.status == 'COMPLETED' %}Completed
                        {% else %}Cancelled{% endif %}
                    </span>
                </div>
            </div>
            <div class="card-body">
                {% if event.description %}
                    <p class="text-muted">{{ event.description }}</p>
                    <hr>
                {% endif %}
                <div class="row">
                    <div class="col-sm-6">
                        <dl>
                            <dt class="text-muted small">START DATE</dt>
                            <dd class="font-weight-bold">{{ event.startDate|date('d/m/Y') }}</dd>
                            <dt class="text-muted small">END DATE</dt>
                            <dd class="font-weight-bold">{{ event.endDate|date('d/m/Y') }}</dd>
                            <dt class="text-muted small">VISIBILITY</dt>
                            <dd>
                                {% if event.visibility == 'PUBLIC' %}
                                    <span class="badge badge-info">Public</span>
                                {% else %}
                                    <span class="badge badge-secondary">Private</span>
                                {% endif %}
                            </dd>
                        </dl>
                    </div>
                    <div class="col-sm-6">
                        <dl>
                            <dt class="text-muted small">DISCIPLINE</dt>
                            <dd class="font-weight-bold">{{ event.discipline ? event.discipline.name : '—' }}</dd>
                            <dt class="text-muted small">CREATED AT</dt>
                            <dd>{{ event.createdAt ? event.createdAt|date('d/m/Y H:i') : '—' }}</dd>
                            <dt class="text-muted small">UPDATED AT</dt>
                            <dd>{{ event.updatedAt ? event.updatedAt|date('d/m/Y H:i') : '—' }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Venue -->
        {% if event.venue %}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-map-marker-alt mr-2"></i>Venue</h3>
                </div>
                <div class="card-body">
                    <h5>{{ event.venue.name }}</h5>
                    {% if event.venue.address %}<p class="mb-1"><i class="fas fa-road mr-1 text-muted"></i>{{ event.venue.address }}</p>{% endif %}
                    {% if event.venue.city %}<p class="mb-1"><i class="fas fa-map-pin mr-1 text-muted"></i>{{ event.venue.city }}{% if event.venue.country %}, {{ event.venue.country }}{% endif %}</p>{% endif %}
                    <a href="{{ path('app_admin_venue_show', {'id': event.venue.id}) }}" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="fas fa-external-link-alt mr-1"></i>View Venue
                    </a>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Sidebar Stats -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="info-box mb-3" style="background:#e8f5e9;">
                    <span class="info-box-icon" style="background:#27ae60;"><i class="fas fa-users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Registered Fighters</span>
                        <span class="info-box-number">{{ registeredCount }} / {{ event.capacity }}</span>
                    </div>
                </div>

                {% set pct = event.capacity > 0 ? ((registeredCount / event.capacity) * 100)|round : 0 %}
                <div class="progress-group">
                    <span class="progress-text">Fill Rate</span>
                    <span class="float-right"><b>{{ pct }}%</b></span>
                    <div class="progress progress-sm">
                        <div class="progress-bar bg-{{ pct >= 80 ? 'danger' : (pct >= 50 ? 'warning' : 'success') }}"
                             style="width: {{ pct > 100 ? 100 : pct }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i>Confirm Deletion</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p>Permanently delete <strong>"{{ event.name }}"</strong>?</p>
                <p class="text-muted small">This action is irreversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('app_admin_event_delete', {'id': event.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i>Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}
