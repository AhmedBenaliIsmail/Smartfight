{% extends 'admin/base_admin.html.twig' %}

{% block title %}Venues Management — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-map-marker-alt mr-2" style="color:#e50914;"></i>Venues Management{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Venues</li>{% endblock %}

{% block body %}
<div class="row mb-3">
    <div class="col-12 text-right">
        <a href="{{ path('app_admin_venue_new') }}" class="btn btn-success">
            <i class="fas fa-plus mr-1"></i>Add a venue
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-table mr-2"></i>Venues List</h3>
        <span class="badge badge-primary ml-2">{{ venues|length }}</span>
    </div>
    <div class="card-body p-0">
        {% if venues is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-map-marked-alt fa-4x mb-3"></i>
                <p>No venues registered.</p>
                <a href="{{ path('app_admin_venue_new') }}" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i>Create the first venue
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Capacity</th>
                            <th>Address</th>
                            <th>Events</th>
                            <th width="160">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for venue in venues %}
                            <tr>
                                <td>{{ venue.id }}</td>
                                <td><strong>{{ venue.name }}</strong></td>
                                <td>{{ venue.city ?? '—' }}</td>
                                <td>{{ venue.country ?? '—' }}</td>
                                <td>{{ venue.capacity ?? '—' }}</td>
                                <td>{{ venue.address ?? '—' }}</td>
                                <td>
                                    <span class="badge badge-info">{{ venue.events|length }}</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_admin_venue_show', {'id': venue.id}) }}" class="btn btn-info" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="{{ path('app_admin_venue_edit', {'id': venue.id}) }}" class="btn btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteModal{{ venue.id }}" title="Delete"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{% for venue in venues %}
<div class="modal fade" id="deleteModal{{ venue.id }}" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i>Delete Venue</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                Delete <strong>"{{ venue.name }}"</strong>? This action is irreversible.
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('app_admin_venue_delete', {'id': venue.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ venue.id) }}">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i>Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
