{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ venue.name }} — SmartFight Admin{% endblock %}
{% block page_title %}<i class="fas fa-map-marker-alt mr-2" style="color:#e50914;"></i>{{ venue.name }}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_venue_index') }}">Venues</a></li>
    <li class="breadcrumb-item active">{{ venue.name }}</li>
{% endblock %}
{% block body %}
<div class="mb-3">
    <a href="{{ path('app_admin_venue_edit', {'id': venue.id}) }}" class="btn btn-warning mr-2">
        <i class="fas fa-edit mr-1"></i>Edit
    </a>
    <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteModal">
        <i class="fas fa-trash mr-1"></i>Delete
    </button>
    <a href="{{ path('app_admin_venue_index') }}" class="btn btn-secondary ml-2">
        <i class="fas fa-arrow-left mr-1"></i>Back
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Venue Details</h3></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-muted">Name</dt><dd class="col-sm-8"><strong>{{ venue.name }}</strong></dd>
                    <dt class="col-sm-4 text-muted">City</dt><dd class="col-sm-8">{{ venue.city ?? '—' }}</dd>
                    <dt class="col-sm-4 text-muted">Country</dt><dd class="col-sm-8">{{ venue.country ?? '—' }}</dd>
                    <dt class="col-sm-4 text-muted">Address</dt><dd class="col-sm-8">{{ venue.address ?? '—' }}</dd>
                    <dt class="col-sm-4 text-muted">Capacity</dt><dd class="col-sm-8">{{ venue.capacity ?? '—' }}</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-calendar-alt mr-2"></i>Linked Events</h3></div>
            <div class="card-body">
                {% if venue.events is empty %}
                    <p class="text-muted">No events linked to this venue.</p>
                {% else %}
                    <ul class="list-unstyled">
                        {% for event in venue.events %}
                            <li class="mb-2">
                                <a href="{{ path('app_admin_event_show', {'id': event.id}) }}">
                                    <i class="fas fa-calendar mr-1 text-danger"></i>{{ event.name }}
                                </a>
                                <span class="badge badge-{{ event.status|lower }} ml-1">{{ event.status }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Venue</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">Delete <strong>"{{ venue.name }}"</strong>?</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('app_admin_venue_delete', {'id': venue.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ venue.id) }}">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i>Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
