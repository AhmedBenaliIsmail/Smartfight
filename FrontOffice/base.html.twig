<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SmartFight{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/smartfight.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

{# ===== NAVBAR ===== #}
<nav class="sf-navbar navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="{{ path('front_home') }}">SMART<span>FIGHT</span></a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sfNavCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="sfNavCollapse">
            <ul class="navbar-nav mx-auto gap-1">
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'front_home' ? 'active' : '' }}" href="{{ path('front_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'front_fighters' ? 'active' : '' }}" href="{{ path('front_fighters') }}">Fighters</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Events</a></li>
                <li class="nav-item"><a class="nav-link" href="#">News</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Gallery</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Predictions</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Bookings</a></li>
            </ul>
            <div class="nav-actions d-flex align-items-center gap-2 mt-2 mt-lg-0">
                <a href="#" class="btn btn-sf-ghost">Login</a>
                <a href="#" class="btn btn-sf-primary">Register</a>
            </div>
        </div>
    </div>
</nav>

{# ===== CONTENT ===== #}
{% block body %}{% endblock %}

{# ===== FOOTER ===== #}
<footer class="sf-footer">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4 col-md-6">
                <a href="{{ path('front_home') }}" class="footer-logo">SMART<span>FIGHT</span></a>
                <p class="footer-about">The premier destination for UFC and MMA fans.</p>
                <div class="social-links">
                    <a href="#" class="social-link"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="#" class="social-link"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="social-link"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <div class="footer-col-title">Quick Links</div>
                <ul class="footer-links">
                    <li><a href="{{ path('front_home') }}">Home</a></li>
                    <li><a href="{{ path('front_fighters') }}">Fighters</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 SmartFight. All rights reserved.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>