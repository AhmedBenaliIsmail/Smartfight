<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RankingListController"
            prefWidth="800" prefHeight="560">
    <top>
        <Label text="Fighter Rankings" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 15 0 10 15;" />
    </top>
    <center>
        <TableView fx:id="tableRankings" style="-fx-padding: 0 15 0 15;">
            <columns>
                <TableColumn fx:id="colId"           text="ID"          prefWidth="50"  />
                <TableColumn fx:id="colFighterId"    text="Fighter ID"  prefWidth="90"  />
                <TableColumn fx:id="colDisciplineId" text="Discipline"  prefWidth="90"  />
                <TableColumn fx:id="colRankPosition" text="Position"    prefWidth="90"  />
                <TableColumn fx:id="colPoints"       text="Points"      prefWidth="90"  />
                <TableColumn fx:id="colSeason"       text="Season"      prefWidth="120" />
            </columns>
            <placeholder><Label text="No rankings found." /></placeholder>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 12px;">
            <Button text="➕ Add"    prefWidth="130" onAction="#navigateToAdd"   style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
            <Button text="✏️ Edit"   prefWidth="130" onAction="#navigateToEdit"  style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
            <Button text="🗑️ Delete" prefWidth="130" onAction="#deleteRanking"   style="-fx-background-color: #F44336; -fx-text-fill: white;" />
            <Button text="🏠 Menu"   prefWidth="130" onAction="#navigateToMenu"  style="-fx-background-color: #607D8B; -fx-text-fill: white;" />
        </HBox>
    </bottom>
</BorderPane>
