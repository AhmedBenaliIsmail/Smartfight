<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.EventListController"
            prefWidth="900" prefHeight="600">
    <top>
        <Label text="Event Management"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 15 0 10 15;" />
    </top>
    <center>
        <TableView fx:id="tableEvents" style="-fx-padding: 0 15 0 15;">
            <columns>
                <TableColumn fx:id="colId"         text="ID"         prefWidth="50"  />
                <TableColumn fx:id="colName"        text="Name"       prefWidth="200" />
                <TableColumn fx:id="colStartDate"   text="Start Date" prefWidth="110" />
                <TableColumn fx:id="colEndDate"     text="End Date"   prefWidth="110" />
                <TableColumn fx:id="colStatus"      text="Status"     prefWidth="110" />
                <TableColumn fx:id="colVisibility"  text="Visibility" prefWidth="90"  />
                <TableColumn fx:id="colCapacity"    text="Capacity"   prefWidth="80"  />
            </columns>
            <placeholder><Label text="No events found." /></placeholder>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 12px;">
            <Button text="➕ Add Event"    prefWidth="140" onAction="#navigateToAdd"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
            <Button text="✏️ Edit Event"   prefWidth="140" onAction="#navigateToEdit"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
            <Button text="🗑️ Delete Event" prefWidth="140" onAction="#deleteEvent"
                    style="-fx-background-color: #F44336; -fx-text-fill: white;" />
            <Button text="🏠 Menu"         prefWidth="140" onAction="#navigateToMenu"
                    style="-fx-background-color: #607D8B; -fx-text-fill: white;" />
        </HBox>
    </bottom>
</BorderPane>
