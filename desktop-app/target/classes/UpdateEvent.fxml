<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UpdateEventController"
            prefWidth="700" prefHeight="560">

    <top>
        <Label text="Update Event"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 0 10 20;" />
    </top>

    <center>
        <GridPane hgap="12" vgap="14"
                  style="-fx-padding: 10 30 10 30;">

            <!-- Row 0: Name -->
            <Label text="Event Name: *" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtName" promptText="Enter event name"
                       prefWidth="340"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <!-- Row 1: Description -->
            <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <TextArea fx:id="txtDescription" promptText="Enter description"
                      prefWidth="340" prefHeight="70" wrapText="true"
                      GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <!-- Row 2: Start Date -->
            <Label text="Start Date: *" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <DatePicker fx:id="dpStartDate" prefWidth="340"
                        GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <!-- Row 3: End Date -->
            <Label text="End Date: *" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <DatePicker fx:id="dpEndDate" prefWidth="340"
                        GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <!-- Row 4: Status -->
            <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <ChoiceBox fx:id="cbStatus" prefWidth="340"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <!-- Row 5: Visibility -->
            <Label text="Visibility:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <ChoiceBox fx:id="cbVisibility" prefWidth="340"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" />

            <!-- Row 6: Capacity -->
            <Label text="Capacity: *" GridPane.rowIndex="6" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtCapacity" promptText="Enter max capacity"
                       prefWidth="340"
                       GridPane.rowIndex="6" GridPane.columnIndex="1" />

            <!-- Row 7: Venue -->
            <Label text="Venue:" GridPane.rowIndex="7" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <ComboBox fx:id="cbVenue" prefWidth="340"
                      GridPane.rowIndex="7" GridPane.columnIndex="1" />

            <!-- Row 8: Discipline -->
            <Label text="Discipline:" GridPane.rowIndex="8" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;" />
            <ComboBox fx:id="cbDiscipline" prefWidth="340"
                      GridPane.rowIndex="8" GridPane.columnIndex="1" />

        </GridPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER"
              style="-fx-padding: 14px;">
            <Button text="✏️ Update"  prefWidth="130" onAction="#updateEvent"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="✖ Cancel"  prefWidth="130" onAction="#navigateToList"
                    style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
