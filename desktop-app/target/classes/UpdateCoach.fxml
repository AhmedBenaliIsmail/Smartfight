<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UpdateCoachController"
            prefWidth="620" prefHeight="420">
    <top>
        <Label text="Update Coach" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 0 10 20;" />
    </top>
    <center>
        <GridPane hgap="12" vgap="14" style="-fx-padding: 10 30 10 30;">
            <Label text="User:"            GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="cbUserId"        prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <Label text="Speciality: *"    GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtSpeciality"   prefWidth="300" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <Label text="Exp. Years: *"    GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtExperienceYears" prefWidth="300" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            <Label text="Certification:"   GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtCertification"   prefWidth="300" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            <Label text="Status:"          GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <ChoiceBox fx:id="cbStatus"       prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1" />
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 14px;">
            <Button text="✏️ Update" prefWidth="130" onAction="#updateCoach"      style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button text="✖ Cancel"  prefWidth="130" onAction="#navigateToList"  style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </bottom>
</BorderPane>
