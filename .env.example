# SmartFight Environment Configuration Template
APP_ENV=dev
APP_SECRET=ENTER_A_RANDOM_32_CHAR_SECRET

# Application URI
DEFAULT_URI="http://localhost:8001/"

# Database Connection (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/mma_system?serverVersion=8.0.32&charset=utf8mb4"

# Google OAuth (For Social Login)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8001/connect/google/check"

# Mailer Configuration (Recommended: Gmail Port 587 with TLS)
# MAILER_DSN="smtp://USERNAME:PASSWORD@smtp.gmail.com:587?encryption=tls&auth_mode=login"
MAILER_DSN=null://localhost

# Biometric Note: FaceID models are loaded via CDN (jsdelivr). 
# Ensure the server has internet access or download weights to public/weights/

# AI Matchmaking API (DeepSeek/OpenAI)
DEEPSEEK_API_KEY=YOUR_API_KEY
