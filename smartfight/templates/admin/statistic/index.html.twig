{% extends 'admin/base_admin.html.twig' %}

{% block title %}Statistics - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Fight Statistics</h1>
    <a href="{{ path('admin_statistic_new') }}" class="btn btn-danger">
        <i class="fa-solid fa-plus me-2"></i>New Statistic
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Fight Result ID</label>
                <input type="number" min="1" name="fightResultId" value="{{ fightResultId ?: '' }}" class="form-control" placeholder="Filter by fight result id">
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary" type="submit">Apply</button>
                <a href="{{ path('admin_statistic_index') }}" class="btn btn-outline-secondary ms-2">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Fight ID</th>
                <th>Fighter</th>
                <th>Fighter ID</th>
                <th>Strikes</th>
                <th>Takedowns</th>
                <th>Sub Attempts</th>
                <th>Control (s)</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for stat in statistics %}
                <tr>
                    <td>{{ stat.id }}</td>
                    <td>{{ stat.fightResultId }}</td>
                    <td>{{ fightersById[stat.fighterId] is defined ? fightersById[stat.fighterId].displayName : 'Unknown' }}</td>
                    <td>{{ stat.fighterId }}</td>
                    <td>{{ stat.strikesLanded }}/{{ stat.strikesAttempted }}</td>
                    <td>{{ stat.takedownsLanded }}/{{ stat.takedownsAttempted }}</td>
                    <td>{{ stat.submissionAttempts }}</td>
                    <td>{{ stat.controlTimeSeconds }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-info" href="{{ path('admin_statistic_show', {id: stat.id}) }}">View</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_statistic_edit', {id: stat.id}) }}">Edit</a>
                        <a class="btn btn-sm btn-outline-warning" href="{{ path('admin_statistic_wizard', {fightResult: stat.fightResultId}) }}">Wizard</a>
                        <form method="post" action="{{ path('admin_statistic_delete', {id: stat.id}) }}" class="d-inline" onsubmit="return confirm('Delete this statistic?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_statistic_' ~ stat.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9" class="text-muted">No statistics found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
