{% extends 'admin/base_admin.html.twig' %}

{% block title %}Event Details - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Event #{{ event.id }}</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="{{ path('admin_event_edit', {id: event.id}) }}">Edit</a>
        <a class="btn btn-outline-secondary" href="{{ path('admin_event_index') }}">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">{{ event.name }}</dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9">{{ event.description ?: 'N/A' }}</dd>
            <dt class="col-sm-3">Date Window</dt><dd class="col-sm-9">{{ event.startDate|date('Y-m-d') }} to {{ event.endDate|date('Y-m-d') }}</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">{{ event.status }}</dd>
            <dt class="col-sm-3">Visibility</dt><dd class="col-sm-9">{{ event.visibility }}</dd>
            <dt class="col-sm-3">Location</dt><dd class="col-sm-9">{{ event.location ?: 'N/A' }}</dd>
            <dt class="col-sm-3">Capacity</dt><dd class="col-sm-9">{{ event.capacity }}</dd>
            <dt class="col-sm-3">Discipline</dt><dd class="col-sm-9">{{ event.discipline ? event.discipline.name : 'N/A' }}</dd>
            <dt class="col-sm-3">Champions Event</dt><dd class="col-sm-9">{{ event.isChampionsEvent ? 'Yes' : 'No' }}</dd>
        </dl>
    </div>
</div>
{% endblock %}
