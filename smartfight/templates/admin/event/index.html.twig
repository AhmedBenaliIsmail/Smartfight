{% extends 'admin/base_admin.html.twig' %}

{% block title %}Events - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Events</h1>
    <a href="{{ path('admin_event_new') }}" class="btn btn-danger">
        <i class="fa-solid fa-plus me-2"></i>New Event
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Starts at</th>
                <th>Venue</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.name }}</td>
                    <td>{{ event.startsAt ? event.startsAt|date('Y-m-d') : '—' }}</td>
                    <td>{{ event.venueName ?: '—' }}{% if event.city %}, {{ event.city }}{% endif %}</td>
                    <td>
                        {% set statusColors = {SCHEDULED:'primary',LIVE:'danger',COMPLETED:'success',CANCELLED:'secondary'} %}
                        <span class="badge bg-{{ statusColors[event.status]|default('secondary') }}">{{ event.statusLabel }}</span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-info" href="{{ path('admin_event_show', {id: event.id}) }}">View</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_event_edit', {id: event.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted">No events found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
