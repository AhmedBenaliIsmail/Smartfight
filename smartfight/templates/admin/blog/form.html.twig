{% extends 'admin/base_admin.html.twig' %}
{% set breadcrumb_title = is_edit ? 'Edit Article' : 'New Article' %}

{% block admin_content %}
<div class="page-header mb-4">
    <h2 class="page-title" style="font-family:'Oswald',sans-serif;color:#fff;">
        {{ is_edit ? 'Edit Article' : 'New Article' }}
    </h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-body">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.title, 'Title', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.title, {attr: {class: 'form-control', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.category, 'Category', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                        {{ form_widget(form.category, {attr: {class: 'form-select', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                        {{ form_errors(form.category) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.author, 'Author', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                        {{ form_widget(form.author, {attr: {class: 'form-select', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                        {{ form_errors(form.author) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.summary, 'Summary', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.summary, {attr: {class: 'form-control', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                    {{ form_errors(form.summary) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.content, 'Content', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.content, {attr: {class: 'form-control', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                    {{ form_errors(form.content) }}
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.status, 'Status', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                        {{ form_widget(form.status, {attr: {class: 'form-select', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color:#a1a1aa;">Cover Image</label>
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color:#a1a1aa;">Video</label>
                    {{ form_widget(form.videoFile) }}
                    {{ form_errors(form.videoFile) }}
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn" style="background:#dc2626;color:#fff;font-family:'Oswald',sans-serif;">
                        <i class="fa-solid fa-save me-2"></i>{{ is_edit ? 'Update Article' : 'Create Article' }}
                    </button>
                    <a href="{{ path('admin_blog_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
