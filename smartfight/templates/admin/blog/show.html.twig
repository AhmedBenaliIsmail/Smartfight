{% extends 'admin/base_admin.html.twig' %}
{% set breadcrumb_title = 'View Article' %}

{% block admin_content %}
<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <h2 class="page-title mb-0" style="font-family:'Oswald',sans-serif;color:#fff;">{{ article.title }}</h2>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_blog_edit', {id: article.id}) }}" class="btn btn-outline-secondary">
            <i class="fa-solid fa-pen me-2"></i>Edit
        </a>
        <a href="{{ path('admin_blog_index') }}" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
            {% if article.imagePath %}
                <img src="{{ vich_uploader_asset(article, 'imageFile') }}" alt="{{ article.title }}" style="width:100%;height:300px;object-fit:cover;border-radius:8px 8px 0 0;">
            {% endif %}
            <div class="card-body">
                {% if article.summary %}
                    <p style="color:#a1a1aa;font-style:italic;border-left:3px solid #dc2626;padding-left:1rem;">{{ article.summary }}</p>
                {% endif %}
                <div style="color:#d4d4d8;line-height:1.8;">{{ article.content|nl2br }}</div>

                {% if article.videoPath %}
                    <div class="mt-4">
                        <h6 style="color:#a1a1aa;font-family:'Oswald',sans-serif;letter-spacing:1px;">VIDEO</h6>
                        <video controls style="width:100%;border-radius:8px;max-height:360px;">
                            <source src="{{ vich_uploader_asset(article, 'videoFile') }}" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-header" style="border-bottom:1px solid #27272a;">
                <h6 class="mb-0" style="color:#fff;">Article Details</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5" style="color:#71717a;">Status</dt>
                    <dd class="col-7">
                        {% if article.status == 'PUBLISHED' %}
                            <span class="badge" style="background:#16a34a;">Published</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ article.status|capitalize }}</span>
                        {% endif %}
                    </dd>
                    <dt class="col-5" style="color:#71717a;">Category</dt>
                    <dd class="col-7" style="color:#d4d4d8;">{{ article.category.name }}</dd>
                    <dt class="col-5" style="color:#71717a;">Author</dt>
                    <dd class="col-7" style="color:#d4d4d8;">{{ article.author.fullName }}</dd>
                    <dt class="col-5" style="color:#71717a;">Views</dt>
                    <dd class="col-7" style="color:#d4d4d8;">{{ article.viewCount }}</dd>
                    <dt class="col-5" style="color:#71717a;">Created</dt>
                    <dd class="col-7" style="color:#d4d4d8;">{{ article.createdAt|date('d M Y') }}</dd>
                    <dt class="col-5" style="color:#71717a;">Updated</dt>
                    <dd class="col-7" style="color:#d4d4d8;">{{ article.updatedAt|date('d M Y') }}</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}
