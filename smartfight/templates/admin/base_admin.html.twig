{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('backoffice/css/smartfight-admin.css') }}">
    {% block extra_css %}{% endblock %}
{% endblock %}

{% block body %}
<style>
    :root {
        --sf-admin-navbar-h: 72px;
    }
    .admin-topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2000;
        height: var(--sf-admin-navbar-h);
        display: flex;
        align-items: center;
        background: #111114 !important;
        border-bottom: 1px solid #27272a !important;
        box-shadow: 0 6px 20px rgba(0,0,0,0.45);
        padding-left: 260px;
    }
    .admin-page {
        margin-left: 260px;
        min-height: 100vh;
        background: #09090b;
        padding-top: var(--sf-admin-navbar-h);
    }
    @media (max-width: 991.98px) {
        .admin-topbar {
            padding-left: 0;
        }
        .admin-page {
            margin-left: 0;
        }
    }
</style>
<div class="wrapper" data-bs-theme="dark">
    {% include 'admin/partials/sidebar.html.twig' %}

        <div class="admin-page">
        {% include 'front/partials/navbar.html.twig' %}

        <div class="container-xl py-4">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-3">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>
    {% block extra_js %}{% endblock %}
{% endblock %}
