{% extends 'admin/base_admin.html.twig' %}
{% set breadcrumb_title = 'Broadcast Notification' %}

{% block admin_content %}
<div class="page-header mb-4">
    <h2 class="page-title" style="font-family:'Oswald',sans-serif;color:#fff;">Broadcast Notification</h2>
    <p class="text-muted">Send a notification to a group of fans.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-body">
                {{ form_start(form) }}

                <div class="mb-4">
                    <label class="form-label" style="color:#a1a1aa;">Audience</label>
                    <div class="d-flex flex-wrap gap-3">
                        {{ form_widget(form.audience) }}
                    </div>
                    {{ form_errors(form.audience) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.type, 'Notification Type', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.type, {attr: {class: 'form-select', style: 'background:#09090b;border-color:#27272a;color:#fff;'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.title, 'Title', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.title, {attr: {class: 'form-control', style: 'background:#09090b;border-color:#27272a;color:#fff;', id: 'notifTitle'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.message, 'Message', {label_attr: {class: 'form-label', style: 'color:#a1a1aa;'}}) }}
                    {{ form_widget(form.message, {attr: {class: 'form-control', style: 'background:#09090b;border-color:#27272a;color:#fff;', id: 'notifMessage'}}) }}
                    {{ form_errors(form.message) }}
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn" style="background:#dc2626;color:#fff;font-family:'Oswald',sans-serif;">
                        <i class="fa-solid fa-bullhorn me-2"></i>Send Broadcast
                    </button>
                    <a href="{{ path('admin_notification_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card" style="background:#18181b;border:1px solid #27272a;position:sticky;top:80px;">
            <div class="card-header" style="border-bottom:1px solid #27272a;">
                <h6 class="mb-0" style="color:#fff;">Live Preview</h6>
            </div>
            <div class="card-body">
                <div style="background:#09090b;border:1px solid #27272a;border-radius:10px;padding:1rem;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width:8px;height:8px;border-radius:50%;background:#dc2626;"></div>
                        <span style="font-size:.7rem;color:#71717a;text-transform:uppercase;letter-spacing:.1em;">SmartFight Notification</span>
                    </div>
                    <div id="previewTitle" style="font-weight:600;color:#fff;margin-bottom:.5rem;">Your notification title here</div>
                    <div id="previewMessage" style="font-size:.875rem;color:#a1a1aa;">Your message will appear here...</div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.getElementById('notifTitle').addEventListener('input', function() {
    document.getElementById('previewTitle').textContent = this.value || 'Your notification title here';
});
document.getElementById('notifMessage').addEventListener('input', function() {
    document.getElementById('previewMessage').textContent = this.value || 'Your message will appear here...';
});
</script>
{% endblock %}
