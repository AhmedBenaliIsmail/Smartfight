{% extends 'admin/base_admin.html.twig' %}

{% block title %}Performance Detail - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Performance Detail</h1>
    <a class="btn btn-outline-secondary" href="{{ path('admin_performance_index', { season: season }) }}">Back</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-2">{{ fighter.displayName }}</h3>
                <p class="text-muted mb-1">Nationality: {{ fighter.nationality ?? 'N/A' }}</p>
                <p class="text-muted mb-1">Record: {{ fighter.record }}</p>
                <p class="text-muted mb-0">ELO: {{ fighter.eloRating|number_format(2, '.', ',') }}</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                {% if score %}
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Season:</strong> {{ score.season }}</div>
                        <div class="col-md-4"><strong>Total Score:</strong> {{ score.score|number_format(2, '.', ',') }}</div>
                        <div class="col-md-4"><strong>Computed:</strong> {{ score.computedAt|date('Y-m-d H:i') }}</div>
                        <div class="col-md-3"><strong>Aggression:</strong> {{ score.aggression|number_format(2, '.', ',') }}</div>
                        <div class="col-md-3"><strong>Defense:</strong> {{ score.defense|number_format(2, '.', ',') }}</div>
                        <div class="col-md-3"><strong>Technique:</strong> {{ score.technique|number_format(2, '.', ',') }}</div>
                        <div class="col-md-3"><strong>Experience:</strong> {{ score.experience|number_format(2, '.', ',') }}</div>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">No score found for this fighter and season.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
