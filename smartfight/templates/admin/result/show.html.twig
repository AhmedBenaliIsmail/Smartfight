{% extends 'admin/base_admin.html.twig' %}

{% block title %}Fight Result Details - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Fight Result #{{ result.id }}</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="{{ path('admin_result_edit', {id: result.id}) }}">Edit</a>
        <a class="btn btn-outline-warning" href="{{ path('admin_statistic_wizard', {fightResult: result.id}) }}">Statistics Wizard</a>
        <a class="btn btn-outline-secondary" href="{{ path('admin_result_index') }}">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Event</dt><dd class="col-sm-9">{{ result.event.name }}</dd>
            <dt class="col-sm-3">Fight Label</dt><dd class="col-sm-9">{{ result.fightLabel }}</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">{{ result.fightDate|date('Y-m-d') }}</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">{{ result.status }}</dd>
            <dt class="col-sm-3">Winner</dt><dd class="col-sm-9">{{ result.winner ? result.winner.displayName : 'Draw / undecided' }}</dd>
            <dt class="col-sm-3">Method</dt><dd class="col-sm-9">{{ result.method }}</dd>
            <dt class="col-sm-3">Round Ended</dt><dd class="col-sm-9">{{ result.roundEnded ?: 'N/A' }}</dd>
            <dt class="col-sm-3">Time Ended</dt><dd class="col-sm-9">{{ result.timeEnded ? result.timeEnded|date('H:i:s') : 'N/A' }}</dd>
            <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">{{ result.notes ?: 'N/A' }}</dd>
        </dl>
    </div>
</div>
{% endblock %}
