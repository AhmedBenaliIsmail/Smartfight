{% extends 'admin/base_admin.html.twig' %}

{% block title %}Fight Results - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Fight Results</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_result_export_csv') }}" class="btn btn-outline-secondary">
            <i class="fa-solid fa-file-csv me-2"></i>Export CSV
        </a>
        <a href="{{ path('admin_result_new') }}" class="btn btn-danger">
            <i class="fa-solid fa-wand-magic-sparkles me-2"></i>New Result Wizard
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    {% set statuses = ['ALL', 'SCHEDULED', 'COMPLETED', 'CANCELLED'] %}
                    {% for s in statuses %}
                        <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ s|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary" type="submit">Apply</button>
                <a href="{{ path('admin_result_index') }}" class="btn btn-outline-secondary ms-2">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>Fight</th>
                <th>Event</th>
                <th>Date</th>
                <th>Status</th>
                <th>Method</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for result in results %}
                <tr>
                    <td>{{ result.fightLabel }}</td>
                    <td>{{ result.event.name }}</td>
                    <td>{{ result.fightDate|date('Y-m-d') }}</td>
                    <td>
                        {% set statusColors = {SCHEDULED:'primary',COMPLETED:'success',CANCELLED:'secondary',LIVE:'danger'} %}
                        <span class="badge bg-{{ statusColors[result.status]|default('secondary') }}">{{ result.status|title }}</span>
                    </td>
                    <td>{{ result.methodLabel }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-info" href="{{ path('admin_result_show', {id: result.id}) }}">View</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_result_edit', {id: result.id}) }}">Edit</a>
                        <a class="btn btn-sm btn-outline-warning" href="{{ path('admin_statistic_wizard', {fightResult: result.id}) }}">Stats Wizard</a>
                        <form method="post" action="{{ path('admin_result_delete', {id: result.id}) }}" class="d-inline" onsubmit="return confirm('Delete this result?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_result_' ~ result.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-muted">No results found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
