{% extends 'admin/base_admin.html.twig' %}

{% block title %}Fighters - Admin{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Fighters</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input class="form-control" type="text" name="search" value="{{ search }}" placeholder="Search by name, nickname, nationality">
            </div>
            <div class="col-md-4">
                <input class="form-control" type="text" name="weightClass" value="{{ weightClass }}" placeholder="Weight class">
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>Fighter</th>
                <th>Record</th>
                <th>ELO</th>
                <th>Performance</th>
            </tr>
            </thead>
            <tbody>
            {% for fighter in fighters %}
                <tr>
                    <td>{{ fighter.displayName }}</td>
                    <td>{{ fighter.record }}</td>
                    <td>{{ fighter.eloRating|number_format(1, '.', ',') }}</td>
                    <td>{{ fighter.performanceScore|number_format(1, '.', ',') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-muted">No fighters found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
