{% extends 'admin/base_admin.html.twig' %}
{% set breadcrumb_title = 'Combattants' %}

{% block title %}Combattants - SmartFight{% endblock %}

{% block admin_content %}
<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="page-title mb-1" style="font-family:'Oswald',sans-serif;color:#fff;">Combattants</h2>
        <p class="text-muted mb-0">{{ combattants|length }} combattants total</p>
    </div>
    <a href="{{ path('app_combattant_new') }}" class="btn" style="background:#dc2626;color:#fff;font-family:'Oswald',sans-serif;">
        <i class="fa-solid fa-plus me-2"></i>Nouveau Combattant
    </a>
</div>

<div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div style="color:#a1a1aa;">Gestion et visualisation des combattants</div>
        <span class="badge" style="background:#27272a;color:#d4d4d8;">W-L-D et taux de victoire</span>
    </div>
</div>

<div class="card" style="background:#18181b;border:1px solid #27272a;">
    <div class="table-responsive">
    <table class="table table-dark table-hover mb-0" style="--bs-table-bg:#18181b;--bs-table-striped-bg:#1f1f23;">
        <thead>
            <tr>
                <th style="color:#71717a;">#</th>
                <th style="color:#71717a;">Nickname</th>
                <th style="color:#71717a;">Nationalite</th>
                <th style="color:#71717a;">Weight Class</th>
                <th style="color:#71717a;">Record</th>
                <th style="color:#71717a;">Win Rate</th>
                <th style="color:#71717a;">Combats</th>
                <th style="color:#71717a;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for combattant in combattants %}
            {% set total = combattant.wins + combattant.losses + combattant.draws %}
            {% set winRate = total > 0 ? ((combattant.wins / total) * 100)|round(1) : 0 %}
            <tr>
                <td style="color:#a1a1aa;">{{ loop.index }}</td>
                <td style="font-weight:700;color:#fff;">{{ combattant.nickname }}</td>
                <td style="color:#a1a1aa;">{{ combattant.nationalite }}</td>
                <td style="color:#a1a1aa;">{{ combattant.weightClass }}</td>
                <td style="color:#d4d4d8;">{{ combattant.wins }}-{{ combattant.losses }}-{{ combattant.draws }}</td>
                <td>
                    <span style="color: {{ winRate >= 70 ? '#16a34a' : (winRate >= 40 ? '#f59e0b' : '#dc2626') }}; font-weight:700;">
                        {{ winRate }}%
                    </span>
                </td>
                <td style="color:#a1a1aa;">{{ total }}</td>
                <td>
                    <div class="d-flex gap-2">
                    <a href="{{ path('app_combattant_show', {id: combattant.id}) }}" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <a href="{{ path('app_combattant_edit', {id: combattant.id}) }}" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-pen"></i>
                    </a>
                    <form method="post" action="{{ path('app_combattant_delete', {id: combattant.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete'~combattant.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Supprimer ce combattant ?')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="8" class="text-center text-muted py-5">
                    Aucun combattant trouvé.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endblock %}