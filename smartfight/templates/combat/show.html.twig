{% extends 'admin/base_admin.html.twig' %}

{% block title %}Combat{% endblock %}

{% block admin_content %}
    <h1>Combat</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ combat.id }}</td>
            </tr>
            <tr>
                <th>ScoreIA</th>
                <td>{{ combat.scoreIA }}</td>
            </tr>
            <tr>
                <th>Resultat</th>
                <td>{{ combat.resultat }}</td>
            </tr>
            <tr>
                <th>DateCombat</th>
                <td>{{ combat.dateCombat ? combat.dateCombat|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_combat_index') }}">back to list</a>

    <a href="{{ path('app_combat_edit', {'id': combat.id}) }}">edit</a>

    {{ include('combat/_delete_form.html.twig') }}
{% endblock %}
