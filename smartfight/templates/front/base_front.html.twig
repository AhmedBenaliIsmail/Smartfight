{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('frontoffice/css/smartfight.css') }}">
    <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
    {% block extra_css %}{% endblock %}
{% endblock %}

{% block body %}
    {% include 'front/partials/navbar.html.twig' %}

    <main>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="container mt-3">
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>

    {% include 'front/partials/footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('frontoffice/js/main.js') }}"></script>
    {% block extra_js %}{% endblock %}
{% endblock %}
