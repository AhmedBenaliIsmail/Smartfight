{% extends 'base.html.twig' %}

{% block title %}Create Account — SmartFight{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Inter:wght@400;500&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background: #09090b; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }
        .register-card { background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 480px; }
        .register-logo { font-family: 'Oswald', sans-serif; font-size: 2rem; font-weight: 700; color: #fff; text-align: center; margin-bottom: .25rem; letter-spacing: 2px; }
        .register-logo span { color: #dc2626; }
        .register-subtitle { text-align: center; color: #71717a; font-size: .875rem; margin-bottom: 2rem; }
        .form-control, .form-select {
            background: #09090b;
            border: 1px solid #27272a;
            color: #fff;
            font-size: .9rem;
        }
        .form-control:focus, .form-select:focus {
            background: #09090b;
            border-color: #dc2626;
            color: #fff;
            box-shadow: 0 0 0 0.2rem rgba(220,38,38,.25);
        }
        .form-control::placeholder { color: #52525b; }
        .form-control.is-invalid { border-color: #ef4444; }
        .invalid-feedback { color: #ef4444; font-size: .8rem; }
        label.form-label, .form-check-label { color: #a1a1aa; font-size: .875rem; }
        .form-check-input { background-color: #09090b; border-color: #27272a; }
        .form-check-input:checked { background-color: #dc2626; border-color: #dc2626; }
        .form-check-input:focus { box-shadow: 0 0 0 0.2rem rgba(220,38,38,.25); }
        .btn-sf-primary {
            background: #dc2626; border: none; color: #fff;
            font-family: 'Oswald', sans-serif; font-weight: 600;
            letter-spacing: 1px; padding: .75rem; width: 100%;
        }
        .btn-sf-primary:hover { background: #b91c1c; color: #fff; }
        .btn-sf-google {
            background: transparent; border: 1px solid #27272a; color: #a1a1aa;
            font-family: 'Oswald', sans-serif; font-weight: 600;
            letter-spacing: 1px; padding: .75rem; width: 100%;
        }
        .btn-sf-google:hover { border-color: #52525b; color: #fff; background: #27272a; }
        .divider { display: flex; align-items: center; color: #52525b; font-size: .75rem; margin: 1.25rem 0; }
        .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px solid #27272a; }
        .divider::before { margin-right: .75rem; }
        .divider::after { margin-left: .75rem; }
        .back-link { display: block; text-align: center; margin-top: 1.25rem; color: #71717a; font-size: .85rem; text-decoration: none; }
        .back-link:hover { color: #a1a1aa; }
        .section-label { color: #52525b; font-size: .7rem; font-family: 'Oswald', sans-serif; letter-spacing: 1px; text-transform: uppercase; margin-bottom: .75rem; border-bottom: 1px solid #27272a; padding-bottom: .4rem; }
    </style>
{% endblock %}

{% block body %}
<div class="register-card">
    <div class="register-logo">SMART<span>FIGHT</span></div>
    <p class="register-subtitle">Create your fan account</p>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-3" style="background:#27272a;border-color:#3f3f46;color:#fff;">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <a href="{{ path('connect_google_start') }}" class="btn btn-sf-google mb-3">
        <i class="fa-brands fa-google me-2"></i>Sign up with Google
    </a>

    <div class="divider">or sign up with email</div>

    {{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}

        <div class="section-label">Personal info</div>

        <div class="row g-3 mb-3">
            <div class="col-6">
                <label class="form-label">First name</label>
                {{ form_widget(registrationForm.firstName, { attr: { class: 'form-control', placeholder: 'John' } }) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>
            <div class="col-6">
                <label class="form-label">Last name</label>
                {{ form_widget(registrationForm.lastName, { attr: { class: 'form-control', placeholder: 'Doe' } }) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Username</label>
            {{ form_widget(registrationForm.username, { attr: { class: 'form-control', placeholder: 'johndoe123' } }) }}
            {{ form_errors(registrationForm.username) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            {{ form_widget(registrationForm.email, { attr: { class: 'form-control', placeholder: 'you@example.com' } }) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="section-label mt-4">Password</div>

        <div class="row g-3 mb-4">
            <div class="col-6">
                <label class="form-label">Password</label>
                {{ form_widget(registrationForm.plainPassword.first, { attr: { class: 'form-control', placeholder: '••••••••' } }) }}
                {{ form_errors(registrationForm.plainPassword.first) }}
            </div>
            <div class="col-6">
                <label class="form-label">Confirm</label>
                {{ form_widget(registrationForm.plainPassword.second, { attr: { class: 'form-control', placeholder: '••••••••' } }) }}
                {{ form_errors(registrationForm.plainPassword.second) }}
            </div>
        </div>

        <div class="form-check mb-4">
            {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'form-check-input' } }) }}
            <label class="form-check-label">I agree to the terms of service</label>
            {{ form_errors(registrationForm.agreeTerms) }}
        </div>

        <button type="submit" class="btn btn-sf-primary">
            <i class="fa-solid fa-user-plus me-2"></i>Create Account
        </button>

    {{ form_end(registrationForm) }}

    <a href="{{ path('app_login') }}" class="back-link">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to sign in
    </a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
