<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartFight World Rankings</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #09090b;
            color: #fafafa;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #18181b 0%, #1c0a0a 100%);
            border-bottom: 2px solid #dc2626;
            padding: 20px 16px 16px;
            text-align: center;
        }
        .header h1 {
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .header h1 span { color: #dc2626; }
        .header .subtitle {
            font-size: 0.72rem;
            color: #71717a;
            margin-top: 4px;
        }
        .header .timestamp {
            font-size: 0.68rem;
            color: #52525b;
            margin-top: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }
        .dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #22c55e;
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

        .download-bar {
            background: #dc2626;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .download-bar span { font-size: 0.78rem; font-weight: 600; }
        .download-bar a {
            background: rgba(255,255,255,0.2);
            color: #fff;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            white-space: nowrap;
            border: 1px solid rgba(255,255,255,0.3);
        }

        .division {
            margin: 16px 12px 0;
        }
        .division-title {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #fbbf24;
            padding: 10px 12px;
            border-left: 3px solid #fbbf24;
            background: rgba(251,191,36,0.05);
            border-radius: 0 8px 8px 0;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .division-title .count {
            font-size: 0.65rem;
            color: #71717a;
            font-weight: 500;
            letter-spacing: 0;
        }

        .fighter-card {
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .fighter-card.gold   { border-left: 4px solid #fbbf24; background: linear-gradient(90deg, rgba(251,191,36,0.05) 0%, #18181b 60%); }
        .fighter-card.silver { border-left: 4px solid #94a3b8; background: linear-gradient(90deg, rgba(148,163,184,0.05) 0%, #18181b 60%); }
        .fighter-card.bronze { border-left: 4px solid #c2855a; background: linear-gradient(90deg, rgba(194,133,90,0.05) 0%, #18181b 60%); }

        .avatar {
            width: 48px; height: 48px;
            border-radius: 50%;
            background: #27272a;
            border: 2px solid #3f3f46;
            display: flex; align-items: center; justify-content: center;
            color: #71717a;
            font-size: 1.1rem;
            flex-shrink: 0;
            overflow: hidden;
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }

        .fighter-info { flex: 1; min-width: 0; }
        .fighter-name {
            font-weight: 700;
            font-size: 0.95rem;
            color: #fafafa;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .fighter-nickname {
            font-size: 0.68rem;
            color: #71717a;
            font-style: italic;
            margin-top: 1px;
        }
        .fighter-record {
            font-size: 0.7rem;
            margin-top: 4px;
        }
        .fighter-record .w { color: #22c55e; font-weight: 700; }
        .fighter-record .l { color: #dc2626; font-weight: 700; }
        .fighter-record .d { color: #94a3b8; font-weight: 700; }
        .fighter-record .sep { color: #3f3f46; margin: 0 2px; }
        .streak-hot { color: #ef4444; font-size: 0.7rem; font-weight: 700; }

        .rank-badge {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            flex-shrink: 0;
        }
        .rank-label {
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 6px;
        }
        .rank-label.gold   { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }
        .rank-label.silver { background: rgba(148,163,184,0.15); color: #94a3b8; border: 1px solid rgba(148,163,184,0.3); }
        .rank-label.bronze { background: rgba(194,133,90,0.15); color: #c2855a; border: 1px solid rgba(194,133,90,0.3); }
        .rank-label.normal { background: #27272a; color: #71717a; border: 1px solid #3f3f46; }
        .rank-pts {
            font-size: 1.25rem;
            font-weight: 900;
            color: #fbbf24;
            line-height: 1;
        }
        .rank-pts-label {
            font-size: 0.55rem;
            color: #52525b;
            text-align: right;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .footer {
            text-align: center;
            padding: 24px 16px;
            color: #3f3f46;
            font-size: 0.65rem;
            margin-top: 8px;
        }
        .footer strong { color: #52525b; }

        .empty {
            text-align: center;
            padding: 48px 16px;
            color: #52525b;
        }
        .empty-icon { font-size: 3rem; margin-bottom: 12px; }
    </style>
</head>
<body>

<div class="header">
    <h1>🏆 WORLD <span>STANDINGS</span></h1>
    <p class="subtitle">Official Divisional Rankings · ELO × SmartFight Performance Index</p>
    <div class="timestamp">
        <span class="dot"></span>
        Updated: {{ lastUpdated|date('M d, Y H:i') }}
    </div>
</div>

<div class="download-bar">
    <span>📄 Get the full PDF report</span>
    <a href="{{ pdfUrl }}">Download PDF</a>
</div>

{% if groupedRankings|length > 0 %}
    {% for wd, fighters in groupedRankings %}
    <div class="division">
        <div class="division-title">
            ⚡ {{ wd }} Division
            <span class="count">{{ fighters|length }} boxer{{ fighters|length != 1 ? 's' : '' }}</span>
        </div>

        {% for idx, f in fighters %}
        {% set rank = idx + 1 %}
        {% set pts  = (f.eloRating + f.performanceScore * 10)|round %}
        <div class="fighter-card {{ rank == 1 ? 'gold' : rank == 2 ? 'silver' : rank == 3 ? 'bronze' : '' }}">

            <div class="avatar">
                {% if f.photoFilename %}
                    <img src="http://{{ '192.168.1.14' }}:8001/uploads/boxers/{{ f.photoFilename }}" alt="{{ f.fullName }}">
                {% else %}
                    👤
                {% endif %}
            </div>

            <div class="fighter-info">
                <div class="fighter-name">{{ f.fullName }}</div>
                {% if f.nickname %}
                <div class="fighter-nickname">"{{ f.nickname }}"</div>
                {% endif %}
                <div class="fighter-record">
                    <span class="w">{{ f.wins }}W</span>
                    <span class="sep">–</span>
                    <span class="l">{{ f.losses }}L</span>
                    <span class="sep">–</span>
                    <span class="d">{{ f.draws }}D</span>
                    {% if f.winStreak >= 3 %}
                        &nbsp;<span class="streak-hot">🔥 {{ f.winStreak }}W</span>
                    {% endif %}
                </div>
            </div>

            <div class="rank-badge">
                {% if rank == 1 %}
                    <span class="rank-label gold">👑 CHAMP</span>
                {% elseif rank == 2 %}
                    <span class="rank-label silver">🥈 #2</span>
                {% elseif rank == 3 %}
                    <span class="rank-label bronze">🥉 #3</span>
                {% else %}
                    <span class="rank-label normal">#{{ rank }}</span>
                {% endif %}
                <div class="rank-pts">{{ pts }}</div>
                <div class="rank-pts-label">PTS</div>
            </div>

        </div>
        {% endfor %}
    </div>
    {% endfor %}
{% else %}
    <div class="empty">
        <div class="empty-icon">🥊</div>
        <p>No boxers in divisional records yet.</p>
    </div>
{% endif %}

<div class="footer">
    &copy; {{ lastUpdated|date('Y') }} <strong>SmartFight</strong> · All rights reserved
</div>

</body>
</html>