{% extends 'base.html.twig' %}

{% block title %}Rankings — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item active">Rankings</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Global Rankings</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Overall standings based on ELO + Performance Points</p>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_ADMIN') %}
        <form action="{{ path('app_ranking_recalc') }}" method="post" style="display:inline-block;">
            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-arrows-rotate me-2"></i>Recalculate All Rankings</button>
        </form>
        {% endif %}
        <a href="{{ path('app_ranking_export') }}" class="btn btn-outline-success"><i class="fa-solid fa-file-export me-2"></i>CSV</a>
    </div>
</div>

{% if groupedRankings|length > 0 %}
    {% for wc, fighters in groupedRankings %}
        <div class="mb-5">
            <h2 class="h4 mb-3 fw-bold" style="color:#fbbf24; border-bottom: 2px solid #fbbf24; display: inline-block; padding-bottom: 5px;">
                <i class="fa-solid fa-layer-group me-2"></i>{{ wc }} Division
            </h2>
            <div class="card" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover mb-0 text-center">
                        <thead>
                        <tr>
                            <th class="text-start" style="padding:.75rem 1.25rem;">Rank</th>
                            <th class="text-start">Fighter</th>
                            <th>Record (W-L-D)</th>
                            <th>Total Points</th>
                            <th>ELO</th>
                            <th>Perf Score</th>
                            <th>Streak</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for idx, f in fighters %}
                            <tr>
                                <td class="text-start" style="padding:.75rem 1.25rem;">
                                    {% if idx == 0 %}
                                        <span class="badge bg-warning text-dark rounded-pill px-3 fs-6"><i class="fa-solid fa-crown me-1"></i>#1 CHAMP</span>
                                    {% else %}
                                        <span class="badge bg-secondary rounded-pill px-3 fs-6">#{{ idx + 1 }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-start" style="padding:.75rem 1.25rem;">
                                    <div class="fw-bold" style="color:#fafafa;">{{ f.fullName }}</div>
                                    <div class="text-muted small">{{ f.nickname ? '"' ~ f.nickname ~ '"' : '' }}</div>
                                </td>
                                <td>
                                    <span style="color:#22c55e;font-weight:700">{{ f.wins }}W</span> - 
                                    <span style="color:#dc2626;font-weight:700">{{ f.losses }}L</span> - 
                                    <span style="color:#a1a1aa;font-weight:700">{{ f.draws }}D</span>
                                </td>
                                <td class="fs-5 fw-bold" style="color:#fbbf24;">{{ (f.eloRating + f.performanceScore * 10)|round }}</td>
                                <td>{{ f.eloRating|round }}</td>
                                <td>{{ f.performanceScore|round(1) }}</td>
                                <td>
                                    {% if f.winStreak >= 3 %}🔥 <span class="text-danger fw-bold">{{ f.winStreak }}W</span>
                                    {% else %}{{ f.winStreak }}{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="text-center py-5">
        <i class="fa-solid fa-user-slash fa-3x mb-3 text-muted"></i>
        <h3 class="text-muted">No fighters found for this division/search.</h3>
    </div>
{% endif %}
{% endblock %}
