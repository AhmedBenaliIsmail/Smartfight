{% extends 'front/base_front.html.twig' %}

{% block title %}World Boxing Standings — SmartFight{% endblock %}

{% block extra_css %}
<style>
    .ranking-hero {
        background: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #09090b 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 4rem 0;
        position: relative;
        overflow: hidden;
    }
    .ranking-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url('{{ asset('images/noise.png') }}');
        opacity: 0.2;
        mix-blend-mode: overlay;
    }
    .hero-title {
        font-family: 'Oswald', sans-serif;
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        background: linear-gradient(to right, #ffffff, #a1a1aa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }
    .hero-subtitle {
        color: #a1a1aa;
        font-size: 1.1rem;
        letter-spacing: 1px;
        max-width: 600px;
    }
    .admin-controls {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
    }
    .btn-recalc {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
    }
    .btn-recalc:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
        color: white;
    }
    .btn-export {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: all 0.3s;
    }
    .btn-export:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    
    .division-section {
        margin-bottom: 5rem;
    }
    .division-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .division-title {
        font-family: 'Oswald', sans-serif;
        font-size: 2rem;
        color: #fbbf24;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin: 0;
    }
    
    .champion-card {
        background: linear-gradient(145deg, #18181b, #09090b);
        border: 1px solid #fbbf24;
        border-radius: 20px;
        padding: 2rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(251, 191, 36, 0.1);
    }
    .champion-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 300px;
        height: 100%;
        background: radial-gradient(circle, rgba(251, 191, 36, 0.15) 0%, transparent 70%);
        pointer-events: none;
    }
    .champ-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #fbbf24;
        color: #000;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .champ-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 3px solid #fbbf24;
        padding: 4px;
        background: #09090b;
        flex-shrink: 0;
    }
    .champ-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }
    .champ-avatar i {
        font-size: 3rem;
        color: #3f3f46;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
    .champ-info h3 {
        font-family: 'Oswald', sans-serif;
        font-size: 2.5rem;
        color: #fff;
        margin: 0 0 0.5rem 0;
        line-height: 1.1;
    }
    .champ-stats {
        display: flex;
        gap: 2rem;
        margin-top: 1rem;
    }
    .stat-item {
        display: flex;
        flex-direction: column;
    }
    .stat-val {
        font-family: 'Oswald', sans-serif;
        font-size: 1.5rem;
        color: #fbbf24;
        line-height: 1;
    }
    .stat-lbl {
        font-size: 0.7rem;
        color: #a1a1aa;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .ranking-table {
        background: #121214;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        overflow: hidden;
    }
    .table {
        margin-bottom: 0;
        color: #e4e4e7;
    }
    .table thead th {
        background: rgba(255, 255, 255, 0.02);
        color: #71717a;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .table tbody tr {
        transition: all 0.2s;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }
    .table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }
    .table td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        background: transparent;
        border: none;
    }
    .rank-number {
        font-family: 'Oswald', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: #71717a;
        width: 50px;
    }
    .contender-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #27272a;
        margin-right: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .contender-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .contender-name {
        font-weight: 700;
        color: #fff;
        font-size: 1.1rem;
    }
    .contender-nickname {
        font-size: 0.8rem;
        color: #a1a1aa;
    }
    
    .points-highlight {
        font-family: 'Oswald', sans-serif;
        font-size: 1.25rem;
        color: #fff;
    }
    
    .streak-badge {
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.05);
    }
    .streak-badge.hot {
        background: rgba(220, 38, 38, 0.1);
        color: #ef4444;
        border: 1px solid rgba(220, 38, 38, 0.2);
    }
    
    .qr-panel {
        background: #18181b;
        border: 1px solid #27272a;
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-top: 4rem;
    }
    .qr-svg {
        background: #fff;
        padding: 10px;
        border-radius: 12px;
        width: 120px;
        height: 120px;
    }
    .qr-svg svg {
        width: 100%;
        height: 100%;
    }
</style>
{% endblock %}

{% block content %}
<!-- Hero Section -->
<div class="ranking-hero mb-5">
    <div class="container position-relative z-1">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge bg-danger rounded-pill px-3 py-2 text-uppercase fw-bold letter-spacing-1">Official Standings</span>
                    <span class="text-muted small"><i class="fa-solid fa-clock-rotate-left me-1"></i>Updated: {{ lastUpdated|date('M d, Y') }}</span>
                </div>
                <h1 class="hero-title">World Boxing Rankings</h1>
                <p class="hero-subtitle">Comprehensive divisional standings powered by the SmartFight Hybrid ELO and Performance Matrix. Discover the champions and rising contenders across all weight classes.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="admin-controls d-inline-block text-start">
                    <h4 class="text-white fs-6 mb-3 text-uppercase fw-bold letter-spacing-1 border-bottom border-secondary pb-2">Actions</h4>
                    <div class="d-flex flex-column gap-2">
                        {% if is_granted('ROLE_ADMIN') %}
                        <form action="{{ path('app_ranking_recalc') }}" method="post" class="m-0">
                            <button type="submit" class="btn-recalc w-100">
                                <i class="fa-solid fa-microchip me-2"></i>Compute ELO Algorithm
                            </button>
                        </form>
                        {% endif %}
                        <a href="{{ path('app_ranking_export') }}" class="btn-export text-center text-decoration-none">
                            <i class="fa-solid fa-file-csv me-2"></i>Download CSV Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Search / Filter -->
    <div class="row mb-5">
        <div class="col-md-6">
            <form action="{{ path('app_rankings') }}" method="get" class="position-relative">
                <i class="fa-solid fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" name="q" value="{{ q }}" class="form-control bg-dark text-white border-secondary ps-5 py-3 rounded-3" placeholder="Search fighters by name...">
            </form>
        </div>
    </div>

    {% if groupedRankings|length > 0 %}
        {% for wd, fighters in groupedRankings %}
            <div class="division-section">
                <div class="division-header">
                    <i class="fa-solid fa-scale-balanced fs-3 text-muted"></i>
                    <h2 class="division-title">{{ wd }} Division</h2>
                </div>

                {% if fighters|length > 0 %}
                    {% set champ = fighters[0] %}
                    
                    <!-- Champion Card -->
                    <div class="champion-card">
                        <div class="champ-badge">
                            <i class="fa-solid fa-crown"></i> WORLD CHAMPION
                        </div>
                        <div class="champ-avatar">
                            {% if champ.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ champ.photoFilename) }}" alt="{{ champ.fullName }}">
                            {% else %}
                                <i class="fa-solid fa-user"></i>
                            {% endif %}
                        </div>
                        <div class="champ-info">
                            <h3>{{ champ.fullName }}</h3>
                            <div class="text-muted fw-bold mb-3">{{ champ.nickname ? '"' ~ champ.nickname ~ '"' : 'Undisputed' }}</div>
                            <div class="champ-stats">
                                <div class="stat-item">
                                    <span class="stat-val text-success">{{ champ.wins }}<span class="text-white">-</span><span class="text-danger">{{ champ.losses }}</span><span class="text-white">-</span>{{ champ.draws }}</span>
                                    <span class="stat-lbl">PRO RECORD</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-val">{{ (champ.eloRating + champ.performanceScore * 10)|round }}</span>
                                    <span class="stat-lbl">TOTAL RATING</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-val">{{ champ.eloRating|round }}</span>
                                    <span class="stat-lbl">BASE ELO</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-val">{{ champ.performanceScore|round(1) }}</span>
                                    <span class="stat-lbl">PERF SCORE</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contenders Table -->
                    {% if fighters|length > 1 %}
                    <div class="ranking-table table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 80px;">Rank</th>
                                    <th>Fighter</th>
                                    <th>Record</th>
                                    <th>Total Rating</th>
                                    <th class="d-none d-md-table-cell">ELO</th>
                                    <th class="d-none d-md-table-cell">Perf Score</th>
                                    <th>Streak</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for idx in 1..(fighters|length - 1) %}
                                    {% set f = fighters[idx] %}
                                    <tr>
                                        <td class="text-center">
                                            <span class="rank-number">#{{ idx + 1 }}</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="contender-avatar">
                                                    {% if f.photoFilename %}
                                                        <img src="{{ asset('uploads/boxers/' ~ f.photoFilename) }}" alt="{{ f.fullName }}">
                                                    {% else %}
                                                        <i class="fa-solid fa-user text-muted"></i>
                                                    {% endif %}
                                                </div>
                                                <div>
                                                    <div class="contender-name"><a href="{{ path('app_performance_show', {'id': f.fighterId}) }}" class="text-white text-decoration-none">{{ f.fullName }}</a></div>
                                                    <div class="contender-nickname">{{ f.nickname ? '"' ~ f.nickname ~ '"' : '' }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-success">{{ f.wins }}W</span> - 
                                            <span class="fw-bold text-danger">{{ f.losses }}L</span>
                                            <span class="text-muted small">({{ f.draws }}D)</span>
                                        </td>
                                        <td>
                                            <span class="points-highlight">{{ (f.eloRating + f.performanceScore * 10)|round }}</span>
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted fw-bold">
                                            {{ f.eloRating|round }}
                                        </td>
                                        <td class="d-none d-md-table-cell text-muted fw-bold">
                                            {{ f.performanceScore|round(1) }}
                                        </td>
                                        <td>
                                            {% if f.winStreak >= 3 %}
                                                <span class="streak-badge hot"><i class="fa-solid fa-fire me-1"></i>{{ f.winStreak }}W</span>
                                            {% else %}
                                                <span class="streak-badge text-muted">{{ f.winStreak }}W</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <div class="text-center py-5 my-5">
            <i class="fa-solid fa-trophy fa-4x text-muted mb-4 opacity-50"></i>
            <h3 class="text-white">No fighters found</h3>
            <p class="text-muted">Try adjusting your search criteria or wait for fighters to be classified.</p>
        </div>
    {% endif %}

    <!-- Mobile Sync Panel -->
    <div class="qr-panel">
        <div class="qr-svg">
            {{ qrSvg|raw }}
        </div>
        <div>
            <h3 class="text-white fw-bold mb-2">Sync Rankings to Mobile</h3>
            <p class="text-muted mb-0">Scan this QR code to access the dedicated mobile-optimized view of the current standings, or <a href="{{ path('app_ranking_pdf') }}" class="text-danger fw-bold text-decoration-none" target="_blank">download the official PDF report</a>.</p>
        </div>
    </div>
</div>
{% endblock %}
