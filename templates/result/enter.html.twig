{% extends 'base.html.twig' %}

{% block title %}Enter Result — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_results') }}" style="color:#a1a1aa;text-decoration:none;">Fight Results</a></li>
    <li class="breadcrumb-item active">Enter Result</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Enter Fight Result</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Completing a fight will recalculate ELO and rankings automatically.</p>
    </div>
    <a href="{{ path('app_results') }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<form method="post">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body text-center p-4">
                    <h2 class="mb-3">Fight FR-{{ result.resultId }}</h2>
                    <div class="d-flex justify-content-center align-items-center gap-4">
                        <div class="text-end">
                            <div class="fs-3 fw-bold text-danger">{{ fighter1 ? fighter1.fullName : 'Unknown' }}</div>
                            <div class="text-muted">{{ fighter1 ? fighter1.weightClass : '' }}</div>
                        </div>
                        <div class="vs-badge mx-2">VS</div>
                        <div class="text-start">
                            <div class="fs-3 fw-bold text-primary">{{ fighter2 ? fighter2.fullName : 'Unknown' }}</div>
                            <div class="text-muted">{{ fighter2 ? fighter2.weightClass : '' }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-gavel me-2" style="color:#c9a227;"></i>Outcome</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12 mb-3">
                            <label class="form-label d-block text-center fs-5 mb-3">Winner</label>
                            <div class="d-flex justify-content-center gap-4">
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="win1" value="fighter1" required>
                                    <label class="form-check-label text-danger fw-bold ms-2" for="win1">{{ fighter1 ? fighter1.fullName : 'Fighter 1' }}</label>
                                </div>
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="winDraw" value="draw" required>
                                    <label class="form-check-label ms-2" for="winDraw">DRAW</label>
                                </div>
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="win2" value="fighter2" required>
                                    <label class="form-check-label text-primary fw-bold ms-2" for="win2">{{ fighter2 ? fighter2.fullName : 'Fighter 2' }}</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Method of Victory <span style="color:#dc2626;">*</span></label>
                            <select name="method" class="form-select" required>
                                <option value="DECISION">Decision</option>
                                <option value="KO/TKO">KO/TKO</option>
                                <option value="SUBMISSION">Submission</option>
                                <option value="DISQUALIFICATION">Disqualification</option>
                                <option value="DRAW">Draw</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ended In Round</label>
                            <input type="number" name="round" class="form-control" value="3" min="1" max="5" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fight Date / Time</label>
                            <input type="datetime-local" name="fightDate" class="form-control" value="{{ 'now'|date('Y-m-d\\TH:i') }}" />
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-chart-simple me-2" style="color:#22c55e;"></i>Performance Statistics</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        {# Red Corner Stats #}
                        <div class="col-md-6 border-end" style="border-right-color:#27272a !important;">
                            <h4 class="text-danger mb-3 fw-bold small text-uppercase">Red Corner: {{ fighter1.fullName }}</h4>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Strikes Landed</label>
                                    <input type="number" name="f1_strikes_landed" class="form-control" placeholder="0" min="0" required data-limit="f1_strikes_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Strikes Thrown</label>
                                    <input type="number" name="f1_strikes_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">TD Successful</label>
                                    <input type="number" name="f1_td_landed" class="form-control" placeholder="0" min="0" required data-limit="f1_td_attempts">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">TD Attempts</label>
                                    <input type="number" name="f1_td_attempts" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Submissions</label>
                                    <input type="number" name="f1_subs" class="form-control bg-dark-subtle" placeholder="0" value="0" readonly>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Knockdowns/KO</label>
                                    <input type="number" name="f1_kds" class="form-control bg-dark-subtle" placeholder="0" value="0" readonly>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">Control Time (Seconds)</label>
                                    <input type="number" name="f1_control_time" class="form-control" placeholder="Total seconds (e.g. 180)" min="0" value="0">
                                </div>
                            </div>
                        </div>

                        {# Blue Corner Stats #}
                        <div class="col-md-6">
                            <h4 class="text-primary mb-3 fw-bold small text-uppercase">Blue Corner: {{ fighter2.fullName }}</h4>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Strikes Landed</label>
                                    <input type="number" name="f2_strikes_landed" class="form-control" placeholder="0" min="0" required data-limit="f2_strikes_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Strikes Thrown</label>
                                    <input type="number" name="f2_strikes_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">TD Successful</label>
                                    <input type="number" name="f2_td_landed" class="form-control" placeholder="0" min="0" required data-limit="f2_td_attempts">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">TD Attempts</label>
                                    <input type="number" name="f2_td_attempts" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Submissions</label>
                                    <input type="number" name="f2_subs" class="form-control bg-dark-subtle" placeholder="0" value="0" readonly>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Knockdowns/KO</label>
                                    <input type="number" name="f2_kds" class="form-control bg-dark-subtle" placeholder="0" value="0" readonly>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">Control Time (Seconds)</label>
                                    <input type="number" name="f2_control_time" class="form-control" placeholder="Total seconds (e.g. 180)" min="0" value="0">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body p-3">
                    <button type="submit" class="btn btn-success w-100 py-2 fs-5"><i class="fa-solid fa-check-double me-2"></i>Save Result & Stats</button>
                    <p class="text-center text-muted small mt-2 mb-0">Record updates automatically across Elo, Performance, and Rankings.</p>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const inputs = document.querySelectorAll('input[data-limit]');
    const winnerRadios = document.querySelectorAll('input[name="winner"]');
    const methodSelect = document.querySelector('select[name="method"]');
    
    // Auto-update KO/SUB based on result
    const updateAutoStats = () => {
        const winner = document.querySelector('input[name="winner"]:checked')?.value;
        const method = methodSelect.value;
        
        // Reset all
        document.querySelector('input[name="f1_subs"]').value = 0;
        document.querySelector('input[name="f1_kds"]').value = 0;
        document.querySelector('input[name="f2_subs"]').value = 0;
        document.querySelector('input[name="f2_kds"]').value = 0;
        
        if (winner === 'draw') return;
        
        if (method === 'KO/TKO') {
            const target = (winner === 'fighter1') ? 'f1_kds' : 'f2_kds';
            document.querySelector(`input[name="${target}"]`).value = 1;
        } else if (method === 'SUBMISSION') {
            const target = (winner === 'fighter1') ? 'f1_subs' : 'f2_subs';
            document.querySelector(`input[name="${target}"]`).value = 1;
        }
    };
    
    winnerRadios.forEach(r => r.addEventListener('change', updateAutoStats));
    methodSelect.addEventListener('change', updateAutoStats);

    // Consistency Validation
    inputs.forEach(input => {
        const limitFieldName = input.getAttribute('data-limit');
        const limitField = document.querySelector(`input[name="${limitFieldName}"]`);
        
        const validate = () => {
            const landed = parseInt(input.value) || 0;
            const thrown = parseInt(limitField.value) || 0;
            
            if (landed > thrown) {
                input.classList.add('is-invalid');
                input.setCustomValidity('Landed cannot exceed thrown/attempted.');
            } else {
                input.classList.remove('is-invalid');
                input.setCustomValidity('');
            }
        };
        
        input.addEventListener('input', validate);
        limitField.addEventListener('input', validate);
    });
});
</script>
{% endblock %}
