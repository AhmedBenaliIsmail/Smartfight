{% extends 'front/base_front.html.twig' %}

{% block title %}Match Finalization Hub — SmartFight AI{% endblock %}

{% block content %}
<div id="loading-overlay" class="upload-overlay d-none">
    <div class="pro-progress-circle mb-4"></div>
    <h2 class="text-white fw-bold mb-2" style="font-family: 'Oswald', sans-serif;">FINALIZING MATCH...</h2>
    <div class="h1 text-success fw-bold" id="upload-percent-large">0%</div>
    <p class="text-muted">Synchronizing results with the Global Ranking Database...</p>
</div>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div class="header-broadcast">
            <div class="live-signal mb-2">
                <span class="pulse-dot"></span>
                <span class="live-text">PRODUCTION COMMAND</span>
            </div>
            <h1 class="display-5 fw-bold text-white mb-0" style="font-family: 'Oswald', sans-serif; letter-spacing: 2px;">BOUT FINALIZATION</h1>
            <p class="text-muted mb-0 fs-6">Recalculating Global Rankings & Analytics</p>
        </div>
        <a href="{{ path('app_results') }}" class="btn-console-back">
            <i class="fa-solid fa-arrow-left me-2"></i> ABORT ENTRY
        </a>
    </div>

    <form method="post" enctype="multipart/form-data" id="finalize-form">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                {# Matchup Visualization #}
                <div class="card card-console-dark mb-4">
                    <div class="card-body p-5">
                        <div class="row align-items-center">
                            <div class="col-md-5 text-center">
                                <div class="fighter-hero-card red">
                                    {% if fighter1 and fighter1.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ fighter1.photoFilename) }}" class="hero-img" alt="Photo" />
                                    {% else %}
                                        <div class="hero-placeholder"><i class="fa-solid fa-user"></i></div>
                                    {% endif %}
                                    <h3 class="hero-name">{{ fighter1 ? fighter1.fullName|upper : 'UNKNOWN' }}</h3>
                                    <span class="hero-tag">RED CORNER</span>
                                </div>
                            </div>
                            <div class="col-md-2 text-center">
                                <div class="vs-container">
                                    <span class="vs-main">VS</span>
                                    <div class="bout-info-mini">BOUT #{{ result.fightNumber }}</div>
                                </div>
                            </div>
                            <div class="col-md-5 text-center">
                                <div class="fighter-hero-card blue">
                                    {% if fighter2 and fighter2.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ fighter2.photoFilename) }}" class="hero-img" alt="Photo" />
                                    {% else %}
                                        <div class="hero-placeholder"><i class="fa-solid fa-user"></i></div>
                                    {% endif %}
                                    <h3 class="hero-name">{{ fighter2 ? fighter2.fullName|upper : 'UNKNOWN' }}</h3>
                                    <span class="hero-tag">BLUE CORNER</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Outcome Selection #}
                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="card card-console-dark h-100">
                            <div class="card-header-console gold">
                                <h5 class="mb-0"><i class="fa-solid fa-trophy me-3"></i>OFFICIAL OUTCOME</h5>
                            </div>
                            <div class="card-body p-4">
                                <label class="console-label-sub mb-4 text-center d-block">DECLARE VICTOR</label>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="outcome-selector">
                                            <input type="radio" name="winner" value="fighter1" class="hidden-radio" required>
                                            <div class="outcome-card red">
                                                <i class="fa-solid fa-crown"></i>
                                                <span>{{ fighter1 ? fighter1.lastName|upper : 'RED' }}</span>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="outcome-selector">
                                            <input type="radio" name="winner" value="draw" class="hidden-radio" required>
                                            <div class="outcome-card gold">
                                                <i class="fa-solid fa-equals"></i>
                                                <span>DRAW / NC</span>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="outcome-selector">
                                            <input type="radio" name="winner" value="fighter2" class="hidden-radio" required>
                                            <div class="outcome-card blue">
                                                <i class="fa-solid fa-crown"></i>
                                                <span>{{ fighter2 ? fighter2.lastName|upper : 'BLUE' }}</span>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <div class="row g-4 mt-4">
                                    <div class="col-md-6">
                                        <label class="console-label">VICTORY METHOD</label>
                                        <select name="method" class="console-select" required id="method-select">
                                            <option value="KO">KO / TKO (KNOCKOUT)</option>
                                            <option value="DECISION">DECISION (SCORECARDS)</option>
                                            <option value="DQ">DQ (DISQUALIFICATION)</option>
                                            <option value="DRAW">DRAW (OFFICIAL)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6" id="decision-type-col" style="display:none;">
                                        <label class="console-label">DECISION TYPE</label>
                                        <select name="decisionType" class="console-select">
                                            <option value="UD">UNANIMOUS (UD)</option>
                                            <option value="SD">SPLIT (SD)</option>
                                            <option value="MD">MAJORITY (MD)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="console-label">STOPPAGE ROUND</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-dark border-0 text-muted">RD</span>
                                            <input type="number" name="round" class="console-input" value="12" min="1" max="15" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card card-console-dark h-100">
                            <div class="card-header-console red">
                                <h5 class="mb-0"><i class="fa-solid fa-video me-3"></i>MEDIA FEED</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="media-upload-zone mb-3">
                                    <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2 text-danger"></i>
                                    <label class="console-label text-center">UPLOAD HIGHLIGHTS</label>
                                    <input type="file" name="videoFile" class="form-control d-none" id="videoFileInput" accept="video/*" />
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="document.getElementById('videoFileInput').click()">CHOOSE FILE</button>
                                    <p class="xsmall text-muted mt-2">MP4/WEBM UP TO 100MB</p>
                                </div>
                                <label class="console-label">OR EXTERNAL LINK</label>
                                <input type="url" name="highlightVideoUrl" class="console-input" placeholder="YouTube/Vimeo URL" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-console-action p-2">
                    <button type="submit" class="btn-finalize">
                        <i class="fa-solid fa-check-double me-2"></i> PUBLISH OFFICIAL RESULT
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
.header-broadcast { border-left: 4px solid #dc2626; padding-left: 20px; }
.pulse-dot { width: 8px; height: 8px; background: #dc2626; border-radius: 50%; display: inline-block; box-shadow: 0 0 8px #dc2626; animation: blink 1.5s infinite; }
@keyframes blink { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
.live-text { font-size: 0.65rem; font-weight: 900; color: #dc2626; letter-spacing: 2px; margin-left: 8px; }

.btn-console-back { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #a1a1aa; font-weight: 700; font-size: 0.8rem; padding: 10px 20px; border-radius: 8px; transition: all 0.3s; text-decoration: none; }
.btn-console-back:hover { background: #27272a; color: #fff; }

.card-console-dark { background: #121214; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; }
.card-header-console { padding: 15px 24px; background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(255,255,255,0.05); }
.card-header-console h5 { font-family: 'Oswald', sans-serif; font-weight: 700; color: #fff; letter-spacing: 1px; }
.card-header-console.gold { border-left: 4px solid #c9a227; }
.card-header-console.red { border-left: 4px solid #dc2626; }

/* Hero Cards */
.fighter-hero-card { position: relative; padding: 20px; border-radius: 20px; transition: all 0.3s; }
.hero-img { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid #27272a; margin-bottom: 15px; }
.fighter-hero-card.red .hero-img { border-color: #dc2626; box-shadow: 0 0 20px rgba(220, 38, 38, 0.2); }
.fighter-hero-card.blue .hero-img { border-color: #3b82f6; box-shadow: 0 0 20px rgba(59, 130, 246, 0.2); }
.hero-placeholder { width: 140px; height: 140px; background: #27272a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #71717a; margin: 0 auto 15px; }
.hero-name { font-family: 'Oswald', sans-serif; font-weight: 800; color: #fff; letter-spacing: 1px; margin-bottom: 5px; }
.hero-tag { font-size: 0.65rem; font-weight: 900; letter-spacing: 2px; color: #71717a; }

.vs-container { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; }
.vs-main { font-family: 'Oswald', sans-serif; font-size: 3rem; font-weight: 900; color: #27272a; letter-spacing: 2px; }
.bout-info-mini { background: #27272a; color: #fff; font-size: 0.6rem; font-weight: 900; padding: 4px 12px; border-radius: 20px; letter-spacing: 1px; }

/* Selectors */
.outcome-selector { width: 100%; cursor: pointer; }
.hidden-radio { position: absolute; opacity: 0; }
.outcome-card { 
    background: #18181b; border: 1px solid rgba(255,255,255,0.05); padding: 20px; border-radius: 12px; 
    text-align: center; transition: all 0.2s; display: flex; flex-direction: column; gap: 10px;
}
.outcome-card i { font-size: 1.2rem; color: #3f3f46; transition: all 0.2s; }
.outcome-card span { font-family: 'Oswald', sans-serif; font-weight: 700; font-size: 0.9rem; color: #a1a1aa; letter-spacing: 1px; }

.hidden-radio:checked + .outcome-card.red { border-color: #dc2626; background: rgba(220, 38, 38, 0.05); }
.hidden-radio:checked + .outcome-card.red i { color: #dc2626; }
.hidden-radio:checked + .outcome-card.red span { color: #fff; }

.hidden-radio:checked + .outcome-card.blue { border-color: #3b82f6; background: rgba(59, 130, 246, 0.05); }
.hidden-radio:checked + .outcome-card.blue i { color: #3b82f6; }
.hidden-radio:checked + .outcome-card.blue span { color: #fff; }

.hidden-radio:checked + .outcome-card.gold { border-color: #c9a227; background: rgba(201, 162, 39, 0.05); }
.hidden-radio:checked + .outcome-card.gold i { color: #c9a227; }
.hidden-radio:checked + .outcome-card.gold span { color: #fff; }

.console-label { font-size: 0.65rem; font-weight: 900; color: #71717a; letter-spacing: 1.5px; margin-bottom: 10px; display: block; }
.console-label-sub { font-size: 0.75rem; font-weight: 900; color: #a1a1aa; letter-spacing: 2px; }

.console-select, .console-input {
    width: 100%; background: #09090b; border: 1px solid rgba(255,255,255,0.1); 
    color: #fff; padding: 12px 15px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;
}
.console-select:focus, .console-input:focus { outline: none; border-color: #dc2626; }

.media-upload-zone {
    background: rgba(0,0,0,0.2); border: 2px dashed rgba(255,255,255,0.05); 
    padding: 30px 20px; border-radius: 12px; display: flex; flex-direction: column; align-items: center;
}

.btn-finalize {
    width: 100%; background: #dc2626; color: #fff; border: none; padding: 18px; 
    border-radius: 10px; font-family: 'Oswald', sans-serif; font-weight: 700; 
    font-size: 1.2rem; letter-spacing: 2px; text-transform: uppercase;
    transition: all 0.3s; box-shadow: 0 4px 20px rgba(220, 38, 38, 0.3);
}
.btn-finalize:hover { background: #ef4444; transform: translateY(-2px); box-shadow: 0 6px 25px rgba(220, 38, 38, 0.4); }

.upload-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 9999; display: flex; align-items: center; justify-content: center; flex-direction: column; }
.pro-progress-circle { width: 80px; height: 80px; border: 4px solid #27272a; border-top: 4px solid #dc2626; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.xsmall { font-size: 0.6rem; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const finalizeForm = document.getElementById('finalize-form');
    const overlay = document.getElementById('loading-overlay');
    const percentEl = document.getElementById('upload-percent-large');

    finalizeForm.onsubmit = function(e) {
        const videoInput = document.querySelector('input[name="videoFile"]');
        if (!videoInput || !videoInput.files || videoInput.files.length === 0) {
            return true;
        }

        e.preventDefault();
        overlay.classList.remove('d-none');

        const formData = new FormData(finalizeForm);
        const xhr = new XMLHttpRequest();

        xhr.upload.addEventListener('progress', (ev) => {
            if (ev.lengthComputable) {
                const p = Math.round((ev.loaded / ev.total) * 100);
                percentEl.innerText = p + '%';
            }
        });

        xhr.onload = function() {
            if (xhr.status >= 200 && xhr.status < 400) {
                window.location.href = "{{ path('app_results') }}";
            } else {
                let msg = 'Status: ' + xhr.status;
                try {
                    const r = JSON.parse(xhr.responseText);
                    if (r.error) msg = r.error;
                } catch (e) {}
                alert('Sync Error: ' + msg);
                overlay.classList.add('d-none');
            }
        };

        xhr.onerror = function() {
            alert('Network Error: Connection to the SmartFight server was lost.');
            overlay.classList.add('d-none');
        };

        xhr.open('POST', finalizeForm.action || window.location.href, true);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.send(formData);
    };

    const methodSelect = document.getElementById('method-select');
    const decisionCol = document.getElementById('decision-type-col');

    if (methodSelect) {
        const syncDecisionUI = () => {
            decisionCol.style.display = (methodSelect.value === 'DECISION') ? 'block' : 'none';
        };
        syncDecisionUI();
        methodSelect.addEventListener('change', syncDecisionUI);
    }
});
</script>
{% endblock %}
