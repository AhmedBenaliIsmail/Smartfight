{% extends 'base.html.twig' %}

{% block title %}Enter Result — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_results') }}" style="color:#a1a1aa;text-decoration:none;">Fight Results</a></li>
    <li class="breadcrumb-item active">Enter Result</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Enter Fight Result</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Completing a boxing match will recalculate global rankings and CompuBox analytics.</p>
    </div>
    <a href="{{ path('app_results') }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
</div>

<form method="post">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body text-center p-4">
                    <h2 class="mb-3">Fight #{{ result.fightNumber }} ({{ result.event.eventName }})</h2>
                    <div class="d-flex justify-content-center align-items-center gap-5">
                        <div class="text-center">
                            {% if fighter1 and fighter1.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ fighter1.photoFilename) }}" class="rounded-circle mb-2" style="width:100px; height:100px; object-fit:cover; border:3px solid #dc2626;" alt="Photo" />
                            {% else %}
                                <div class="rounded-circle mb-2 d-inline-flex align-items-center justify-content-center" style="width:100px; height:100px; background:#27272a; color:#a1a1aa; border:3px solid #dc2626;">
                                    <i class="fa-solid fa-user fa-3x"></i>
                                </div>
                            {% endif %}
                            <div class="fs-4 fw-bold text-danger">{{ fighter1 ? fighter1.fullName : 'Unknown' }}</div>
                            <div class="text-muted small">{{ fighter1 and fighter1.weightDivision ? fighter1.weightDivision.name : '' }}</div>
                        </div>
                        
                        <div class="vs-badge fs-3 fw-bold" style="background:#27272a; padding:15px; border-radius:50%; border:1px solid #3f3f46;">VS</div>
                        
                        <div class="text-center">
                            {% if fighter2 and fighter2.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ fighter2.photoFilename) }}" class="rounded-circle mb-2" style="width:100px; height:100px; object-fit:cover; border:3px solid #3b82f6;" alt="Photo" />
                            {% else %}
                                <div class="rounded-circle mb-2 d-inline-flex align-items-center justify-content-center" style="width:100px; height:100px; background:#27272a; color:#a1a1aa; border:3px solid #3b82f6;">
                                    <i class="fa-solid fa-user fa-3x"></i>
                                </div>
                            {% endif %}
                            <div class="fs-4 fw-bold text-primary">{{ fighter2 ? fighter2.fullName : 'Unknown' }}</div>
                            <div class="text-muted small">{{ fighter2 and fighter2.weightDivision ? fighter2.weightDivision.name : '' }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-gavel me-2" style="color:#c9a227;"></i>Outcome</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12 mb-3">
                            <label class="form-label d-block text-center fs-5 mb-3">Winner</label>
                            <div class="d-flex justify-content-center gap-4">
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="win1" value="fighter1" required>
                                    <label class="form-check-label text-danger fw-bold ms-2" for="win1">{{ fighter1 ? fighter1.fullName : 'Fighter 1' }}</label>
                                </div>
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="winDraw" value="draw" required>
                                    <label class="form-check-label ms-2" for="winDraw">DRAW / NC</label>
                                </div>
                                <div class="form-check form-check-inline form-check-custom">
                                    <input class="form-check-input" type="radio" name="winner" id="win2" value="fighter2" required>
                                    <label class="form-check-label text-primary fw-bold ms-2" for="win2">{{ fighter2 ? fighter2.fullName : 'Fighter 2' }}</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Method <span style="color:#dc2626;">*</span></label>
                            <select name="method" class="form-select" required id="method-select">
                                <option value="KO">KO / TKO</option>
                                <option value="DECISION">Decision</option>
                                <option value="DQ">Disqualification</option>
                                <option value="DRAW">Draw</option>
                            </select>
                        </div>
                        <div class="col-md-3" id="decision-type-col" style="display:none;">
                            <label class="form-label">Decision Type</label>
                            <select name="decisionType" class="form-select">
                                <option value="UD">Unanimous (UD)</option>
                                <option value="SD">Split (SD)</option>
                                <option value="MD">Majority (MD)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">End Round</label>
                            <input type="number" name="round" class="form-control" value="12" min="1" max="12" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Belt Fight?</label>
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" name="isBeltFight" value="1">
                            </div>
                        </div>
                        <div class="col-md-2" id="belt-org-col" style="display:none;">
                            <label class="form-label">Sanction</label>
                            <select name="beltOrganization" class="form-select">
                                <option value="WBC">WBC</option>
                                <option value="WBA">WBA</option>
                                <option value="IBF">IBF</option>
                                <option value="WBO">WBO</option>
                                <option value="UNDISPUTED">UNDISPUTED</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-chart-simple me-2" style="color:#22c55e;"></i>CompuBox Boxing Statistics</h3>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        {# Red Corner Stats #}
                        <div class="col-md-6 border-end" style="border-right-color:#27272a !important;">
                            <h4 class="text-danger mb-3 fw-bold small text-uppercase">Red: {{ fighter1.fullName }}</h4>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Punches Landed</label>
                                    <input type="number" name="f1_punches_landed" class="form-control" placeholder="0" min="0" required data-limit="f1_punches_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Punches Thrown</label>
                                    <input type="number" name="f1_punches_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Power Landed</label>
                                    <input type="number" name="f1_power_landed" class="form-control" placeholder="0" min="0" required data-limit="f1_power_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Power Thrown</label>
                                    <input type="number" name="f1_power_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Jabs Landed</label>
                                    <input type="number" name="f1_jabs_landed" class="form-control" placeholder="0" min="0" required data-limit="f1_jabs_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Jabs Thrown</label>
                                    <input type="number" name="f1_jabs_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Body Shots</label>
                                    <input type="number" name="f1_body_shots" class="form-control" placeholder="0" min="0" value="0">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Knockdowns</label>
                                    <input type="number" name="f1_kds" class="form-control" placeholder="0" value="0" min="0">
                                </div>
                            </div>
                        </div>

                        {# Blue Corner Stats #}
                        <div class="col-md-6">
                            <h4 class="text-primary mb-3 fw-bold small text-uppercase">Blue: {{ fighter2.fullName }}</h4>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Punches Landed</label>
                                    <input type="number" name="f2_punches_landed" class="form-control" placeholder="0" min="0" required data-limit="f2_punches_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Punches Thrown</label>
                                    <input type="number" name="f2_punches_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Power Landed</label>
                                    <input type="number" name="f2_power_landed" class="form-control" placeholder="0" min="0" required data-limit="f2_power_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Power Thrown</label>
                                    <input type="number" name="f2_power_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Jabs Landed</label>
                                    <input type="number" name="f2_jabs_landed" class="form-control" placeholder="0" min="0" required data-limit="f2_jabs_thrown">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Jabs Thrown</label>
                                    <input type="number" name="f2_jabs_thrown" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Body Shots</label>
                                    <input type="number" name="f2_body_shots" class="form-control" placeholder="0" min="0" value="0">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Knockdowns</label>
                                    <input type="number" name="f2_kds" class="form-control" placeholder="0" value="0" min="0">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body p-3">
                    <button type="submit" class="btn btn-success w-100 py-2 fs-5"><i class="fa-solid fa-check-double me-2"></i>Finalize Boxing Match</button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const methodSelect = document.getElementById('method-select');
    const decisionCol = document.getElementById('decision-type-col');
    const beltSwitch = document.querySelector('input[name="isBeltFight"]');
    const beltCol = document.getElementById('belt-org-col');
    const inputs = document.querySelectorAll('input[data-limit]');

    methodSelect.addEventListener('change', function() {
        decisionCol.style.display = (this.value === 'DECISION') ? 'block' : 'none';
    });

    beltSwitch.addEventListener('change', function() {
        beltCol.style.display = this.checked ? 'block' : 'none';
    });

    // Consistency Validation
    inputs.forEach(input => {
        const limitFieldName = input.getAttribute('data-limit');
        const limitField = document.querySelector(`input[name="${limitFieldName}"]`);
        
        const validate = () => {
            const landed = parseInt(input.value) || 0;
            const thrown = parseInt(limitField.value) || 0;
            
            if (landed > thrown) {
                input.classList.add('is-invalid');
                input.setCustomValidity('Landed cannot exceed thrown.');
            } else {
                input.classList.remove('is-invalid');
                input.setCustomValidity('');
            }
        };
        
        input.addEventListener('input', validate);
        limitField.addEventListener('input', validate);
    });
});
</script>
{% endblock %}

