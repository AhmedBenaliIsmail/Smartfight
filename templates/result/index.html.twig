{% extends 'base.html.twig' %}

{% block title %}Fight Results — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item active">Fight Results</li>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .event-card-ultra {
            background: linear-gradient(145deg, #18181b, #09090b);
            border: 1px solid rgba(220, 38, 38, 0.2);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
            overflow: hidden;
            border-left: 5px solid #27272a;
        }
        .event-card-ultra.sanctioned {
            border-left-color: #c9a227;
            background: linear-gradient(145deg, #1c1917, #0c0a09);
        }
        .event-card-ultra:hover {
            border-color: #dc2626;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(220, 38, 38, 0.1);
            transform: translateY(-10px);
        }
        .org-tag-top {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(251, 191, 36, 0.15);
            color: #fbbf24;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 1px;
            border: 1px solid rgba(251, 191, 36, 0.3);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .event-title-pro {
            font-family: 'Oswald', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 1rem;
            letter-spacing: 0.5px;
            line-height: 1.2;
        }
        .info-row {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #a1a1aa;
            font-size: 0.85rem;
            margin-bottom: 0.75rem;
        }
        .status-box-mini {
            background: rgba(24, 24, 27, 0.8);
            border: 1px solid #27272a;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            margin: 1.25rem 0;
        }
        .ultra-manage-btn {
            background: #dc2626;
            color: #fff;
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            border: none;
            text-decoration: none !important;
        }
        .ultra-manage-btn:hover {
            background: #ef4444;
            transform: scale(1.02);
            color: #fff;
        }
        [data-live-search] {
            transition: opacity 0.3s ease;
        }
        .search-hidden {
            display: none !important;
        }
    </style>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa; font-family: 'Oswald', sans-serif; letter-spacing: 1px;">{{ title|default('FIGHT RESULTS CENTRAL') }}</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">
            Select a sanctioned event card to verify round-by-round statistics
        </p>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_result_schedule') }}" class="btn btn-primary btn-sm px-3 fw-bold"><i class="fa-solid fa-calendar-plus me-1"></i>SCHEDULE BOUT</a>
        {% endif %}
        <a href="{{ path('app_result_export') }}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-download me-1"></i>EXPORT CSV</a>
    </div>
</div>

<!-- Event Picker Filter -->
<div class="card mb-4" style="background:#18181b;border:1px solid #27272a; border-radius: 15px;">
    <div class="card-body py-3">
        <form onsubmit="return false;">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color:#3f3f46;"><i class="fa-solid fa-magnifying-glass" style="color:#71717a;"></i></span>
                        <input type="text" id="eventSearchInput" class="form-control border-start-0" placeholder="Search by Event Name, Venue or Fighter..." style="background:#27272a;border-color:#3f3f46;color:#fafafa;" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-blue-lt"><i class="fa-solid fa-bolt me-1"></i>High-Velocity Real-time Filtering</span>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-4" id="eventCardGrid">
    {% for event in events %}
        {% set stats = eventStats[event.eventId] %}
        {% set fighters = eventFighters[event.eventId]|default('') %}
        <div class="col-lg-4 col-md-6 event-search-item" 
             data-search-content="{{ event.eventName|lower }} {{ event.venue|lower }} {{ event.city|lower }} {{ fighters|lower }}">
            <div class="event-card-ultra {% if event.organization != 'INDEPENDENT' %}sanctioned{% endif %}">
                {% if event.organization != 'INDEPENDENT' %}
                    <div class="org-tag-top">
                        <i class="fa-solid fa-crown"></i>
                        {{ event.organization }}
                    </div>
                {% endif %}

                <div class="event-title-pro">{{ event.eventName }}</div>
                
                <div class="info-row">
                    <i class="fa-solid fa-calendar-day text-danger"></i>
                    <span>{{ event.eventDate|date('l, M d, Y') }}</span>
                </div>
                <div class="info-row">
                    <i class="fa-solid fa-map-pin text-danger"></i>
                    <span>{{ event.venue }}, {{ event.city }}</span>
                </div>

                <div class="status-box-mini">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        {% if stats.total == 0 %}
                            <span class="small text-muted fw-bold">NO FIGHTS SCHEDULED</span>
                            <span class="badge bg-secondary-lt">EMPTY</span>
                        {% elseif stats.isFullyCompleted %}
                            <span class="small text-success fw-bold">COMPLETED</span>
                            <span class="badge bg-green-lt">{{ stats.completed }}/{{ stats.total }}</span>
                        {% else %}
                            <span class="small text-blue fw-bold">IN PROGRESS</span>
                            <span class="badge bg-blue-lt">{{ stats.completed }}/{{ stats.total }}</span>
                        {% endif %}
                    </div>
                    <div class="progress" style="height: 4px; background: #09090b; border-radius: 10px;">
                        <div class="progress-bar {% if stats.isFullyCompleted %}bg-success{% else %}bg-blue{% endif %}" 
                             style="width: {{ stats.total > 0 ? (stats.completed/stats.total*100) : 0 }}%; border-radius: 10px;"></div>
                    </div>
                </div>

                <a href="{{ path('app_result_manage_card', {id: event.eventId}) }}" class="ultra-manage-btn mt-2">
                    {% if is_granted('ROLE_ADMIN') %}
                        <i class="fa-solid fa-pen-to-square"></i>MANAGE RESULTS
                    {% else %}
                        <i class="fa-solid fa-chart-line"></i>VIEW ANALYTICS
                    {% endif %}
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <p class="text-muted">No boxing events found in the ledger.</p>
        </div>
    {% endfor %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('eventSearchInput');
    const cards = document.querySelectorAll('.event-search-item');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            cards.forEach(card => {
                const content = card.getAttribute('data-search-content');
                if (content.includes(query)) {
                    card.classList.remove('search-hidden');
                } else {
                    card.classList.add('search-hidden');
                }
            });
        });
    }
});
</script>
{% endblock %}
