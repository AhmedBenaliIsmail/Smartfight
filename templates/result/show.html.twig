{% extends 'base.html.twig' %}
{% block title %}Match Analytics — {{ result.fighter1.lastName }} vs {{ result.fighter2.lastName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root { --red:#ef4444;--blue:#3b82f6;--gold:#f59e0b;--surface:#18181b;--border:#27272a;--muted:#71717a; }
        .analytics-card {
            background: linear-gradient(145deg, #18181b, #09090b);
            border: 1px solid #27272a;
            border-radius: 24px;
            overflow: hidden;
        }
        .stat-badge-premium {
            background: rgba(220, 38, 38, 0.1);
            color: #ef4444;
            padding: 8px 16px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.75rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .stat-grid-row {
            display: grid;
            grid-template-columns: 1fr 120px 1fr;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .stat-grid-row:last-child { border-bottom: none; }
        .stat-value {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
        }
        .stat-label-center {
            text-align: center;
            color: #71717a;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .progress-stat-bar {
            height: 6px;
            background: #27272a;
            border-radius: 3px;
            overflow: hidden;
            display: flex;
        }
        .red-fill { background: linear-gradient(90deg, #dc2626, #ef4444); border-radius: 3px; }
        .blue-fill { background: linear-gradient(90deg, #2563eb, #3b82f6); border-radius: 3px; }
        .round-tab {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 52px;
            height: 34px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid var(--border);
            color: var(--muted);
            background: transparent;
            text-decoration: none;
            transition: all .2s;
        }
        .round-tab:hover { border-color: #52525b; color: #fafafa; }
        .round-tab.active { background: var(--red); border-color: var(--red); color: #fff; }
        .round-tab.has-data { border-color: #22c55e; color: #22c55e; }
        .round-tab.active.has-data { background: #16a34a; border-color: #16a34a; color: #fff; }
        .round-panel { display: none; }
        .round-panel.active { display: block; }
        .cb-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
        .cb-red-top { border-top: 3px solid var(--red); }
        .cb-blue-top { border-top: 3px solid var(--blue); }
        .cb-header { padding: .75rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
        .corner-tag { font-size: .65rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: .2rem .6rem; border-radius: 20px; }
        .red-tag { background: rgba(239,68,68,.15); color: var(--red); }
        .blue-tag { background: rgba(59,130,246,.15); color: var(--blue); }
        .stat-group-label { font-size: .6rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #3f3f46; padding: .4rem 1.25rem .2rem; display: flex; align-items: center; gap: .5rem; }
        .stat-group-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }
        .stat-row-view { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; padding: .6rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,.03); }
        .stat-row-view:last-child { border-bottom: none; }
        .stat-label-sm { font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); margin-bottom: .15rem; }
        .stat-val { font-size: 1rem; font-weight: 700; color: #fafafa; }
        .itn-banner { background: linear-gradient(135deg, #991b1b, #7f1d1d); border-radius: 8px; padding: 1rem 1.25rem; }
        .itn-title { font-size: .6rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: .3rem; }
        .itn-text { font-size: .85rem; color: #fff; line-height: 1.6; }
    </style>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_results') }}" style="color:#a1a1aa;text-decoration:none">Results</a></li>
    <li class="breadcrumb-item active">Match Analytics</li>
{% endblock %}

{% block content %}
<div class="container py-4">
    {# ── FIGHT HEADER ── #}
    <div class="text-center mb-4">
        <span class="stat-badge-premium mb-3 d-inline-block">OFFICIAL COMPUBOX DATA</span>
        <h1 class="h2 fw-bold text-white mb-2" style="letter-spacing: 1px;">{{ result.fighter1.fullName }} vs {{ result.fighter2.fullName }}</h1>
        <p class="text-muted">{{ result.event.eventName }} — {{ result.event.eventDate|date('M d, Y') }}</p>
        {% if result.winner %}
            <span class="badge bg-danger px-3 py-2 fs-6">Winner: {{ result.winner.fullName }} by {{ result.methodOfVictory|default('Decision') }}</span>
        {% elseif result.isDraw is defined and result.isDraw %}
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">DRAW</span>
        {% endif %}
    </div>

    {# ── TOTAL FIGHT SUMMARY ── #}
    <div class="analytics-card p-4 mb-4">
        <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-chart-pie me-2 text-danger"></i>Fight Totals</h5>
        {% set f1_total_thrown = 0 %}{% set f1_total_landed = 0 %}
        {% set f2_total_thrown = 0 %}{% set f2_total_landed = 0 %}
        {% set f1_total_kd = 0 %}{% set f2_total_kd = 0 %}
        {% set roundsWithData = [] %}
        {% for r in 1..rounds %}
            {% set s1 = fighterStats[result.fighter1.fighterId][r]|default(null) %}
            {% set s2 = fighterStats[result.fighter2.fighterId][r]|default(null) %}
            {% if s1 %}
                {% set f1_total_thrown = f1_total_thrown + s1.punchesThrown %}
                {% set f1_total_landed = f1_total_landed + s1.punchesLanded %}
                {% set f1_total_kd = f1_total_kd + s1.knockdowns %}
                {% set roundsWithData = roundsWithData|merge([r]) %}
            {% endif %}
            {% if s2 %}
                {% set f2_total_thrown = f2_total_thrown + s2.punchesThrown %}
                {% set f2_total_landed = f2_total_landed + s2.punchesLanded %}
                {% set f2_total_kd = f2_total_kd + s2.knockdowns %}
            {% endif %}
        {% endfor %}

        {% set f1_pct = f1_total_thrown > 0 ? (f1_total_landed / f1_total_thrown * 100)|round(1) : 0 %}
        {% set f2_pct = f2_total_thrown > 0 ? (f2_total_landed / f2_total_thrown * 100)|round(1) : 0 %}
        {% set total_thrown = f1_total_thrown + f2_total_thrown %}
        {% set f1_bar = total_thrown > 0 ? (f1_total_thrown / total_thrown * 100)|round : 50 %}

        <div class="stat-grid-row">
            <div class="text-end">
                <div class="stat-value">{{ f1_total_landed }} / {{ f1_total_thrown }}</div>
                <div class="small text-muted">{{ f1_pct }}% Connect</div>
            </div>
            <div class="stat-label-center">Total Punches</div>
            <div class="text-start">
                <div class="stat-value">{{ f2_total_landed }} / {{ f2_total_thrown }}</div>
                <div class="small text-muted">{{ f2_pct }}% Connect</div>
            </div>
        </div>
        <div class="progress-stat-bar mb-3">
            <div class="red-fill" style="width:{{ f1_bar }}%"></div>
            <div class="blue-fill" style="width:{{ 100 - f1_bar }}%"></div>
        </div>

        <div class="stat-grid-row">
            <div class="text-end"><div class="stat-value">{{ f1_total_kd }}</div></div>
            <div class="stat-label-center">Knockdowns</div>
            <div class="text-start"><div class="stat-value">{{ f2_total_kd }}</div></div>
        </div>
    </div>

    {# ── ROUND-BY-ROUND TABS ── #}
    <div class="analytics-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="text-white fw-bold mb-0"><i class="fa-solid fa-rectangle-list me-2 text-warning"></i>Round-by-Round CompuBox</h5>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_stat_new', {fightId: result.resultId, round: 1}) }}" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    <i class="fa-solid fa-pen-to-square me-1"></i>Edit Stats
                </a>
            {% endif %}
        </div>

        {# Round Selector Pills #}
        <div class="d-flex flex-wrap gap-2 mb-4">
            {% for r in 1..rounds %}
                <button class="round-tab {% if r == 1 %}active{% endif %} {% if r in roundsWithData %}has-data{% endif %}" 
                        onclick="showRound({{ r }})" data-round="{{ r }}">
                    R{{ r }}
                </button>
            {% endfor %}
        </div>

        {# Round Panels #}
        {% for r in 1..rounds %}
        {% set s1 = fighterStats[result.fighter1.fighterId][r]|default(null) %}
        {% set s2 = fighterStats[result.fighter2.fighterId][r]|default(null) %}
        <div class="round-panel {% if r == 1 %}active{% endif %}" id="round-{{ r }}">
            {% if s1 or s2 %}
            <div class="row g-3">
                {# RED CORNER #}
                <div class="col-lg-6">
                    <div class="cb-card cb-red-top">
                        <div class="cb-header">
                            <span style="color:#fafafa;font-size:.85rem;font-weight:600">{{ result.fighter1.fullName }}</span>
                            <span class="corner-tag red-tag">Red Corner</span>
                        </div>
                        {% if s1 %}
                        <div class="stat-group-label">Total Punches</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s1.punchesThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s1.punchesLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Right Hand</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s1.rightHandThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s1.rightHandLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Left Hand</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s1.leftHandThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s1.leftHandLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Power & Jabs</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Power Thrown</div><div class="stat-val">{{ s1.powerPunchesThrown }}</div></div>
                            <div><div class="stat-label-sm">Power Landed</div><div class="stat-val">{{ s1.powerPunchesLanded }}</div></div>
                        </div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Jabs Thrown</div><div class="stat-val">{{ s1.jabsThrown }}</div></div>
                            <div><div class="stat-label-sm">Jabs Landed</div><div class="stat-val">{{ s1.jabsLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Uppercuts & Body</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Uppercuts T/L</div><div class="stat-val">{{ s1.uppercutsThrown }} / {{ s1.uppercutsLanded }}</div></div>
                            <div><div class="stat-label-sm">Body Shots</div><div class="stat-val">{{ s1.bodyShotsLanded }}</div></div>
                        </div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Knockdowns</div><div class="stat-val {% if s1.knockdowns > 0 %}text-danger{% endif %}">{{ s1.knockdowns }}</div></div>
                            <div></div>
                        </div>
                        {% else %}
                        <div class="p-3 text-center text-muted small">No data for this round</div>
                        {% endif %}
                    </div>
                </div>

                {# BLUE CORNER #}
                <div class="col-lg-6">
                    <div class="cb-card cb-blue-top">
                        <div class="cb-header">
                            <span style="color:#fafafa;font-size:.85rem;font-weight:600">{{ result.fighter2.fullName }}</span>
                            <span class="corner-tag blue-tag">Blue Corner</span>
                        </div>
                        {% if s2 %}
                        <div class="stat-group-label">Total Punches</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s2.punchesThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s2.punchesLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Right Hand</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s2.rightHandThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s2.rightHandLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Left Hand</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Thrown</div><div class="stat-val">{{ s2.leftHandThrown }}</div></div>
                            <div><div class="stat-label-sm">Landed</div><div class="stat-val">{{ s2.leftHandLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Power & Jabs</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Power Thrown</div><div class="stat-val">{{ s2.powerPunchesThrown }}</div></div>
                            <div><div class="stat-label-sm">Power Landed</div><div class="stat-val">{{ s2.powerPunchesLanded }}</div></div>
                        </div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Jabs Thrown</div><div class="stat-val">{{ s2.jabsThrown }}</div></div>
                            <div><div class="stat-label-sm">Jabs Landed</div><div class="stat-val">{{ s2.jabsLanded }}</div></div>
                        </div>
                        <div class="stat-group-label">Uppercuts & Body</div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Uppercuts T/L</div><div class="stat-val">{{ s2.uppercutsThrown }} / {{ s2.uppercutsLanded }}</div></div>
                            <div><div class="stat-label-sm">Body Shots</div><div class="stat-val">{{ s2.bodyShotsLanded }}</div></div>
                        </div>
                        <div class="stat-row-view">
                            <div><div class="stat-label-sm">Knockdowns</div><div class="stat-val {% if s2.knockdowns > 0 %}text-primary{% endif %}">{{ s2.knockdowns }}</div></div>
                            <div></div>
                        </div>
                        {% else %}
                        <div class="p-3 text-center text-muted small">No data for this round</div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="text-center py-4 text-muted">
                <i class="fa-solid fa-circle-info me-1"></i>No CompuBox data recorded for Round {{ r }}.
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_stat_new', {fightId: result.resultId, round: r}) }}" class="text-danger ms-2">Enter stats →</a>
                {% endif %}
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {# ── VIDEO HIGHLIGHT ── #}
    {% if result.videoPath or result.highlightVideoUrl %}
    <div class="analytics-card p-4 mb-4">
        <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-play me-2 text-danger"></i>Fight Highlights</h5>
        <div class="ratio ratio-16x9 rounded-3 overflow-hidden border border-secondary" style="background:#000; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
            {% if result.videoPath %}
                <video controls style="width:100%;height:100%;object-fit:contain;">
                    <source src="{{ asset('uploads/fights/highlights/' ~ result.videoPath) }}" type="video/mp4">
                </video>
            {% else %}
                {% set isYouTube = 'youtube.com' in result.highlightVideoUrl or 'youtu.be' in result.highlightVideoUrl %}
                {% if isYouTube %}
                    {% set videoId = result.highlightVideoUrl|split('v=')|last|split('&')|first|split('?')|first %}
                    {% if '/' in videoId %}{% set videoId = videoId|split('/')|last %}{% endif %}
                    <iframe src="https://www.youtube.com/embed/{{ videoId }}?rel=0" allowfullscreen style="border:none;"></iframe>
                {% else %}
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <a href="{{ result.highlightVideoUrl }}" target="_blank" class="btn btn-outline-danger rounded-pill fw-bold">Watch Highlights <i class="fa-solid fa-external-link ms-2"></i></a>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── INSIDE THE NUMBERS ── #}
    <div class="analytics-card p-4 mb-4">
        <div class="itn-banner">
            <div class="itn-title"><i class="fa-solid fa-brain me-2"></i>Inside The Numbers</div>
            <div class="itn-text">
                {{ result.insideTheNumbers|default('Detailed tactical analysis pending AI synthesis.')|nl2br }}
            </div>
        </div>
    </div>

    <div class="text-center">
        <a href="{{ path('app_result_manage_card', {id: result.event.eventId}) }}" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-bold">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Fight Card
        </a>
    </div>
</div>

<script>
function showRound(r) {
    document.querySelectorAll('.round-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.round-tab').forEach(t => t.classList.remove('active'));
    
    const panel = document.getElementById('round-' + r);
    if (panel) panel.classList.add('active');
    
    document.querySelectorAll('.round-tab').forEach(t => {
        if (parseInt(t.dataset.round) === r) t.classList.add('active');
    });
}
</script>
{% endblock %}
