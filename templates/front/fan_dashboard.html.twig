{% extends 'base.html.twig' %}

{% block title %}Fan Experience - SmartFight{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root { --sf-red: #dc2626; --sf-dark: #09090b; --sf-card: #18181b; --sf-text: #fafafa; }
        body { background-color: var(--sf-dark); color: var(--sf-text); font-family: 'Inter', sans-serif; }
        .fan-card { background: var(--sf-card); border: 1px solid #27272a; border-radius: 12px; transition: transform 0.3s ease, border-color 0.3s ease; overflow: hidden; }
        .fan-card:hover { transform: translateY(-5px); border-color: var(--sf-red); }
        .section-title { font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--sf-red); border-left: 4px solid var(--sf-red); padding-left: 15px; margin-bottom: 2rem; }
        .fighter-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid var(--sf-red); }
        .stat-badge { background: rgba(220, 38, 38, 0.1); color: var(--sf-red); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; }
        .ranking-row { border-bottom: 1px solid #27272a; padding: 12px 0; }
        .ranking-row:last-child { border-bottom: none; }
        .video-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; cursor: pointer; }
        .fan-card:hover .video-overlay { opacity: 1; }
        
        /* Calendar Theme */
        .fc { --fc-border-color: #27272a; --fc-page-bg-color: transparent; }
        .fc-toolbar-title { font-size: 1.2rem !important; font-weight: 800 !important; text-transform: uppercase; }
        .fc .fc-button-primary { background-color: var(--sf-red); border-color: var(--sf-red); font-weight: bold; text-transform: uppercase; font-size: 0.8rem; }
        .fc .fc-button-primary:hover { background-color: #b91c1c; border-color: #b91c1c; }
        .fc-daygrid-day-number { color: #71717a; font-weight: bold; padding: 10px !important; }
        .fc-col-header-cell-cushion { color: var(--sf-red); text-transform: uppercase; font-size: 0.7rem; letter-spacing: 1px; }
        .fc-day-today { background: rgba(220, 38, 38, 0.05) !important; }
        
        /* Elite Cards */
        .elite-card { background: linear-gradient(145deg, #18181b, #09090b); border: 1px solid rgba(220, 38, 38, 0.2); border-radius: 16px; overflow: hidden; position: relative; }
        .elite-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(220,38,38,0.1) 0%, transparent 70%); pointer-events: none; }
        .ko-meter { height: 6px; background: #27272a; border-radius: 3px; overflow: hidden; }
        .ko-meter-fill { height: 100%; background: linear-gradient(90deg, #dc2626, #f87171); border-radius: 3px; }
        .record-pill { background: #27272a; color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; border: 1px solid #3f3f46; }
        .poll-card { border-left: 4px solid #6366f1; }
        .voted-badge { background: rgba(34,197,94,0.15); color: #22c55e; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
        .vote-count-badge { background: rgba(99,102,241,0.15); color: #818cf8; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; }
        .perf-meter { height: 6px; background: #27272a; border-radius: 3px; overflow: hidden; }
        .perf-meter-fill { height: 100%; border-radius: 3px; }
        .champion-crown { color: #fbbf24; font-size: 0.7rem; }

        /* Recent Result Cards */
        .result-card {
            background: linear-gradient(145deg, #18181b, #09090b);
            border: 1px solid #27272a;
            border-radius: 16px;
            overflow: hidden;
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .result-card:hover {
            border-color: #dc2626;
            box-shadow: 0 10px 30px -10px rgba(220, 38, 38, 0.3);
        }
        .result-boxer-photo {
            width: 80px;
            height: 80px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid #27272a;
            transition: all 0.3s;
        }
        .result-card:hover .result-boxer-photo {
            border-color: #dc2626;
            transform: scale(1.05);
        }
        .win-indicator {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #dc2626;
            color: white;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 4px 12px;
            border-radius: 0 0 0 12px;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .highlight-btn {
            background: rgba(220, 38, 38, 0.1);
            color: #dc2626;
            border: 1px solid rgba(220, 38, 38, 0.2);
            font-size: 0.7rem;
            font-weight: 800;
            padding: 6px 15px;
            border-radius: 20px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .highlight-btn:hover {
            background: #dc2626;
            color: white;
            transform: translateY(-2px);
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Fan Experience Dashboard</li>
{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold mb-0">WELCOME BACK, <span class="text-danger">{{ app.user.username|upper }}</span></h1>
            <p class="text-muted">Your daily dose of combat sports intelligence.</p>
        </div>
        <div class="text-end">
            <div class="stat-badge mb-1">PRO ACCOUNT</div>
            <div class="fs-4 fw-bold text-white">{{ app.user.predictionPoints|default(0) }} PTS</div>
        </div>
    </div>

    <!-- Elite Fighter Showcase (Top 3 by PerformanceScore) -->
    <h2 class="section-title"><i class="fa-solid fa-fire me-2"></i>Elite Fighter Showcase</h2>
    <div class="row g-4 mb-5">
        {% for entry in eliteFighters %}
        {% set fighter = entry.fighter %}
        {% set perfScore = entry.perfScore %}
        {% set koRate = fighter.wins > 0 ? (fighter.koWins / fighter.wins * 100)|round : 0 %}
        <div class="col-md-4">
            <div class="elite-card p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    {% if fighter.photoFilename %}
                        <img src="{{ asset('uploads/boxers/' ~ fighter.photoFilename) }}" class="rounded-circle border border-2 border-danger" style="width:64px;height:64px;object-fit:cover;" alt="">
                    {% else %}
                        <img src="https://ui-avatars.com/api/?name={{ fighter.fullName }}&background=dc2626&color=fff&size=64" class="rounded-circle border border-2 border-danger" alt="">
                    {% endif %}
                    <div>
                        <h4 class="mb-0 fw-bold">{{ fighter.fullName }}</h4>
                        <div class="text-muted small">{{ fighter.weightDivision ? fighter.weightDivision.name : 'Unknown' }}</div>
                    </div>
                </div>

                {# Performance Score Breakdown #}
                {% if perfScore %}
                <div class="mb-3 p-2 rounded" style="background:#27272a;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">AI PERFORMANCE</span>
                        <span class="fw-bold" style="color:#fbbf24;">{{ perfScore.score|round(1) }}</span>
                    </div>
                    <div class="row g-1 mt-1">
                        <div class="col-3 text-center">
                            <div class="small text-muted" style="font-size:0.65rem;">AGG</div>
                            <div class="perf-meter"><div class="perf-meter-fill" style="width:{{ perfScore.aggression|default(0) }}%;background:#ef4444;"></div></div>
                            <div class="small fw-bold" style="color:#ef4444;">{{ perfScore.aggression|default(0)|round }}</div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="small text-muted" style="font-size:0.65rem;">DEF</div>
                            <div class="perf-meter"><div class="perf-meter-fill" style="width:{{ perfScore.defense|default(0) }}%;background:#3b82f6;"></div></div>
                            <div class="small fw-bold" style="color:#3b82f6;">{{ perfScore.defense|default(0)|round }}</div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="small text-muted" style="font-size:0.65rem;">TECH</div>
                            <div class="perf-meter"><div class="perf-meter-fill" style="width:{{ perfScore.technique|default(0) }}%;background:#10b981;"></div></div>
                            <div class="small fw-bold" style="color:#10b981;">{{ perfScore.technique|default(0)|round }}</div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="small text-muted" style="font-size:0.65rem;">EXP</div>
                            <div class="perf-meter"><div class="perf-meter-fill" style="width:{{ perfScore.experience|default(0) }}%;background:#a855f7;"></div></div>
                            <div class="small fw-bold" style="color:#a855f7;">{{ perfScore.experience|default(0)|round }}</div>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="d-flex gap-2 mb-3">
                    <span class="record-pill">W: {{ fighter.wins }}</span>
                    <span class="record-pill">L: {{ fighter.losses }}</span>
                    <span class="record-pill">KO: {{ fighter.koWins }}</span>
                </div>
                <div class="mb-2 d-flex justify-content-between small">
                    <span class="text-muted">KO POWER</span>
                    <span class="text-danger fw-bold">{{ koRate }}%</span>
                </div>
                <div class="ko-meter mb-3">
                    <div class="ko-meter-fill" style="width: {{ koRate }}%"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted small">ELO RATING</div>
                    <div class="badge bg-danger px-3">{{ fighter.eloRating|round }}</div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="row g-4 mb-5">
        <!-- Main Stats Chart -->
        <div class="col-lg-8">
            <div class="fan-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h5 mb-0"><i class="fa-solid fa-chart-line me-2 text-danger"></i>Prediction Performance</h3>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto">
                        <option>Last 7 Days</option>
                        <option>Last 30 Days</option>
                    </select>
                </div>
                <canvas id="predictionChart" style="max-height: 300px;"></canvas>
            </div>
        </div>

        <!-- Community Choice Matchmaking -->
        <div class="col-lg-4">
            <div class="fan-card p-4 h-100 poll-card" style="border-left: 4px solid #dc2626; background: linear-gradient(145deg, #18181b, #09090b);">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="h5 mb-0 fw-bold" style="text-transform:uppercase;letter-spacing:1px;"><i class="fa-solid fa-fire-flame-curved me-2 text-danger"></i>Community Choice</h3>
                    <span class="badge bg-danger text-uppercase" style="letter-spacing:1px;font-size:0.7rem;">Top 3 Card</span>
                </div>
                <p class="text-muted small mb-4">Your votes decide the next major event lineup!</p>
                
                <div class="mb-4">
                    <h6 class="text-white small fw-bold mb-3 uppercase" style="letter-spacing:1px; border-bottom:1px solid #27272a; padding-bottom:8px;">The People's Card:</h6>
                    {% for proposal in topVoted %}
                        <div class="p-3 rounded mb-3 position-relative" style="background: rgba(220, 38, 38, 0.05); border: 1px solid rgba(220, 38, 38, 0.2); overflow:hidden;">
                            <div class="position-absolute top-0 end-0 p-2">
                                <span class="badge bg-danger px-2 py-1"><i class="fa-solid fa-star me-1 text-warning"></i>{{ proposal.voteCount }} Votes</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <!-- Fighter 1 -->
                                <div class="text-center w-40">
                                    {% if proposal.fighter1.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ proposal.fighter1.photoFilename) }}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid #ef4444;margin-bottom:4px;">
                                    {% else %}
                                        <div style="width:40px;height:40px;border-radius:50%;background:#27272a;border:2px solid #ef4444;margin:0 auto 4px;display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-user text-muted"></i></div>
                                    {% endif %}
                                    <div class="small fw-bold text-white lh-1" style="font-size:0.8rem;">{{ proposal.fighter1.lastName }}</div>
                                </div>
                                
                                <div class="text-danger fw-bold" style="font-style:italic;font-size:0.9rem;">VS</div>
                                
                                <!-- Fighter 2 -->
                                <div class="text-center w-40">
                                    {% if proposal.fighter2.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ proposal.fighter2.photoFilename) }}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid #3b82f6;margin-bottom:4px;">
                                    {% else %}
                                        <div style="width:40px;height:40px;border-radius:50%;background:#27272a;border:2px solid #3b82f6;margin:0 auto 4px;display:flex;align-items:center;justify-content:center;"><i class="fa-solid fa-user text-muted"></i></div>
                                    {% endif %}
                                    <div class="small fw-bold text-white lh-1" style="font-size:0.8rem;">{{ proposal.fighter2.lastName }}</div>
                                </div>
                            </div>
                            <div class="text-center mt-2" style="font-size: 0.65rem; color: rgba(255,255,255,0.4); letter-spacing:1px;">{{ proposal.weightDivision ? proposal.weightDivision.name|upper : 'UNASSIGNED' }} DIVISION</div>
                            
                            <div class="d-flex justify-content-center mt-3 pt-2 border-top" style="border-color: rgba(220, 38, 38, 0.1) !important;">
                                {% if proposal.id in userVotedIds %}
                                    <span class="voted-badge px-3 py-1" style="font-size:0.7rem;"><i class="fa-solid fa-check-double me-1"></i>Voted for this Bout</span>
                                {% else %}
                                    <form action="{{ path('app_fan_vote', {id: proposal.id}) }}" method="POST" style="margin:0;">
                                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4" style="font-size:0.75rem;font-weight:800; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);">
                                            <i class="fa-solid fa-fire me-1"></i>VOTE NOW
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <hr class="border-secondary mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-muted small fw-bold mb-0 uppercase" style="letter-spacing:1px;">Other Matchups:</h6>
                    <div class="input-icon" style="width: 180px;">
                        <span class="input-icon-addon">
                            <i class="fa-solid fa-search"></i>
                        </span>
                        <input type="text" class="form-control form-control-sm" style="background:#18181b; border:1px solid #27272a; color:#fafafa;" placeholder="Search..." data-live-search=".matchups-list" data-live-search-item=".matchup-item">
                    </div>
                </div>
                
                <div class="d-flex flex-column gap-3 matchups-list">
                {% for proposal in matchProposals %}
                {% if proposal not in topVoted %}
                <div class="p-3 rounded matchup-item" style="background:#18181b; border:1px solid #27272a;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            {% if proposal.fighter1.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ proposal.fighter1.photoFilename) }}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid #ef4444;">
                            {% endif %}
                            <div class="fw-bold text-white" style="font-size:0.9rem;">{{ proposal.fighter1.lastName }}</div>
                        </div>
                        <span class="text-danger fw-bold" style="font-size:0.8rem;font-style:italic;">VS</span>
                        <div class="d-flex align-items-center gap-2 flex-row-reverse">
                            {% if proposal.fighter2.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ proposal.fighter2.photoFilename) }}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid #3b82f6;">
                            {% endif %}
                            <div class="fw-bold text-white" style="font-size:0.9rem;">{{ proposal.fighter2.lastName }}</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="vote-count-badge" style="font-size:0.75rem;"><i class="fa-solid fa-thumbs-up me-1"></i>{{ proposal.voteCount }} Votes</span>
                        
                        {% if proposal.id in userVotedIds %}
                            <span class="voted-badge px-3 py-1"><i class="fa-solid fa-check me-1"></i>Voted</span>
                        {% else %}
                            <form action="{{ path('app_fan_vote', {id: proposal.id}) }}" method="POST" style="margin:0;">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1" style="font-size:0.75rem;font-weight:600;">
                                    Vote
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
                {% else %}
                <div class="text-center py-4 text-muted small">No other pending proposals.</div>
                {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- Event Calendar Section -->
    <h2 class="section-title"><i class="fa-solid fa-calendar me-2"></i>Event Calendar</h2>
    <div class="row mb-5">
        <div class="col-12">
            <div class="fan-card p-4">
                <div id="calendar"></div>
            </div>
        </div>
    </div>

    <!-- Upcoming Events Section -->
    <h2 class="section-title"><i class="fa-solid fa-clock me-2"></i>Upcoming Events</h2>
    <div class="row g-4 mb-5">
        {% for event in upcomingEvents %}
        <div class="col-md-4">
            <div class="fan-card p-3 d-flex align-items-center justify-content-between h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger text-center p-2 rounded text-white" style="min-width: 60px;">
                        <div class="fw-bold">{{ event.eventDate|date('d') }}</div>
                        <div class="small">{{ event.eventDate|date('M') }}</div>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold fs-6">{{ event.eventName }}</h5>
                        <div class="text-muted small"><i class="fa-solid fa-location-dot me-1"></i>{{ event.city }}</div>
                    </div>
                </div>
                <a href="{{ path('app_event_fights', {id: event.id}) }}" class="btn btn-outline-danger btn-sm rounded-pill">Card</a>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="fan-card p-4 text-center text-muted">No upcoming events scheduled.</div>
        </div>
        {% endfor %}
    </div>

    <!-- Latest Media & News (Cinematic Video Dashboard) -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <h2 class="section-title mb-0"><i class="fa-solid fa-film me-2"></i>SmartFight Originals & Highlights</h2>
        <a href="#" class="btn btn-sm btn-outline-danger rounded-pill px-3">View All Media</a>
    </div>
    
    <div class="row g-4 mb-5">
        {% for article in trendingArticles %}
        <div class="col-lg-6">
            <div class="fan-card h-100 position-relative" style="border:none; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <div class="ratio ratio-16x9 position-relative bg-black" style="border-radius:12px; overflow:hidden;">
                    {% if article.videoPath %}
                        <video controls style="width:100%;height:100%;object-fit:contain;" poster="{% if article.imagePath %}{{ vich_uploader_asset(article, 'imageFile') }}{% else %}https://images.unsplash.com/photo-1549880181-56a44cf4a9a5?auto=format&fit=crop&q=80&w=1600{% endif %}">
                            <source src="{{ vich_uploader_asset(article, 'videoFile') }}" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    {% else %}
                        <a href="{{ path('front_blog_show', {id: article.id}) }}" class="d-block w-100 h-100 position-relative group">
                            {% if article.imagePath %}
                                <img src="{{ vich_uploader_asset(article, 'imageFile') }}" class="w-100 h-100" alt="{{ article.title }}" style="object-fit:cover; transition:transform 0.5s;">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1599552375245-c49b07137f8f?auto=format&fit=crop&q=80&w=800" class="w-100 h-100" alt="..." style="object-fit:cover;">
                            {% endif %}
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background:rgba(0,0,0,0.4);">
                                <i class="fa-solid fa-newspaper text-white" style="font-size:3rem; opacity:0.8;"></i>
                            </div>
                        </a>
                    {% endif %}
                </div>
                
                <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.5) 70%, transparent 100%); border-bottom-left-radius:12px; border-bottom-right-radius:12px; pointer-events:none;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-danger text-uppercase fw-bold" style="letter-spacing:1px;font-size:0.7rem;">{{ article.category ? article.category.name : 'EXCLUSIVE' }}</span>
                        <span class="text-white-50 small"><i class="fa-regular fa-clock me-1"></i>{{ article.createdAt|date('M d, Y') }}</span>
                    </div>
                    <h5 class="text-white fw-bold mb-1" style="text-shadow: 0 2px 4px rgba(0,0,0,0.8); pointer-events:auto;">
                        <a href="{{ path('front_blog_show', {id: article.id}) }}" class="text-white text-decoration-none">{{ article.title }}</a>
                    </h5>
                    {% if article.content %}
                        <p class="text-white-50 small mb-0 d-none d-md-block" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ article.content|striptags|slice(0, 100) }}...</p>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="row g-4">
        <!-- World Rankings by Weight Class -->
        <div class="col-md-6">
            <h2 class="section-title"><i class="fa-solid fa-trophy me-2"></i>World Rankings</h2>
            
            {% if worldRankingsByWeight is empty %}
                <div class="fan-card p-4 text-center text-muted small">No rankings calculated yet. Ask admin to recalculate.</div>
            {% else %}
                <ul class="nav nav-pills mb-3" id="ranking-pills-tab" role="tablist">
                    {% for weightClass, rankings in worldRankingsByWeight %}
                        <li class="nav-item me-2 mb-2" role="presentation">
                            <button class="nav-link rounded-pill border border-secondary {% if loop.first %}active bg-danger text-white{% else %}text-light bg-dark{% endif %}" id="pills-{{ weightClass|replace({' ': '-'})|lower }}-tab" data-bs-toggle="pill" data-bs-target="#pills-{{ weightClass|replace({' ': '-'})|lower }}" type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}">
                                {{ weightClass }}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
                
                <div class="tab-content" id="ranking-pills-tabContent">
                    {% for weightClass, rankings in worldRankingsByWeight %}
                        <div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="pills-{{ weightClass|replace({' ': '-'})|lower }}" role="tabpanel">
                            <div class="fan-card p-4">
                                <h6 class="text-danger fw-bold mb-4" style="font-family:'Oswald',sans-serif; letter-spacing:1px; text-transform:uppercase;">
                                    {{ weightClass }} <span class="text-muted fs-6">— Top 5</span>
                                </h6>
                                
                                {% for ranking in rankings %}
                                <div class="ranking-row d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom border-secondary" {% if loop.last %}style="border-bottom:none !important; margin-bottom:0 !important; padding-bottom:0 !important;"{% endif %}>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-muted fw-bold" style="min-width: 30px; display:inline-block; text-align:center;">
                                            {% if ranking.isChampion %}
                                                <i class="fa-solid fa-crown champion-crown text-warning"></i><br><small style="font-size:0.6rem;">C</small>
                                            {% else %}
                                                #{{ ranking.rankPosition }}
                                            {% endif %}
                                        </span>
                                        {% if ranking.fighter.photoFilename %}
                                            <img src="{{ asset('uploads/boxers/' ~ ranking.fighter.photoFilename) }}" class="fighter-avatar rounded-circle" style="width:45px;height:45px;object-fit:cover;" alt="">
                                        {% else %}
                                            <img src="https://ui-avatars.com/api/?name={{ ranking.fighter.fullName }}&background=dc2626&color=fff" class="fighter-avatar rounded-circle" style="width:45px;height:45px;" alt="">
                                        {% endif %}
                                        <div>
                                            <div class="fw-bold" style="color:#fff;">{{ ranking.fighter.fullName }}</div>
                                            <div class="text-muted small">{{ ranking.organization }}</div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-danger fw-bold">{{ ranking.points|round(1) }} pts</div>
                                        <div class="text-muted small">{{ ranking.fighter.wins }}W-{{ ranking.fighter.losses }}L</div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="col-md-6">
            <h2 class="section-title"><i class="fa-solid fa-bolt-lightning me-2"></i>Recent Fight Results</h2>
            {% for result in latestResults %}
            <div class="result-card mb-5 p-0 overflow-hidden" style="background: rgba(24, 24, 27, 0.4); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 16px;">
                <div class="row g-0">
                    <!-- Left: Matchup & Outcome (60%) -->
                    <div class="col-lg-7 p-4" style="border-right: 1px solid rgba(255, 255, 255, 0.05);">
                        <div class="d-flex align-items-center justify-content-center gap-3 mb-4">
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(220, 38, 38, 0.1); color: #dc2626; border: 1px solid rgba(220, 38, 38, 0.2); font-size: 0.6rem; letter-spacing: 1px; font-weight: 800;">OFFICIAL RESULT</span>
                            <span class="text-white small fw-bold text-uppercase" style="letter-spacing: 1px;">{{ result.methodOfVictory }} — ROUND {{ result.roundNumber }}</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between px-2">
                            <!-- Fighter 1 -->
                            <div class="text-center" style="width: 40%;">
                                <div class="position-relative d-inline-block mb-3">
                                    {% if result.fighter1.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ result.fighter1.photoFilename) }}" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid {{ result.winner == result.fighter1 ? '#dc2626' : '#27272a' }}; box-shadow: 0 10px 20px rgba(0,0,0,0.4);" alt="">
                                    {% else %}
                                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark" style="width: 100px; height: 100px; border: 3px solid #27272a;">
                                            <i class="fa-solid fa-user text-muted fa-2x"></i>
                                        </div>
                                    {% endif %}
                                    {% if result.winner == result.fighter1 %}
                                        <div class="position-absolute top-0 start-50 translate-middle-x" style="top: -10px;">
                                            <span class="badge bg-danger text-uppercase px-2" style="font-size: 0.55rem; font-weight: 900; letter-spacing: 1px;">WINNER</span>
                                        </div>
                                    {% endif %}
                                </div>
                                <h6 class="text-white fw-bold mb-1 fs-6">{{ result.fighter1.fullName|upper }}</h6>
                                <div class="text-muted small" style="font-size: 0.65rem; font-weight: 700;">{{ result.fighter1.wins }}-{{ result.fighter1.losses }} ({{ result.fighter1.koWins }} KO)</div>
                            </div>

                            <!-- VS Divider -->
                            <div class="text-danger fw-black italic h2 opacity-25" style="font-family:'Oswald', sans-serif;">VS</div>

                            <!-- Fighter 2 -->
                            <div class="text-center" style="width: 40%;">
                                <div class="position-relative d-inline-block mb-3">
                                    {% if result.fighter2.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ result.fighter2.photoFilename) }}" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid {{ result.winner == result.fighter2 ? '#dc2626' : '#27272a' }}; box-shadow: 0 10px 20px rgba(0,0,0,0.4);" alt="">
                                    {% else %}
                                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-dark" style="width: 100px; height: 100px; border: 3px solid #27272a;">
                                            <i class="fa-solid fa-user text-muted fa-2x"></i>
                                        </div>
                                    {% endif %}
                                    {% if result.winner == result.fighter2 %}
                                        <div class="position-absolute top-0 start-50 translate-middle-x" style="top: -10px;">
                                            <span class="badge bg-danger text-uppercase px-2" style="font-size: 0.55rem; font-weight: 900; letter-spacing: 1px;">WINNER</span>
                                        </div>
                                    {% endif %}
                                </div>
                                <h6 class="text-white fw-bold mb-1 fs-6">{{ result.fighter2.fullName|upper }}</h6>
                                <div class="text-muted small" style="font-size: 0.65rem; font-weight: 700;">{{ result.fighter2.wins }}-{{ result.fighter2.losses }} ({{ result.fighter2.koWins }} KO)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Cinematic Video (40%) -->
                    <div class="col-lg-5 p-4 d-flex flex-column justify-content-center bg-black-50" style="background: rgba(0,0,0,0.1);">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="fa-solid fa-clapperboard text-danger"></i>
                            <span class="text-white-50 fw-bold small text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Highlights Reel</span>
                        </div>
                        
                        {% if result.videoPath %}
                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border border-secondary" style="background:#000; box-shadow: 0 5px 25px rgba(0,0,0,0.5);">
                                <video controls style="width:100%;height:100%;object-fit:cover;">
                                    <source src="{{ asset('uploads/fights/highlights/' ~ result.videoPath) }}" type="video/mp4">
                                </video>
                            </div>
                        {% elseif result.highlightVideoUrl %}
                            {% set isYouTube = 'youtube.com' in result.highlightVideoUrl or 'youtu.be' in result.highlightVideoUrl %}
                            {% set isVimeo = 'vimeo.com' in result.highlightVideoUrl %}
                            
                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border border-secondary" style="background:#000;">
                                {% if isYouTube %}
                                    {% set videoId = result.highlightVideoUrl|split('v=')|last|split('&')|first|split('?')|first %}
                                    {% if '/' in videoId %}{% set videoId = videoId|split('/')|last %}{% endif %}
                                    <iframe src="https://www.youtube.com/embed/{{ videoId }}" allowfullscreen style="border:none;"></iframe>
                                {% elseif isVimeo %}
                                    {% set videoId = result.highlightVideoUrl|split('/')|last|split('?')|first %}
                                    <iframe src="https://player.vimeo.com/video/{{ videoId }}" allowfullscreen style="border:none;"></iframe>
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted small">
                                        <a href="{{ result.highlightVideoUrl }}" target="_blank" class="text-danger fw-bold">Watch Stream <i class="fa-solid fa-external-link ms-1"></i></a>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center rounded-3 border-1 border-dashed" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1);">
                                <i class="fa-solid fa-video-slash mb-2 opacity-25"></i>
                                <span class="text-muted small fw-bold uppercase" style="font-size: 0.6rem; letter-spacing: 1px;">Processing Highlights</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="fan-card p-5 text-center text-muted">
                <i class="fa-solid fa-ghost fa-3x mb-3 opacity-20"></i>
                <p>No recent results found in the archives.</p>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prediction Chart
        const ctx = document.getElementById('predictionChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: {{ predictionLabels|raw }},
                datasets: [{
                    label: 'Prediction Accuracy %',
                    data: {{ predictionData|raw }},
                    borderColor: '#dc2626',
                    backgroundColor: 'rgba(220, 38, 38, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        max: 100,
                        grid: { color: '#27272a' }, 
                        ticks: { 
                            color: '#71717a',
                            callback: function(value) { return value + '%'; }
                        } 
                    },
                    x: { grid: { display: false }, ticks: { color: '#71717a' } }
                }
            }
        });

        // Event Calendar
        const calendarEl = document.getElementById('calendar');
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            themeSystem: 'standard',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            events: {{ calendarEvents|raw }},
            eventClick: function(info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                    info.jsEvent.preventDefault();
                }
            }
        });
        calendar.render();
    });
</script>
{% endblock %}
