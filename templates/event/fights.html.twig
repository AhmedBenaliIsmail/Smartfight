{% extends 'base.html.twig' %}

{% block title %}Manage Boxing Card - {{ event.eventName }} — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_events') }}" style="color:#a1a1aa;text-decoration:none;">Schedule</a></li>
    <li class="breadcrumb-item active">Manage Card</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Manage Card: {{ event.eventName }}</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Building the professional boxing card (Max 3 bouts)</p>
    </div>
    <a href="{{ path('app_events') }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;"><i class="fa-solid fa-arrow-left me-1"></i>Back Schedule</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Scheduled Fights -->
        <div class="card" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-list me-2" style="color:#dc2626;"></i>Scheduled Bouts ({{ fights|length }}/3)</h3>
            </div>
            <div class="card-body p-0">
                <div class="p-3 border-bottom" style="background:rgba(59,130,246,.05);border-color:#27272a;">
                    <p class="mb-0" style="color:#60a5fa;font-size:.75rem;">
                        <i class="fa-solid fa-circle-info me-1"></i> <strong>Betting Odds Guide:</strong> We use the Decimal format. A value of 2.0 means a $100 bet returns $200 (including stake). Lower odds indicate the favorite, while higher odds indicate the underdog.
                    </p>
                </div>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="padding:.75rem 1.25rem;">Bout #</th>
                            <th>Boxer 1 (Red)</th>
                            <th>Boxer 2 (Blue)</th>
                            <th>Status</th>
                            {% if is_granted('ROLE_ADMIN') %}
                            <th class="text-end" style="padding-right:1.25rem;">Actions</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for fight in fights %}
                            <tr>
                                <td style="padding:.75rem 1.25rem;">Fight {{ fight.fightNumber }}</td>
                                <td>{{ fight.fighter1.fullName }}</td>
                                <td>{{ fight.fighter2.fullName }}</td>
                                <td>
                                    {% if fight.status == 'COMPLETED' %}
                                        <span class="badge" style="background:rgba(34,197,94,.15);color:#22c55e;">COMPLETED</span>
                                    {% elseif fight.status == 'SCHEDULED' %}
                                        <span class="badge" style="background:rgba(234,179,8,.15);color:#eab308;">SCHEDULED</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ fight.status }}</span>
                                    {% endif %}
                                </td>
                                {% if is_granted('ROLE_ADMIN') %}
                                <td class="text-end" style="padding-right:1.25rem;">
                                    {% if fight.status == 'SCHEDULED' %}
                                    <form action="{{ path('app_event_fight_delete', {'fightId': fight.resultId}) }}" method="post" onsubmit="return confirm('Remove scheduled bout from card?');">
                                        <input type="hidden" name="eventId" value="{{ event.eventId }}">
                                        <button type="submit" class="btn btn-sm" style="background:rgba(220,38,38,.15);color:#dc2626;border:none;"><i class="fa-solid fa-trash"></i> Remove</button>
                                    </form>
                                    {% else %}
                                    -
                                    {% endif %}
                                </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center" style="padding:2rem;">No bouts scheduled for this card.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <div class="col-lg-4">
        <!-- Add Fight Form -->
        {% if availableNumbers|length > 0 %}
        <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-header d-flex align-items-center justify-content-between" style="background:#18181b;border-bottom:1px solid #27272a;">
                <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-plus me-2" style="color:#3b82f6;"></i>Schedule Bout</h3>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="aiMatchmakeBtn" class="btn btn-xs" style="background:rgba(139,92,246,.15);color:#8b5cf6;border:none;font-size:.75rem;">
                        <i class="fa-solid fa-robot me-1"></i>AI Match
                    </button>
                    <i class="fa-solid fa-circle-info text-muted" style="font-size:.75rem;" 
                       title="AI logic: Groups by weight class, then calculates a similarity score based on Win/Loss parity, Height/Reach compatibility, and KO percentage."></i>
                </div>
            </div>
            <div class="card-body p-4">
                <form action="{{ path('app_event_fight_add', {'id': event.eventId}) }}" method="post">
                    <div class="mb-3">
                        <label class="form-label">Position on Card</label>
                        <select name="fightNumber" class="form-select" required>
                            {% for num in availableNumbers %}
                                <option value="{{ num }}">Fight {{ num }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Boxer 1 (Red Corner)</label>
                        <select name="fighter1Id" id="fighter1Id" class="form-select" required>
                            <option value="">Select Boxer...</option>
                            {% for f in availableFighters %}
                                <option value="{{ f.fighterId }}" data-weight-id="{{ f.weightDivision.id|default(0) }}">
                                    {{ f.fullName }} ({{ f.weightDivision ? f.weightDivision.name : 'Unknown' }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Boxer 2 (Blue Corner)</label>
                        <select name="fighter2Id" id="fighter2Id" class="form-select" required disabled>
                            <option value="">First select Red Corner...</option>
                            {% for f in availableFighters %}
                                <option value="{{ f.fighterId }}" data-weight-id="{{ f.weightDivision.id|default(0) }}" class="d-none">
                                    {{ f.fullName }} ({{ f.weightDivision ? f.weightDivision.name : 'Unknown' }})
                                </option>
                            {% endfor %}
                        </select>
                        <small class="text-muted">Only boxers in the same weight class will be shown.</small>
                    </div>
                    <button type="submit" class="btn w-100" style="background:#dc2626;color:#fff;border:none;"><i class="fa-solid fa-calendar-plus me-2"></i>Schedule Bout</button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="alert alert-info" style="background:rgba(59,130,246,.1);border-color:rgba(59,130,246,.2);color:#60a5fa;">
            <i class="fa-solid fa-info-circle me-2"></i> This event card is full (Max 3 bouts).
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const f1Select = document.getElementById('fighter1Id');
    const f2Select = document.getElementById('fighter2Id');
    
    if (f1Select && f2Select) {
        f1Select.addEventListener('change', function() {
            const selectedF1 = f1Select.options[f1Select.selectedIndex];
            const weightId = selectedF1.getAttribute('data-weight-id');
            const f1Id = f1Select.value;
            
            if (!f1Id) {
                f2Select.disabled = true;
                f2Select.value = "";
                return;
            }
            
            f2Select.disabled = false;
            f2Select.value = "";
            
            Array.from(f2Select.options).forEach(opt => {
                if (opt.value === "") return;
                
                const optWeightId = opt.getAttribute('data-weight-id');
                const isSameWeight = (optWeightId === weightId);
                const isDifferentFighter = (opt.value !== f1Id);
                
                if (isSameWeight && isDifferentFighter) {
                    opt.classList.remove('d-none');
                    opt.disabled = false;
                } else {
                    opt.classList.add('d-none');
                    opt.disabled = true;
                }
            });
            
            f2Select.options[0].textContent = "Select Opponent (" + selectedF1.text.split('(')[1];
        });
    }

    const aiBtn = document.getElementById('aiMatchmakeBtn');
    if (aiBtn) {
        aiBtn.addEventListener('click', async function() {
            aiBtn.disabled = true;
            aiBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>AI thinking...';
            
            try {
                const response = await fetch("{{ path('app_event_fight_ai', {id: event.eventId}) }}");
                const data = await response.json();
                
                if (data.error) {
                    alert(data.error);
                } else {
                    // Set Fighter 1
                    f1Select.value = data.fighter1.id;
                    f1Select.dispatchEvent(new Event('change'));
                    
                    // Set Fighter 2 after a tiny delay for the event listener to enable the field
                    setTimeout(() => {
                        f2Select.value = data.fighter2.id;
                        const s1 = data.fighter1.stats;
                        const s2 = data.fighter2.stats;
                        
                        alert('AI SUGGESTION: ' + data.fighter1.name + ' vs ' + data.fighter2.name + 
                              '\n------------------------------------------------\n' +
                              data.fighter1.name + ': ' + s1.record + ', ' + s1.height + ', ' + s1.accuracy + ' accuracy\n' +
                              data.fighter2.name + ': ' + s2.record + ', ' + s2.height + ', ' + s2.accuracy + ' accuracy\n' +
                              '------------------------------------------------\n' +
                              'MATCH QUALITY: ' + data.matchQuality + 
                              '\n\nAI METHODOLOGY:\nOur multi-vector engine now includes the "Skill Intensity Vector," analyzing the ratio of strikes thrown vs landed (accuracy). This ensures that technical volume strikers are matched against opponents with similar precision, maintaining the highest standard of professional competitive parity.');
                    }, 50);
                }
            } catch (e) {
                alert('Matchmaking failed. Please try manually.');
            } finally {
                aiBtn.disabled = false;
                aiBtn.innerHTML = '<i class="fa-solid fa-robot me-1"></i>AI Match';
            }
        });
    }
});
</script>
{% endblock %}
