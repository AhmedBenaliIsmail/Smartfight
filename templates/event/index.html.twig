{% extends 'front/base_front.html.twig' %}

{% block title %}{{ title|default('Events') }} — SmartFight{% endblock %}

{% block extra_css %}
    <style>
        .event-card-ultra {
            background: linear-gradient(145deg, #18181b, #09090b);
            border: 1px solid rgba(220, 38, 38, 0.2);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
            overflow: hidden;
        }
        .event-card-ultra:hover {
            border-color: #dc2626;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(220, 38, 38, 0.1);
            transform: translateY(-10px);
        }
        .event-card-ultra::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #dc2626, #fbbf24);
            opacity: 0.6;
        }
        .org-tag-top {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(251, 191, 36, 0.15);
            color: #fbbf24;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 1px;
            border: 1px solid rgba(251, 191, 36, 0.3);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .event-title-pro {
            font-family: 'Oswald', sans-serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }
        .info-row {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #a1a1aa;
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }
        .status-box {
            background: rgba(24, 24, 27, 0.8);
            border: 1px solid #27272a;
            border-radius: 16px;
            padding: 1rem;
            margin: 1.5rem 0;
        }
        .ultra-manage-btn {
            background: #dc2626;
            color: #fff;
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s;
            border: none;
            text-decoration: none !important;
        }
        .ultra-manage-btn:hover {
            background: #ef4444;
            transform: scale(1.02);
            color: #fff;
        }
        .action-dot {
            width: 40px;
            height: 40px;
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #71717a;
            transition: all 0.2s;
        }
        .action-dot:hover {
            background: #27272a;
            color: #fff;
        }
        /* Custom Pagination Styles */
        .modern-pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 3rem;
        }
        .modern-pagination .page-item .page-link {
            background: #18181b;
            border: 1px solid #27272a;
            color: #a1a1aa;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 600;
            transition: all 0.2s;
        }
        .modern-pagination .page-item.active .page-link {
            background: #dc2626;
            border-color: #dc2626;
            color: #fff;
        }
        .modern-pagination .page-item:not(.active) .page-link:hover {
            background: #27272a;
            color: #fff;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="h2 fw-bold text-white mb-1" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">EVENT MANAGEMENT</h1>
            <p class="text-muted mb-0">Directing professional boxing spectacles and world title events</p>
        </div>
        <form method="GET" action="{{ path('app_events') }}" class="d-flex flex-wrap gap-3 align-items-center mt-3 p-3 rounded w-100" style="background: rgba(24,24,27,0.5); border: 1px solid #27272a;">
            <div class="position-relative flex-grow-1" style="min-width: 250px;">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" name="q" id="search-input" value="{{ current_q|default('') }}" class="form-control" style="background:#18181b; border:1px solid #27272a; color:#fafafa;" placeholder="Search events..." autocomplete="off">
                </div>
                <ul id="search-suggestions" class="list-group position-absolute w-100 mt-1 d-none" style="z-index: 1000; background: #18181b; border: 1px solid #27272a; border-radius: 8px; max-height: 250px; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.5);"></ul>
            </div>
            
            <select name="organization" class="form-select" style="width: auto; background:#18181b; border:1px solid #27272a; color:#fafafa;">
                <option value="">All Organizations</option>
                <option value="WBC" {% if current_org|default('') == 'WBC' %}selected{% endif %}>WBC</option>
                <option value="WBA" {% if current_org|default('') == 'WBA' %}selected{% endif %}>WBA</option>
                <option value="IBF" {% if current_org|default('') == 'IBF' %}selected{% endif %}>IBF</option>
                <option value="WBO" {% if current_org|default('') == 'WBO' %}selected{% endif %}>WBO</option>
                <option value="INDEPENDENT" {% if current_org|default('') == 'INDEPENDENT' %}selected{% endif %}>INDEPENDENT</option>
            </select>

            <select name="status" class="form-select" style="width: auto; background:#18181b; border:1px solid #27272a; color:#fafafa;">
                <option value="">All Statuses</option>
                <option value="SCHEDULED" {% if current_status|default('') == 'SCHEDULED' %}selected{% endif %}>SCHEDULED</option>
                <option value="LIVE" {% if current_status|default('') == 'LIVE' %}selected{% endif %}>LIVE</option>
                <option value="COMPLETED" {% if current_status|default('') == 'COMPLETED' %}selected{% endif %}>COMPLETED</option>
                <option value="CANCELLED" {% if current_status|default('') == 'CANCELLED' %}selected{% endif %}>CANCELLED</option>
            </select>

            <select name="sortBy" class="form-select" style="width: auto; background:#18181b; border:1px solid #27272a; color:#fafafa;">
                <option value="date_desc" {% if current_sortBy|default('date_desc') == 'date_desc' %}selected{% endif %}>Date (Newest)</option>
                <option value="date_asc" {% if current_sortBy|default('') == 'date_asc' %}selected{% endif %}>Date (Oldest)</option>
                <option value="capacity_desc" {% if current_sortBy|default('') == 'capacity_desc' %}selected{% endif %}>Capacity (Largest)</option>
                <option value="capacity_asc" {% if current_sortBy|default('') == 'capacity_asc' %}selected{% endif %}>Capacity (Smallest)</option>
            </select>

            <button type="submit" class="btn btn-outline-danger fw-bold"><i class="fa-solid fa-filter me-2"></i>Apply</button>
            <a href="{{ path('app_events') }}" class="btn btn-link text-muted text-decoration-none">Reset</a>
            
            <div class="ms-auto d-flex gap-2">
                <a href="{{ path('app_event_map') }}" class="btn btn-outline-secondary fw-bold text-white">
                    <i class="fa-solid fa-map-location-dot me-2"></i>MAP
                </a>
                <a href="{{ path('app_event_calendar') }}" class="btn btn-outline-secondary fw-bold text-white">
                    <i class="fa-solid fa-calendar me-2"></i>CALENDAR
                </a>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_event_new') }}" class="btn btn-danger px-4 fw-bold {% if not is_granted('ROLE_ADMIN') %}ms-auto{% endif %}">
                <i class="fa-solid fa-plus me-2"></i>CREATE EVENT
            </a>
            {% endif %}
        </form>
    </div>

    <div class="row g-4 event-grid">
        {% for event in pagination %}
            {% set fight_count = fightCounts[event.eventId]|default(0) %}
            <div class="col-lg-4 col-md-6 event-card-col">
                <div class="event-card-ultra">
                    <div class="event-title-pro">{{ event.eventName }}</div>
                    
                    {% if event.isChampionsEvent %}
                        <div class="org-tag-top">
                            <i class="fa-solid fa-crown"></i>
                            {{ event.organization }} BELT
                        </div>
                    {% endif %}
                    
                    <div class="info-row">
                        <i class="fa-solid fa-calendar-day text-danger"></i>
                        <span>{{ event.eventDate ? event.eventDate|date('l, M d, Y') : 'Date TBD' }}</span>
                    </div>
                    
                    <div class="info-row">
                        <i class="fa-solid fa-map-pin text-danger"></i>
                        <span>{{ event.venue|default('TBD') }}, {{ event.city|default('TBD') }}</span>
                    </div>

                    <div class="status-box">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted fw-bold uppercase">Sanctioning Progress</span>
                            <span class="text-white small fw-bold">{{ fight_count }}/3 BOUTS</span>
                        </div>
                        <div class="progress" style="height: 6px; background: #09090b; border-radius: 10px;">
                            <div class="progress-bar bg-danger" style="width: {{ (fight_count/3*100) }}%; border-radius: 10px;"></div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a href="{{ path('app_event_fights', {'id': event.eventId}) }}" class="ultra-manage-btn flex-grow-1">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            Manage Card
                        </a>
                        <a href="{{ path('app_event_flyer', {'id': event.eventId}) }}" target="_blank" class="action-dot text-danger" title="Download Flyer">
                            <i class="fa-solid fa-file-pdf"></i>
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="dropdown">
                                <button class="action-dot" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary">
                                    <li><a class="dropdown-item text-white" href="{{ path('app_event_edit', {'id': event.eventId}) }}"><i class="fa-solid fa-pen me-2"></i>Edit Profile</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <form method="post" action="{{ path('app_event_delete', {'id': event.eventId}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.eventId) }}">
                                            <button class="dropdown-item text-danger"><i class="fa-solid fa-trash me-2"></i>Remove Event</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% endif %}
                        {# Google Calendar Link - Works for everyone #}
                        {% if event.eventDate %}
                            {% set gcal_title = event.eventName|url_encode %}
                            {% set gcal_date = event.eventDate|date('Ymd') %}
                            {% set gcal_location = ((event.venue|default('')) ~ ' ' ~ (event.city|default('')))|url_encode %}
                            {% set gcal_details = ('Organization: ' ~ event.organization)|url_encode %}
                            <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text={{ gcal_title }}&dates={{ gcal_date }}/{{ gcal_date }}&location={{ gcal_location }}&details={{ gcal_details }}" target="_blank" title="Add to Google Calendar" class="action-dot" style="color: #4285f4; border-color: rgba(66,133,244,0.3);">
                                <i class="fa-brands fa-google"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
                <h3 class="text-white">No Sanctioned Events</h3>
                <p class="text-muted">Start by scheduling a professional boxing card.</p>
            </div>
        {% endfor %}
    </div>

    <div class="modern-pagination">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('search-input');
        const suggestionsBox = document.getElementById('search-suggestions');
        let timeout = null;

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                clearTimeout(timeout);
                const query = this.value.trim();
                
                if (query.length < 2) {
                    suggestionsBox.classList.add('d-none');
                    return;
                }

                timeout = setTimeout(() => {
                    fetch(`{{ path('app_event_search_suggestions') }}?q=${encodeURIComponent(query)}`)
                        .then(response => response.json())
                        .then(data => {
                            suggestionsBox.innerHTML = '';
                            if (data.length > 0) {
                                data.forEach(item => {
                                    const li = document.createElement('li');
                                    li.className = 'list-group-item list-group-item-action text-white';
                                    li.style.background = '#18181b';
                                    li.style.borderBottom = '1px solid #27272a';
                                    li.style.cursor = 'pointer';
                                    li.textContent = item.name;
                                    li.addEventListener('mouseenter', () => { li.style.background = '#27272a'; });
                                    li.addEventListener('mouseleave', () => { li.style.background = '#18181b'; });
                                    li.addEventListener('click', () => {
                                        searchInput.value = item.name;
                                        suggestionsBox.classList.add('d-none');
                                        searchInput.closest('form').submit();
                                    });
                                    suggestionsBox.appendChild(li);
                                });
                                suggestionsBox.classList.remove('d-none');
                            } else {
                                suggestionsBox.classList.add('d-none');
                            }
                        });
                }, 300);
            });

            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.classList.add('d-none');
                }
            });
        }
    });
</script>
{% endblock %}
{% endblock %}
