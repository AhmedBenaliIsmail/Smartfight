{% extends 'base.html.twig' %}

{% block title %}{{ title|default('Events') }} — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item active">{{ title|default('Events') }}</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">{{ title|default('Events') }}</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Manage and schedule boxing event cards</p>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_event_new') }}" class="btn btn-danger"><i class="fa-solid fa-plus me-2"></i>Create Event</a>
    {% endif %}
</div>

<div class="card mb-3" style="background:#18181b;border:1px solid #27272a;">
    <div class="card-body py-3">
        <form method="get" action="{{ path('app_events') }}" onsubmit="return false;">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="q" class="form-control" placeholder="Search..." value="{{ q|default('') }}" data-live-search="#event-table" data-live-search-filter-select="#event-search-category" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="event-search-category" class="form-select">
                        <option value="">All Categories</option>
                        <option value="1">Event Name</option>
                        <option value="2">Date</option>
                        <option value="3">Venue</option>
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <span class="badge bg-green-lt">Live Filter Active</span>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card" style="background:#18181b;border:1px solid #27272a;">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover mb-0" id="event-table">
            <thead>
            <tr>
                <th style="padding:.75rem 1.25rem;">ID</th>
                <th>Event Name</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Fights</th>
                <th>Status</th>
                {% if is_granted('ROLE_ADMIN') %}
                <th class="text-end" style="padding-right:1.25rem;">Actions</th>
                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for event in events %}
                <tr>
                    <td style="padding:.75rem 1.25rem;color:#a1a1aa;font-size:.8rem;">#{{ event.eventId }}</td>
                    <td style="font-size:.875rem;font-weight:600;">{{ event.eventName }}</td>
                    <td style="font-size:.8rem;color:#a1a1aa;">{{ event.eventDate ? event.eventDate|date('Y-m-d') : '-' }}</td>
                    <td>{{ event.venue|default('-') }}, {{ event.city|default('-') }}</td>
                    <td>
                        <span class="badge bg-secondary">{{ fightCounts[event.eventId] }} / 3</span>
                    </td>
                    <td>
                        {% if event.isUpcoming() %}
                            <span class="badge" style="background:rgba(34,197,94,.15);color:#22c55e;">UPCOMING</span>
                        {% else %}
                            <span class="badge" style="background:rgba(161,161,170,.15);color:#a1a1aa;">PAST</span>
                        {% endif %}
                    </td>
                    
                    <td class="text-end" style="padding-right:1.25rem;">
                        <a class="btn btn-sm" href="{{ path('app_event_fights', {'id': event.eventId}) }}" style="background:#27272a;color:#a1a1aa;border:none;" title="View Fights"><i class="fa-solid fa-list"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_event_edit', {'id': event.eventId}) }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;"><i class="fa-solid fa-pen"></i></a>
                        <form action="{{ path('app_event_delete', {'id': event.eventId}) }}" method="post" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this event?');">
                            <button type="submit" class="btn btn-sm" style="background:rgba(220,38,38,.15);color:#dc2626;border:none;"><i class="fa-solid fa-trash"></i></button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center" style="padding: 2rem;">No events found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
