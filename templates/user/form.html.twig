{% extends 'base.html.twig' %}

{% block title %}Register Admin — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_users') }}" style="color:#a1a1aa;text-decoration:none;">Users</a></li>
    <li class="breadcrumb-item active">Register</li>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-4" style="background:#18181b;border:1px solid #27272a;">
            <div class="card-header" style="background:#18181b;border-bottom:1px solid #27272a;">
                <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-user-shield me-2" style="color:#dc2626;"></i>Create New Administrator</h3>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Username <span style="color:#dc2626;">*</span></label>
                        <input type="text" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password <span style="color:#dc2626;">*</span></label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-danger w-100 py-2"><i class="fa-solid fa-check me-2"></i>Create Admin Account</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
