<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Oswald:wght@700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #09090b; margin: 0; padding: 0; color: #fafafa; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #09090b; padding-bottom: 40px; }
        .main { background-color: #18181b; margin: 0 auto; width: 100%; max-width: 600px; border-spacing: 0; border: 1px solid #27272a; border-radius: 12px; overflow: hidden; margin-top: 40px; }
        .header { background: #dc2626; padding: 30px; text-align: center; }
        .header h1 { font-family: 'Oswald', sans-serif; margin: 0; font-size: 24px; letter-spacing: 2px; color: #ffffff; text-transform: uppercase; }
        .content { padding: 40px; }
        .content h2 { color: #ffffff; font-size: 20px; margin-top: 0; }
        .content p { color: #a1a1aa; line-height: 1.6; font-size: 16px; }
        .button-container { text-align: center; padding: 20px 0; }
        .btn { background-color: #dc2626; color: #ffffff !important; padding: 15px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block; font-size: 16px; text-transform: uppercase; letter-spacing: 1px; }
        .footer { text-align: center; padding: 20px; color: #71717a; font-size: 12px; }
        .divider { border-top: 1px solid #27272a; margin: 30px 0; }
    </style>
</head>
<body>
    <div class="wrapper">
        <table class="main">
            <tr>
                <td class="header">
                    <h1>SMARTFIGHT</h1>
                </td>
            </tr>
            <tr>
                <td class="content">
                    <h2>Verify Your Account</h2>
                    <p>Hello {{ user.username }},</p>
                    <p>Welcome to the inner circle of boxing intelligence. You're one step away from accessing elite analytics and community matchmaking.</p>
                    <div class="button-container">
                        <a href="{{ verifyUrl }}" class="btn">Confirm Identity</a>
                    </div>
                    <p>If the button above doesn't work, please copy and paste the following link into your browser:</p>
                    <p style="word-break: break-all; color: #dc2626; font-size: 14px;">{{ verifyUrl }}</p>
                    <div class="divider"></div>
                    <p style="font-size: 14px;">If you did not create an account on SmartFight, please ignore this email.</p>
                </td>
            </tr>
        </table>
        <div class="footer">
            &copy; {{ "now"|date("Y") }} SmartFight Professional. Sanctioned Analytics & Performance.
        </div>
    </div>
</body>
</html>
