</script>

<script>
document.addEventListener("DOMContentLoaded", function() {

    const itemsPerPage = 6;
    const grid = document.querySelector('.fighter-grid');
    const allItems = Array.from(grid.querySelectorAll('.fighter-card-col'));
    const paginationContainer = document.getElementById('paginationControls');
    let currentPage = 1;
    let filteredItems = allItems;

    function renderPage(page) {
        const totalPages = Math.ceil(filteredItems.length / itemsPerPage) || 1;
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        currentPage = page;
        allItems.forEach(item => { item.style.display = 'none'; });
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        filteredItems.slice(start, end).forEach(item => { item.style.display = ''; });
        renderControls(totalPages);
    }

    function renderControls(totalPages) {
        paginationContainer.innerHTML = '';
        if (totalPages <= 1) { paginationContainer.style.display = 'none'; return; }
        else { paginationContainer.style.display = 'flex'; }

        const prevBtn = document.createElement('button');
        prevBtn.className = 'page-btn';
        prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
        prevBtn.disabled = currentPage === 1;
        prevBtn.addEventListener('click', () => renderPage(currentPage - 1));
        paginationContainer.appendChild(prevBtn);

        for (let i = 1; i <= totalPages; i++) {
            const pageBtn = document.createElement('button');
            pageBtn.className = 'page-btn ' + (i === currentPage ? 'active' : '');
            pageBtn.textContent = i;
            pageBtn.addEventListener('click', () => renderPage(i));
            paginationContainer.appendChild(pageBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.className = 'page-btn';
        nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.addEventListener('click', () => renderPage(currentPage + 1));
        paginationContainer.appendChild(nextBtn);

        const pageInfo = document.createElement('div');
        pageInfo.className = 'page-info';
        pageInfo.textContent = `Page ${currentPage} sur ${totalPages}`;
        paginationContainer.appendChild(pageInfo);
    }

    const filterCountry  = document.getElementById('filterCountry');
    const filterCategory = document.getElementById('filterCategory');
    const filterStyle    = document.getElementById('filterStyle');
    const filterWinRate  = document.getElementById('filterWinRate');
    const filterElo      = document.getElementById('filterElo');
    const winRateValue   = document.getElementById('winRateValue');
    const resetBtn       = document.getElementById('resetFilters');
    const searchInput    = document.getElementById('mainSearch');

    const countries = new Set();
    const categories = new Set();
    const styles = new Set();

    allItems.forEach(item => {
        const country  = item.querySelector('h3 span')?.getAttribute('title');
        const category = item.querySelector('.text-muted.small.fw-medium')?.textContent.replace(' Division', '').trim();
        const style    = item.querySelector('.badge-tactician')?.textContent.trim();
        if (country)  countries.add(country);
        if (category) categories.add(category);
        if (style)    styles.add(style);
    });

    [...countries].sort().forEach(c  => filterCountry.innerHTML  += `<option value="${c}">${c}</option>`);
    [...categories].sort().forEach(c => filterCategory.innerHTML += `<option value="${c}">${c}</option>`);
    [...styles].sort().forEach(s    => filterStyle.innerHTML    += `<option value="${s}">${s}</option>`);

    function applyFilters() {
        const countryVal  = filterCountry.value;
        const categoryVal = filterCategory.value;
        const styleVal    = filterStyle.value;
        const winRateVal  = parseInt(filterWinRate.value);
        const eloVal      = parseInt(filterElo.value) || 0;
        const searchTerm  = searchInput ? searchInput.value.toLowerCase() : '';

        filteredItems = allItems.filter(item => {
            const itemCountry  = item.querySelector('h3 span')?.getAttribute('title');
            const itemCategory = item.querySelector('.text-muted.small.fw-medium')?.textContent.replace(' Division', '').trim();
            const itemStyle    = item.querySelector('.badge-tactician')?.textContent.trim();
            const itemWinRate  = parseInt(item.querySelectorAll('.stat-value')[0].textContent);
            const itemElo      = parseInt(item.querySelectorAll('.stat-value')[1].textContent);
            const itemText     = item.textContent.toLowerCase();

            return (!countryVal  || itemCountry  === countryVal)
                && (!categoryVal || itemCategory === categoryVal)
                && (!styleVal    || itemStyle    === styleVal)
                && itemWinRate  >= winRateVal
                && itemElo      >= eloVal
                && (!searchTerm || itemText.includes(searchTerm));
        });

        const noResultsMsg = document.getElementById('noResultsMsg');
        if (filteredItems.length === 0) {
            if (!noResultsMsg) {
                const msg = document.createElement('div');
                msg.id = 'noResultsMsg';
                msg.className = 'no-results';
                msg.innerHTML = '<i class="fa-solid fa-face-frown fa-3x mb-3 d-block"></i>Aucun boxeur ne correspond aux filtres';
                grid.appendChild(msg);
            }
        } else if (noResultsMsg) {
            noResultsMsg.remove();
        }
        renderPage(1);
    }

    [filterCountry, filterCategory, filterStyle, filterWinRate, filterElo].forEach(el => {
        el.addEventListener('change', applyFilters);
        el.addEventListener('input', () => {
            if (el.id === 'filterWinRate') winRateValue.textContent = el.value;
            if (el.type === 'number' || el.type === 'range') applyFilters();
        });
    });

    if (searchInput) searchInput.addEventListener('keyup', applyFilters);

    resetBtn.addEventListener('click', () => {
        filterCountry.value  = '';
        filterCategory.value = '';
        filterStyle.value    = '';
        filterWinRate.value  = 0;
        winRateValue.textContent = 0;
        filterElo.value      = '';
        if (searchInput) searchInput.value = '';
        applyFilters();
    });

    renderPage(1);
});
</script>
