    doc.text("- Si combat maintenu : 73% de chance de rupture tendineuse", 25, 234);
    doc.text("- Perte financiere estimee : 2.4M$ si blessure confirmee", 25, 241);

    // Footer
    doc.setDrawColor(230, 57, 70);
    doc.setLineWidth(1.5);
    doc.line(20, 275, 190, 275);
    doc.setFontSize(9);
    doc.setFont("helvetica", "bold");
    doc.setTextColor(150, 150, 150);
    doc.text("CONFIDENTIEL - USAGE INTERNE SMARTFIGHT UNIQUEMENT", 105, 282, { align: "center" });

    // Save
    const safeName = fighterName.replace(/\s+/g, '_');
