    doc.text("4. PREDICTIVE ANALYSIS (AI BIOMECHANICS)", 20, 217);
    doc.setFontSize(11);
    doc.setTextColor(50, 50, 50);
    doc.setFont("helvetica", "normal");
    doc.text("- If recommendations followed: 96% chance to avoid severe injury", 25, 227);
    doc.text("- If fight proceeds: 73% chance of tendon rupture", 25, 234);
    doc.text("- Estimated financial loss: $2.4M if injury confirmed", 25, 241);

    // Footer
    doc.setDrawColor(230, 57, 70);
    doc.setLineWidth(1.5);
    doc.line(20, 275, 190, 275);
    doc.setFontSize(9);
    doc.setFont("helvetica", "bold");
    doc.setTextColor(150, 150, 150);
    doc.text("CONFIDENTIAL - FOR SMARTFIGHT INTERNAL USE ONLY", 105, 282, { align: "center" });

    // Save
    const safeName = fighterName.replace(/\s+/g, '_');
    const fileName = `Analyse_medicale_${safeName}_${dateStr.replace(/\//g, '_')}.pdf`;
    doc.save(fileName);
}
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {

    const pagination = new SmartPagination({
        containerSelector: '.fighter-grid',
        itemSelector: '.fighter-card-col',
        paginationContainerId: 'paginationControls',
        itemsPerPage: 6
    });

    // Initialize the global filter instance for this module
    window._fighterFilter = new AdvancedFilter('.fighter-grid', '.fighter-card-col', (visibleItems) => {
        pagination.setFilteredItems(visibleItems);
    });

    const filterCountry  = document.getElementById('filterCountry');
    const filterCategory = document.getElementById('filterCategory');
    const filterStyle    = document.getElementById('filterStyle');
    const filterWinRate  = document.getElementById('filterWinRate');
    const filterElo      = document.getElementById('filterElo');
    const winRateValue   = document.getElementById('winRateValue');
    const resetBtn       = document.getElementById('resetFilters');
    const searchInput    = document.getElementById('mainSearch');

    // Setup Custom Range Filtering
    window._fighterFilter.customFilter = (item) => {
        const minWinRate = parseInt(filterWinRate.value) || 0;
        const minElo     = parseInt(filterElo.value) || 0;
        
        const itemWinRate = parseInt(item.getAttribute('data-sort-winrate')) || 0;
        const itemElo     = parseInt(item.getAttribute('data-sort-elo')) || 0;
        
        return itemWinRate >= minWinRate && itemElo >= minElo;
    };

    // Populate filter selects
    const countries = new Set(), categories = new Set(), styles = new Set();
    window._fighterFilter.items.forEach(item => {
        const country = item.getAttribute('data-filter-country');
        const cat = item.getAttribute('data-filter-category');
        const style = item.getAttribute('data-filter-style');
        if (country) countries.add(country);
        if (cat) categories.add(cat);
        if (style) styles.add(style);
    });
    [...countries].sort().forEach(c => filterCountry.innerHTML += `<option value="${c}">${c}</option>`);
    [...categories].sort().forEach(c => filterCategory.innerHTML += `<option value="${c}">${c}</option>`);
    [...styles].sort().forEach(s => filterStyle.innerHTML += `<option value="${s}">${s}</option>`);

    // Event Listeners
    filterCountry.addEventListener('change', (e) => window._fighterFilter.filter('country', e.target.value));
    filterCategory.addEventListener('change', (e) => window._fighterFilter.filter('category', e.target.value));
    filterStyle.addEventListener('change', (e) => window._fighterFilter.filter('style', e.target.value));
    
    filterWinRate.addEventListener('input', (e) => {
        winRateValue.textContent = e.target.value;
        window._fighterFilter.apply();
    });
    
    filterElo.addEventListener('input', () => window._fighterFilter.apply());
    
    if (searchInput) {
        searchInput.addEventListener('input', (e) => window._fighterFilter.search(e.target.value));
    }

    resetBtn.addEventListener('click', () => {
        filterCountry.value = '';
        filterCategory.value = '';
        filterStyle.value = '';
        filterWinRate.value = 0;
        winRateValue.textContent = 0;
        filterElo.value = '';
        if (searchInput) searchInput.value = '';
        
        window._fighterFilter.activeFilters = {};
        window._fighterFilter.searchQuery = '';
        window._fighterFilter.apply();
    });

    pagination.init();
});
</script>
{% endblock %}
