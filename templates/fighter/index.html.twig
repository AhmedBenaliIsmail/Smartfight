<!-- jsPDF CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
function generateFighterHistoryText(name, country, category, record, coach, fighterId) {
    const opponents = [
        'Anthony Joshua', 'Tyson Fury', 'Oleksandr Usyk', 'Deontay Wilder',
        'Daniel Dubois', 'Joe Joyce', 'Otto Wallin', 'Filip Hrgovic',
        'Dillian Whyte', 'Carlos Takam', 'Luis Ortiz', 'Andy Ruiz Jr',
        'David Price', 'Derek Chisora', 'Joseph Parker', 'Tony Bellew',
        'Artur Beterbiev', 'Dmitry Bivol', 'Canelo Alvarez', 'Gennadiy Golovkin',
        'David Benavidez', 'Jermall Charlo', 'Sergiy Derevyanchenko'
    ];
    const methods = ['KO round 3', 'KO round 6', 'KO round 8', 'KO round 10', 'TKO round 5', 'TKO round 7', 'D&eacute;cision', 'D&eacute;cision unanime', 'D&eacute;cision partag&eacute;e'];
    const venues = ['Las Vegas', 'Londres', 'New York', 'Riyad', 'Paris', 'Abu Dhabi'];

    const seed = fighterId * 7;
    function random(seedOffset) {
        let x = Math.sin(seed + seedOffset) * 10000;
        return x - Math.floor(x);
    }
    
    let past = [];
    for(let i=0; i<3; i++) {
        let opp = opponents[Math.floor(random(i*10) * opponents.length)];
        if(opp === name) opp = opponents[(Math.floor(random(i*10)*opponents.length)+1)%opponents.length];
        let won = random(i*11) > 0.3; // 70% win rate
        let method = methods[Math.floor(random(i*12) * methods.length)];
        
        let daysAgo = Math.floor(random(i*13) * 600) + 30;
        let date = new Date(Date.now() - daysAgo * 24 * 60 * 60 * 1000);
        let dateStr = date.toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
        
        past.push({ opp, won, method, dateStr });
    }
    
    let upcoming = [];
    for(let i=0; i<2; i++) {
        let opp = opponents[Math.floor(random(i*20 + 50) * opponents.length)];
        if(opp === name) opp = opponents[(Math.floor(random(i*20+50)*opponents.length)+1)%opponents.length];
        let venue = venues[Math.floor(random(i*21 + 50) * venues.length)];
        
        let daysAhead = Math.floor(random(i*22 + 50) * 300) + 30;
        let date = new Date(Date.now() + daysAhead * 24 * 60 * 60 * 1000);
        let dateStr = date.toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', year: 'numeric'});
        
        upcoming.push({ opp, venue, dateStr });
    }

    // Decode HTML entities for plain text
    const doc = new DOMParser().parseFromString(category, "text/html");
    const cleanCategory = doc.documentElement.textContent;
    
    const decodeHtml = (html) => {
        const txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    };

    return `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
&#x1F94A; ${name.toUpperCase()} (${country})
${cleanCategory}
Record: ${record} | Coach: ${coach}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

&#x1F4DC; DERNIERS MATCHS :
├─ VS ${past[0].opp} (${past[0].dateStr}) \u2192 ${past[0].won ? '&#x2705; VICTOIRE' : '&#x274C; D&Eacute;FAITE'} (${decodeHtml(past[0].method)})
├─ VS ${past[1].opp} (${past[1].dateStr}) \u2192 ${past[1].won ? '&#x2705; VICTOIRE' : '&#x274C; D&Eacute;FAITE'} (${decodeHtml(past[1].method)})
└─ VS ${past[2].opp} (${past[2].dateStr}) \u2192 ${past[2].won ? '&#x2705; VICTOIRE' : '&#x274C; D&Eacute;FAITE'} (${decodeHtml(past[2].method)})

&#x1F4C5; PROCHAINS MATCHS :
├─ VS ${upcoming[0].opp} (${upcoming[0].dateStr}) - &#x1F4CD; ${upcoming[0].venue}
└─ VS ${upcoming[1].opp} (${upcoming[1].dateStr}) - &#x1F4CD; ${upcoming[1].venue}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`;
}

function showQrModal(name, country, category, record, coach, fighterId) {
    document.getElementById('qrModalTitle').textContent = `QR CODE - ${name}`;
    
    const rawText = generateFighterHistoryText(name, country, category, record, coach, fighterId);
    // Properly decode emojis/entities so they are sent as actual characters to the QR generator
    const decodedText = new DOMParser().parseFromString(rawText, "text/html").documentElement.textContent;
    const encodedText = encodeURIComponent(decodedText);
    
    const qrImage = document.getElementById('qrCodeImage');
    qrImage.src = `https://quickchart.io/qr?text=${encodedText}&size=300`;
    
    const modal = new bootstrap.Modal(document.getElementById('qrModal'));
    modal.show();
}

function showAnalystAlert() {
    const firstFighterEl = document.querySelector('.fighter-card-col:not([style*="display: none"]) .h4.text-white');
    let fighterName = 'Agit Kabayel';
    if (firstFighterEl) {
        fighterName = firstFighterEl.childNodes[0].textContent.trim();
    }
    generateMedicalReport(fighterName);
}

