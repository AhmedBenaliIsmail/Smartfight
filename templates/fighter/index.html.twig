{% extends 'front/base_front.html.twig' %}

{% block title %}SmartFight - Professional Roster{% endblock %}

{% block extra_css %}
    <style>
        .fighter-card-pro {
            background: #09090b;
            border: 1px solid rgba(220, 38, 38, 0.4);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
        }
        .fighter-card-pro:hover {
            border-color: #dc2626;
            box-shadow: 0 10px 40px rgba(220, 38, 38, 0.15);
            transform: translateY(-8px);
        }
        .fighter-photo-container {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            background: #18181b;
            border: 2px solid #27272a;
            position: relative;
            flex-shrink: 0;
            z-index: 1;
        }
        .fighter-photo-container:hover {
            z-index: 100;
        }
        .fighter-photo-container img {
            border-radius: 18px;
            position: relative;
            z-index: 10;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s ease, box-shadow 0.4s ease;
            transform-origin: center;
        }
        .fighter-photo-container:hover img {
            transform: scale(2);
            filter: brightness(1.1);
            box-shadow: 0 15px 35px rgba(0,0,0,0.8);
        }
        .status-dot {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 14px;
            height: 14px;
            background: #dc2626;
            border-radius: 50%;
            border: 3px solid #09090b;
        }
        .badge-tactician {
            background: rgba(37, 99, 235, 0.1);
            color: #3b82f6;
            border: 1px solid rgba(37, 99, 235, 0.3);
            padding: 4px 14px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .nickname-text {
            color: #ef4444;
            font-family: 'Oswald', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 2px;
        }
        .stat-group {
            text-align: center;
        }
        .stat-label {
            color: #71717a;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .stat-value {
            color: #fff;
            font-size: 1.75rem;
            font-weight: 800;
            font-family: 'Inter', sans-serif;
        }
        .division-standing-bar {
            height: 8px;
            background: #18181b;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 12px;
        }
        .standing-progress {
            height: 100%;
            background: #dc2626;
            border-radius: 10px;
        }
        .bottom-icon-group {
            color: #a1a1aa;
            font-size: 0.9rem;
            font-weight: 600;
        }
        .bottom-action-btn {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #18181b;
            color: #71717a;
            border: 1px solid #27272a;
            transition: all 0.2s;
            text-decoration: none !important;
        }
        .bottom-action-btn:hover {
            background: #27272a;
            color: #fafafa;
            transform: scale(1.05);
        }
        .btn-delete:hover {
            background: rgba(220, 38, 38, 0.1);
            color: #ef4444;
            border-color: #ef4444;
        }

        /* Coach Block */
        .coach-block {
            border-top: 1px dashed rgba(161, 161, 170, 0.2);
            padding-top: 12px;
        }
        .coach-text {
            font-size: 0.8rem;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
        }
        .coach-text span {
            color: #fafafa;
            font-weight: 700;
            letter-spacing: 0;
            text-transform: none;
        }
        
        /* Injury Analyst Card CSS */
        .injury-analyst-card {
            background: #0f0f1a;
            border: 1px solid #e63946;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(230, 57, 70, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            max-width: 500px;
            margin: 0 auto;
        }
        .injury-analyst-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, #e63946, #dc2626, #ef4444);
        }
        .injury-analyst-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(230, 57, 70, 0.15);
        }
        .badge-recommended {
            background: rgba(234, 179, 8, 0.15);
            color: #facc15;
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 1px;
            border: 1px solid rgba(234, 179, 8, 0.3);
        }
        .risk-label {
            color: #a1a1aa;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .risk-percent {
            font-weight: 800;
            font-size: 1.1rem;
        }
        .risk-bar-bg {
            height: 8px;
            background: #1a1a2e;
            border-radius: 10px;
            overflow: hidden;
        }
        .risk-bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease-in-out;
        }
        .prediction-box {
            background: #1a1a2e;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .pred-label {
            font-size: 0.7rem;
            color: #a1a1aa;
            margin-bottom: 5px;
            letter-spacing: 1px;
            font-weight: 700;
        }
        .pred-value {
            font-size: 0.95rem;
            font-weight: 800;
        }
        .recommendation-box {
            background: rgba(34, 197, 94, 0.1);
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 12px;
            padding: 1rem 1.5rem;
        }
        .rec-label {
            font-size: 0.7rem;
            color: #4ade80;
            letter-spacing: 1px;
            font-weight: 700;
        }
        .rec-text {
            color: #fff;
            font-weight: 600;
            font-size: 1.05rem;
        }
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            border-top: 1px dashed rgba(255, 255, 255, 0.1);
            padding-top: 1.5rem;
        }
        .metric-item {
            text-align: center;
        }
        .metric-val {
            color: #fff;
            font-size: 1.6rem;
            font-weight: 800;
            font-family: 'Inter', sans-serif;
            margin-bottom: 2px;
        }
        .metric-label {
            color: #71717a;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        .btn-analyst {
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.3s;
        }
        .btn-analyst:hover {
            background: #b91c1c;
            transform: scale(1.02);
            color: #fff;
        }
        
        .no-results {
            text-align: center;
            padding: 50px;
            color: #71717a;
            font-size: 1.2rem;
            width: 100%;
        }
        /* Filter Bar Styles */
        .filter-bar {
            background: #1e1e2e;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .filter-label {
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .filter-input, .filter-select {
            background: #2a2a3a;
            border: 1px solid #333;
            color: #fff;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
            width: 100%;
        }
        .filter-input:focus, .filter-select:focus {
            outline: none;
            border-color: #e63946;
        }
        /* Custom Slider Styling */
        .filter-range {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            background: #2a2a3a;
            border-radius: 5px;
            outline: none;
        }
        .filter-range::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            background: #e63946;
            cursor: pointer;
            border-radius: 50%;
        }
        .btn-reset {
            background: #2a2a3a;
            border: 1px solid #e63946;
            color: #fff;
            padding: 8px 20px;
            border-radius: 6px;
            font-weight: 600;
            transition: all 0.3s;
            height: fit-content;
            align-self: flex-end;
            cursor: pointer;
        }
        .btn-reset:hover {
            background: #e63946;
            color: #fff;
        }
        .no-results {
            text-align: center;
            padding: 50px;
            color: #71717a;
            font-size: 1.2rem;
            width: 100%;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="h2 fw-bold text-white mb-1" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">ORGANIZATION ROSTER</h1>
            <p class="text-muted mb-0">Managing professional combatant portfolios</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_fighter_new') }}" class="btn btn-danger px-4 fw-bold">
                <i class="fa-solid fa-plus me-2"></i>ADD BOXER
            </a>
        {% endif %}
    </div>
</div>

<!-- FILTERS BAR -->
<div class="filter-bar">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <div class="filter-group">
                <label class="filter-label">Search</label>
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" id="mainSearch" class="filter-input" style="padding-left: 2.5rem;" placeholder="Search for a fighter...">
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="filter-group">
                <label class="filter-label">Country</label>
                <select id="filterCountry" class="filter-select">
                    <option value="">All Countries</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="filter-group">
                <label class="filter-label">&#x1F3F7;&#xFE0F; Category</label>
                <select id="filterCategory" class="filter-select">
                    <option value="">All Categories</option>
                </select>
            </div>
        </div>
        <div class="col-md-1">
            <div class="filter-group">
                <label class="filter-label">Style</label>
                <select id="filterStyle" class="filter-select">
                    <option value="">All Styles</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="filter-group">
                <label class="filter-label">Win Rate Min: <span id="winRateValue">0</span>%</label>
                <input type="range" id="filterWinRate" class="filter-range" min="0" max="100" value="0">
            </div>
        </div>
        <div class="col-md-1">
            <div class="filter-group">
                <label class="filter-label">ELO Min</label>
                <input type="number" id="filterElo" class="filter-input" placeholder="ELO">
            </div>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button class="btn-reset w-100" title="Sort A-Z" onclick="window._fighterFilter.sort('name', 'string', 'asc')"><i class="fa-solid fa-arrow-down-a-z"></i></button>
            <button class="btn-reset w-100" title="Sort by ELO" onclick="window._fighterFilter.sort('elo', 'number', 'desc')"><i class="fa-solid fa-ranking-star"></i></button>
            <button class="btn-reset w-100" title="Sort by Win Rate" onclick="window._fighterFilter.sort('winrate', 'number', 'desc')"><i class="fa-solid fa-percent"></i></button>
            <button id="resetFilters" class="btn-reset w-100" title="Reset All Filters">
                <i class="fa-solid fa-rotate-left"></i>
            </button>
        </div>
    </div>
<div class="row g-4 fighter-grid">
    {% set known_coaches = {
        'Agit Kabayel': 'Ulli Wegner',
        'Anthony Joshua': 'Robert Garcia',
        'Artur Beterbiev': 'Marc Ramsay',
        'Caleb Plant': 'Stephen Edwards',
        'Canelo Alvarez': 'Eddy Reynoso',
        'Carlos Adames': 'Bob Santos',
        'Christian Mbilli': 'Marc Ramsay',
        'Daniel Dubois': 'Don Charles',
        'David Benavidez': 'Jose Benavidez Sr.'
    } %}
    {% set random_coaches = ['Freddie Roach', 'Emmanuel Steward', 'Teddy Atlas', 'Virgil Hunter', 'Buddy McGirt', 'Shane McGuigan', 'Derrick James', 'SugarHill Steward', "Cus D'Amato", 'Kevin Rooney', 'Angelo Dundee', 'Nacho Beristain'] %}

    {% set known_countries = {
        'Agit Kabayel': {code: 'DE', codeLower: 'de', name: 'Germany'},
        'Anthony Joshua': {code: 'GB', codeLower: 'gb', name: 'United Kingdom'},
        'Artur Beterbiev': {code: 'CA', codeLower: 'ca', name: 'Canada'},
        'Caleb Plant': {code: 'US', codeLower: 'us', name: 'United States'},
        'Canelo Alvarez': {code: 'MX', codeLower: 'mx', name: 'Mexico'},
        'Carlos Adames': {code: 'DO', codeLower: 'do', name: 'Dominican Republic'},
        'Christian Mbilli': {code: 'FR', codeLower: 'fr', name: 'France'},
        'Daniel Dubois': {code: 'GB', codeLower: 'gb', name: 'United Kingdom'},
        'David Benavidez': {code: 'US', codeLower: 'us', name: 'United States'}
    } %}

    {% set random_countries = [
        {code: 'US', codeLower: 'us', name: 'United States'},
        {code: 'GB', codeLower: 'gb', name: 'United Kingdom'},
        {code: 'MX', codeLower: 'mx', name: 'Mexico'},
        {code: 'PR', codeLower: 'pr', name: 'Puerto Rico'}
    ] %}

    {% for fighter in fighters %}
        {% set coach_name = known_coaches[fighter.fullName] ?? random_coaches[loop.index0 % random_coaches|length] %}
        {% set f_country = known_countries[fighter.fullName] ?? random_countries[loop.index0 % random_countries|length] %}
        {% set total_fights = fighter.wins + fighter.losses + fighter.draws %}
        {% set win_rate = total_fights > 0 ? (fighter.wins / total_fights * 100)|round : 0 %}
        {% set standing_percent = max(5, min(100, (fighter.eloRating / 2000 * 100))) %}
        
        <div class="col-lg-4 col-md-6 fighter-card-col"
             data-filter-country="{{ f_country.name }}"
             data-filter-category="{{ fighter.weightDivision ? fighter.weightDivision.name : 'Unassigned' }}"
             data-filter-style="{{ fighter.calculatedFightingStyle }}"
             data-sort-name="{{ fighter.fullName|lower }}"
             data-sort-elo="{{ fighter.eloRating }}"
             data-sort-winrate="{{ win_rate }}">
            <div class="fighter-card-pro">
                <div class="d-flex gap-4 mb-5">
                    <div class="fighter-photo-container">
                        {% if fighter.photoFilename %}
                            <img src="{{ asset('uploads/boxers/' ~ fighter.photoFilename) }}" class="w-100 h-100 object-fit-cover" alt="{{ fighter.fullName }}">
                        {% else %}
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-dark text-muted">
                                <i class="fa-solid fa-user fa-3x"></i>
                            </div>
                        {% endif %}
                        <div class="status-dot"></div>
                    </div>
                    <div class="pt-2">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <h3 class="h4 fw-bold text-white mb-0">
                                {{ fighter.fullName }}
                                <span title="{{ f_country.name }}" style="margin-left: 4px; cursor: help; display: inline-flex; align-items: center; gap: 4px;">
                                    <img src="https://flagcdn.com/24x18/{{ f_country.codeLower }}.png" width="24" height="18" alt="{{ f_country.name }}" style="border-radius: 2px;">
                                    <span style="font-size: 0.65rem; color: #a1a1aa;">{{ f_country.code }}</span>
                                </span>
                            </h3>
                            <span class="badge-tactician" style="color: #3b82f6; background: rgba(37, 99, 235, 0.1); border-color: rgba(37, 99, 235, 0.3);">
                                {{ fighter.calculatedFightingStyle }}
                            </span>
                        </div>
                        <div class="nickname-text">"{{ fighter.nickname|default('No Nickname') }}"</div>
                        <div class="text-muted small fw-medium">{{ fighter.weightDivision ? fighter.weightDivision.name : 'Unassigned' }} Division</div>
                    </div>
                </div>

                <div class="row mb-5">
                    <div class="col-4 stat-group">
                        <div class="stat-label">WIN RATE</div>
                        <div class="stat-value">{{ win_rate }}%</div>
                    </div>
                    <div class="col-4 stat-group">
                        <div class="stat-label">ELO SCORE</div>
                        <div class="stat-value">{{ fighter.eloRating|round }}</div>
                    </div>
                    <div class="col-4 stat-group">
                        <div class="stat-label">RECORD</div>
                        <div class="stat-value">{{ fighter.wins }}-{{ fighter.losses }}-{{ fighter.draws }}</div>
                    </div>
                </div>

                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-end mb-1">
                        <div class="stat-label mb-0" style="font-size: 0.8rem;">DIVISION STANDING</div>
                        <div class="text-white fw-bold">{{ fighter.eloRating|round }}/2000</div>
                    </div>
                    <div class="division-standing-bar">
                        <div class="standing-progress" style="width: {{ standing_percent }}%;"></div>
                    </div>
                </div>

                <div class="coach-block mb-4 mt-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="coach-text">&#x1F94A; Coach: <span>{{ coach_name }}</span></div>
                    </div>
                </div>



                <div class="pt-4 border-top border-secondary border-opacity-10 d-flex align-items-center justify-content-between">
                    <div class="d-flex gap-4 bottom-icon-group">
                        <span><i class="fa-solid fa-ruler-vertical me-2"></i>{{ fighter.height|default('--') }}cm</span>
                        <span><i class="fa-solid fa-arrows-left-right me-2"></i>{{ fighter.reach|default('--') }}cm</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="bottom-action-btn" title="Voir l'historique" style="color: #e63946; font-size: 1.3rem;" onclick="showQrModal('{{ fighter.fullName|escape('js') }}', '{{ f_country.name|escape('js') }}', '{{ fighter.weightDivision ? fighter.weightDivision.name|escape('js') : 'Unknown' }}', '{{ fighter.wins }}-{{ fighter.losses }}-{{ fighter.draws }}', '{{ coach_name|escape('js') }}', {{ fighter.fighterId }})">
                            <i class="fa-solid fa-clock"></i>
                        </button>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_fighter_edit', {'id': fighter.fighterId}) }}" class="bottom-action-btn" title="Edit Profile">
                                <i class="fa-solid fa-user-pen"></i>
                            </a>
                            <form method="post" action="{{ path('app_fighter_delete', {'id': fighter.fighterId}) }}" onsubmit="return confirm('Delete this profile?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fighter.fighterId) }}">
                                <button class="bottom-action-btn btn-delete" title="Delete Profile">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- QR Code Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="background-color: rgba(30, 30, 46, 0.95); border: 1px solid rgba(230, 57, 70, 0.3); border-radius: 15px;">
                <div class="modal-body text-center p-4">
                    <h5 class="text-white mb-3 fw-bold" id="qrModalTitle">QR CODE</h5>
                    <img id="qrCodeImage" src="" alt="QR Code" style="width: 200px; height: 200px; border-radius: 10px; background: white; padding: 10px; margin-bottom: 10px;">
                    <p class="text-muted small mb-3">Scan with your mobile device</p>
                    <button type="button" class="btn btn-danger w-100 fw-bold" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination Controls Container -->
    <div class="pagination-container" id="paginationControls">
        <!-- Javascript will populate this -->
    </div>

    <!-- INJURY PREDICTION ANALYST SECTION -->
    <div class="row justify-content-center mt-5 pt-4 mb-4">
        <div class="col-12">
            <div class="injury-analyst-card">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h3 class="h4 fw-bold text-white mb-1">
                            <i class="fa-solid fa-shield-halved me-2" style="color:#e63946;"></i>INJURY PREDICTION ANALYST
                        </h3>
                        <p class="text-muted mb-0">Dr. James Wong | PhD Biomechanics</p>
                    </div>
                    <span class="badge-recommended">&#11088;&#11088;&#11088;&#11088;&#11088; RECOMMENDED</span>
                </div>

                <div class="risk-section mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="risk-label">RISK LEVEL</span>
                        <span class="risk-percent text-success">12%</span>
                    </div>
                    <div class="risk-bar-bg">
                        <div class="risk-bar-fill bg-success" style="width: 12%;"></div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="prediction-box">
                            <div class="pred-label">PREDICTION</div>
                            <div class="pred-value text-warning">&#x1F4AA; RIGHT SHOULDER</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="prediction-box">
                            <div class="pred-label">ALERT</div>
                            <div class="pred-value text-danger">18 days</div>
                        </div>
                    </div>
                </div>

                <div class="recommendation-box mb-4">
                    <div class="rec-label mb-1">RECOMMENDATION</div>
                    <div class="rec-text">
                        <i class="fa-solid fa-circle-check me-2"></i>Shoulder rest + PT 2x/day
                    </div>
                </div>

                <div class="metrics-grid mb-4">
                    <div class="metric-item">
                        <div class="metric-val">96%</div>
                        <div class="metric-label">Accuracy</div>
                    </div>
                    <div class="metric-item">
                        <div class="metric-val">3</div>
                        <div class="metric-label">Weeks Early</div>
                    </div>
                    <div class="metric-item">
