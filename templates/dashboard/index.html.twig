{% extends 'base.html.twig' %}

{% block title %}Admin Command Center — SmartFight{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-action-card {
            background: linear-gradient(145deg, #18181b, #09090b);
            border: 1px solid #27272a;
            border-radius: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none !important;
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.25rem;
        }
        .admin-action-card:hover {
            border-color: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(220, 38, 38, 0.1);
        }
        .action-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .chart-container {
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 12px;
            padding: 1.5rem;
        }
        .stat-group {
            border-right: 1px solid #27272a;
        }
        .stat-group:last-child { border-right: none; }
    </style>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Admin Command Center</li>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <h1 class="h2 fw-bold text-white mb-1">COMMAND CENTER</h1>
            <p class="text-muted mb-0">System Overview & Management Tools</p>
        </div>
        <div class="text-end">
            <span class="badge bg-danger-lt px-3 py-2 rounded-pill">ADMIN SESSION ACTIVE</span>
        </div>
    </div>

    <!-- Quick Action Tiles -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <a href="{{ path('app_result_schedule') }}" class="admin-action-card">
                <div class="action-icon bg-danger-lt text-danger"><i class="fa-solid fa-calendar-plus"></i></div>
                <div>
                    <div class="fw-bold text-white">Schedule Fight</div>
                    <div class="small text-muted">Create a new bout</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('app_events') }}" class="admin-action-card">
                <div class="action-icon bg-blue-lt text-blue"><i class="fa-solid fa-trophy"></i></div>
                <div>
                    <div class="fw-bold text-white">Manage Events</div>
                    <div class="small text-muted">Edit show details</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('app_fighters') }}" class="admin-action-card">
                <div class="action-icon bg-green-lt text-green"><i class="fa-solid fa-users-gear"></i></div>
                <div>
                    <div class="fw-bold text-white">Boxer Roster</div>
                    <div class="small text-muted">Update fighter stats</div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('admin_blog_new') }}" class="admin-action-card">
                <div class="action-icon bg-yellow-lt text-yellow"><i class="fa-solid fa-pen-nib"></i></div>
                <div>
                    <div class="fw-bold text-white">Publish News</div>
                    <div class="small text-muted">Write a new article</div>
                </div>
            </a>
        </div>
    </div>
    
    <!-- Pro Organization Financial Overview -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="chart-container" style="background: linear-gradient(145deg, #18181b, #09090b); border: 1px solid rgba(22, 163, 74, 0.2); position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; right: 0; padding: 1rem; opacity: 0.1; font-size: 3rem; color: #16a34a;"><i class="fa-solid fa-money-bill-trend-up"></i></div>
                <div class="text-muted small fw-bold mb-1" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.65rem;">Total Ticket Revenue</div>
                <div class="h2 fw-bold text-white mb-1">${{ financials.revenue|number_format(2) }}</div>
                <div class="progress" style="height: 4px; background: rgba(22, 163, 74, 0.1);">
                    <div class="progress-bar bg-success" style="width: 100%;"></div>
                </div>
                <div class="mt-2 small text-success"><i class="fa-solid fa-caret-up me-1"></i>Live Sales Tracking</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="chart-container" style="background: linear-gradient(145deg, #18181b, #09090b); border: 1px solid rgba(220, 38, 38, 0.2); position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; right: 0; padding: 1rem; opacity: 0.1; font-size: 3rem; color: #dc2626;"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                <div class="text-muted small fw-bold mb-1" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.65rem;">Boxer Payouts</div>
                <div class="h2 fw-bold text-white mb-1">${{ financials.payouts|number_format(2) }}</div>
                <div class="progress" style="height: 4px; background: rgba(220, 38, 38, 0.1);">
                    <div class="progress-bar bg-danger" style="width: 100%;"></div>
                </div>
                <div class="mt-2 small text-danger"><i class="fa-solid fa-fist-raised me-1"></i>Contract Obligations</div>
            </div>
        </div>
        <div class="col-md-3">
            {% set profit = financials.revenue - financials.payouts %}
            <div class="chart-container" style="background: linear-gradient(145deg, #18181b, #09090b); border: 1px solid {{ profit >= 0 ? 'rgba(22, 163, 74, 0.4)' : 'rgba(220, 38, 38, 0.4)' }}; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                <div style="position: absolute; top: 0; right: 0; padding: 1rem; opacity: 0.1; font-size: 3rem; color: {{ profit >= 0 ? '#16a34a' : '#dc2626' }};"><i class="fa-solid {{ profit >= 0 ? 'fa-sack-dollar' : 'fa-circle-exclamation' }}"></i></div>
                <div class="text-muted small fw-bold mb-1" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.65rem;">Net Organization P/L</div>
                <div class="h2 fw-bold text-white mb-1">${{ profit|number_format(2) }}</div>
                <div class="progress" style="height: 4px; background: rgba(255, 255, 255, 0.05);">
                    <div class="progress-bar {{ profit >= 0 ? 'bg-success' : 'bg-danger' }}" style="width: 100%;"></div>
                </div>
                <div class="mt-2 small {{ profit >= 0 ? 'text-success' : 'text-danger' }}"><i class="fa-solid {{ profit >= 0 ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' }} me-1"></i>Operating Profit</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="chart-container" style="background: linear-gradient(145deg, #18181b, #09090b); border: 1px solid rgba(251, 191, 36, 0.2); position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; right: 0; padding: 1rem; opacity: 0.1; font-size: 3rem; color: #fbbf24;"><i class="fa-solid fa-clock-rotate-left"></i></div>
                <div class="text-muted small fw-bold mb-1" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.65rem;">Unpaid Purses</div>
                <div class="h2 fw-bold text-white mb-1">${{ financials.pending|number_format(2) }}</div>
                <div class="progress" style="height: 4px; background: rgba(251, 191, 36, 0.1);">
                    <div class="progress-bar bg-warning" style="width: 100%;"></div>
                </div>
                <div class="mt-2 small text-warning"><i class="fa-solid fa-hourglass-half me-1"></i>Awaiting Distribution</div>
            </div>
        </div>
    </div>

    <!-- Fan Favorite Center -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="chart-container" style="background: linear-gradient(145deg, #18181b, #0c0a09); border: 1px solid rgba(220, 38, 38, 0.3);">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h3 class="h4 mb-1 text-white fw-bold"><i class="fa-solid fa-fire-flame-curved me-2 text-danger"></i>FAN FAVORITE CENTER</h3>
                        <p class="text-muted small mb-0">The community has spoken. These are the most anticipated matchups.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_match_proposal_index') }}" class="btn btn-sm btn-outline-secondary px-3">
                            <i class="fa-solid fa-layer-group me-2"></i>Manage Voting Pool
                        </a>
                        <form method="post" action="{{ path('app_event_create_fan_favorite') }}" onsubmit="return confirm('This will create a new Event with the Top 3 voted fights and notify ALL fans. Proceed?');">
                            <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold">
                                <i class="fa-solid fa-wand-magic-sparkles me-2"></i>CREATE FAN EVENT
                            </button>
                        </form>
                    </div>
                </div>

                <div class="row g-3">
                    {% for proposal in topVoted %}
                        <div class="col-md-4">
                            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-danger-lt px-2">#{{ loop.index }} MOST WANTED</span>
                                    <div class="text-white fw-bold"><i class="fa-solid fa-thumbs-up text-danger me-1"></i> {{ proposal.voteCount }}</div>
                                </div>
                                <div class="text-center py-2">
                                    <div class="h5 fw-bold text-white mb-1">{{ proposal.fighter1.fullName }}</div>
                                    <div class="text-danger fw-bold my-1">VS</div>
                                    <div class="h5 fw-bold text-white mb-2">{{ proposal.fighter2.fullName }}</div>
                                    <div class="text-muted small">{{ proposal.weightDivision ? proposal.weightDivision.name : 'Unassigned' }} Division</div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12 text-center py-4 text-muted italic">
                            No match proposals found in the voting pool.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="chart-container h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h5 mb-0 text-white"><i class="fa-solid fa-chart-line me-2 text-danger"></i>Platform Revenue Growth</h3>
                    <div class="badge bg-dark border border-secondary text-muted">Last 7 Days</div>
                </div>
                <canvas id="revenueChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-container h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h5 mb-0 text-white"><i class="fa-solid fa-users me-2 text-primary"></i>User Growth</h3>
                </div>
                <canvas id="userChart" style="max-height: 300px;"></canvas>
                <div class="mt-4 pt-4 border-top border-secondary">
                    <div class="row text-center">
                        <div class="col-6 stat-group">
                            <div class="text-muted small uppercase">Total Fans</div>
                            <div class="fs-4 fw-bold text-white">{{ totalUsers }}</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small uppercase">Articles</div>
                            <div class="fs-4 fw-bold text-white">{{ totalArticles }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- System Pulse -->
        <div class="col-md-6">
            <div class="chart-container">
                <h3 class="h5 mb-4 text-white"><i class="fa-solid fa-bolt me-2 text-warning"></i>Recent Activity</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="border-0 text-muted small">EVENT / BOUT</th>
                                <th class="border-0 text-muted small">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for fight in recentResults %}
                            <tr>
                                <td class="border-0 py-3">
                                    <div class="fw-bold">{{ fight.fighter1.fullName }} vs {{ fight.fighter2.fullName }}</div>
                                    <div class="small text-muted">{{ fight.event.eventName }}</div>
                                </td>
                                <td class="border-0 py-3">
                                    <span class="badge {{ fight.status == 'COMPLETED' ? 'bg-success-lt' : 'bg-warning-lt' }}">
                                        {{ fight.status }}
                                    </span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-md-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="chart-container text-center">
                        <div class="text-danger fs-1 mb-2"><i class="fa-solid fa-mitten"></i></div>
                        <div class="h2 fw-bold text-white mb-0">{{ totalFighters }}</div>
                        <div class="text-muted small">Total Boxers</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="chart-container text-center">
                        <div class="text-blue fs-1 mb-2"><i class="fa-solid fa-calendar-check"></i></div>
                        <div class="h2 fw-bold text-white mb-0">{{ totalEvents }}</div>
                        <div class="text-muted small">Shows Hosted</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="chart-container text-center">
                        <div class="text-green fs-1 mb-2"><i class="fa-solid fa-gauge-high"></i></div>
                        <div class="h2 fw-bold text-white mb-0">99.9%</div>
                        <div class="text-muted small">System Uptime</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="chart-container text-center">
                        <div class="text-yellow fs-1 mb-2"><i class="fa-solid fa-shield-halved"></i></div>
                        <div class="h2 fw-bold text-white mb-0">Active</div>
                        <div class="text-muted small">Security Engine</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Revenue Chart
        new Chart(document.getElementById('revenueChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: {{ chartLabels|raw }},
                datasets: [{
                    label: 'Revenue ($)',
                    data: {{ revenueData|raw }},
                    borderColor: '#dc2626',
                    backgroundColor: 'rgba(220, 38, 38, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { grid: { color: '#27272a' }, ticks: { color: '#71717a' } },
                    x: { grid: { display: false }, ticks: { color: '#71717a' } }
                }
            }
        });

        // User Growth Chart
        new Chart(document.getElementById('userChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: {{ chartLabels|raw }},
                datasets: [{
                    label: 'New Users',
                    data: {{ userGrowth|raw }},
                    backgroundColor: '#3b82f6',
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: { grid: { display: false }, ticks: { color: '#71717a' } }
                }
            }
        });
    });
</script>
{% endblock %}
