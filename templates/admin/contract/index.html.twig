{% extends 'base.html.twig' %}

{% block title %}SmartFight Admin — Fighter Contracts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .page-header {
            background: linear-gradient(to right, #09090b, #18181b);
            padding: 2rem;
            border-radius: 16px;
            border: 1px solid #27272a;
            margin-bottom: 2rem;
        }
        .pro-table {
            background: #09090b;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #27272a;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .pro-table thead th {
            background: #111111;
            color: #71717a;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #27272a;
            font-weight: 700;
        }
        .pro-table tbody tr {
            background: transparent;
            border-bottom: 1px solid #18181b;
            transition: all 0.3s ease;
        }
        .pro-table tbody tr:hover {
            background: rgba(220, 38, 38, 0.03);
        }
        .pro-table td {
            color: #e5e7eb;
            padding: 1.25rem 1.5rem;
            vertical-align: middle;
        }
        .fighter-badge {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .fighter-photo-wrapper {
            position: relative;
            width: 50px;
            height: 50px;
        }
        .fighter-photo {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            object-fit: cover;
            border: 2px solid #27272a;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.5px;
        }
        .status-pending { background: #18181b; color: #71717a; border: 1px solid #27272a; }
        .status-ready { background: rgba(220, 38, 38, 0.1); color: #ef4444; border: 1px solid rgba(220, 38, 38, 0.2); }
        .status-paid { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
        
        .action-icon-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
            border: 1px solid transparent;
        }
        .btn-pay { background: #10b981; color: #fff; width: auto; padding: 0 15px; font-size: 0.75rem; font-weight: 700; border: none; }
        .btn-pay:hover { background: #059669; transform: translateY(-1px); }
        .btn-revoke { background: rgba(255, 255, 255, 0.05); color: #71717a; border: 1px solid transparent; }
        .btn-revoke:hover { background: #ef4444; color: #fff; }
    </style>
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Fighter Contracts</li>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="page-header d-flex align-items-center justify-content-between">
        <div>
            <h1 class="h2 text-white mb-1" style="font-family:'Oswald',sans-serif; letter-spacing:1px; text-transform:uppercase;">Fighter Contracts & Purses</h1>
            <p class="text-muted small mb-0">Centralized payroll management and fight agreement tracking.</p>
        </div>
        <div class="d-flex gap-3">
            <div class="input-icon" style="width: 300px;">
                <span class="input-icon-addon">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" class="form-control form-control-dark border-secondary" placeholder="Search by fighter or event..." data-live-search=".pro-table tbody" data-live-search-item="tr">
            </div>
            <button class="btn btn-danger d-flex align-items-center gap-2 px-4" data-bs-toggle="modal" data-bs-target="#createContractModal" style="font-weight:700;">
                <i class="fa-solid fa-plus-circle"></i> NEW CONTRACT
            </button>
        </div>
    </div>

    <div class="table-responsive pro-table">
        <table class="table table-borderless mb-0">
            <thead>
                <tr>
                    <th>FIGHTER</th>
                    <th>EVENT</th>
                    <th>BASE PAY</th>
                    <th>WIN BONUS</th>
                    <th>PAYOUT STATUS</th>
                    <th>TOTAL PAYOUT</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% for contract in contracts %}
                    <tr>
                        <td>
                            <div class="fighter-badge">
                                <div class="fighter-photo-wrapper">
                                    {% if contract.fighter.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ contract.fighter.photoFilename) }}" class="fighter-photo" alt="">
                                    {% else %}
                                        <div class="fighter-photo d-flex align-items-center justify-content-center bg-dark">
                                            <i class="fa-solid fa-user text-muted"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="fw-bold text-white">{{ contract.fighter.fullName }}</div>
                                    <div class="text-muted xsmall" style="font-size: 0.7rem;">{{ contract.fighter.weightDivision ? contract.fighter.weightDivision.name : 'Unknown' }} division</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="text-white fw-bold mb-0">{{ contract.event.eventName }}</div>
                            <div class="text-muted small">{{ contract.event.eventDate ? contract.event.eventDate|date('M d, Y') : 'TBA' }}</div>
                        </td>
                        <td>
                            <div class="text-success fw-bold">${{ contract.basePay|number_format(0) }}</div>
                            <div class="text-muted xsmall" style="font-size: 0.65rem;">GUARANTEED BASE</div>
                        </td>
                        <td>
                            <div class="text-warning fw-bold">+${{ contract.winBonus|number_format(0) }}</div>
                            <div class="text-muted xsmall" style="font-size: 0.65rem;">WIN INCENTIVE</div>
                        </td>
                        <td>
                            {% if contract.isPaid %}
                                <span class="status-badge status-paid"><i class="fa-solid fa-circle-check me-2"></i> PAID</span>
                            {% elseif contract.calculatedPayout is not null %}
                                <span class="status-badge status-ready"><i class="fa-solid fa-bolt me-2"></i> READY</span>
                            {% else %}
                                <span class="status-badge status-pending"><i class="fa-solid fa-clock me-2"></i> PENDING</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if contract.calculatedPayout is not null %}
                                <div class="text-white fw-black" style="font-size: 1.1rem;">${{ contract.calculatedPayout|number_format(0) }}</div>
                                <div class="text-muted xsmall" style="font-size: 0.65rem;">FINAL PURSE</div>
                            {% else %}
                                <span class="text-muted">---</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                                {% if not contract.isPaid and contract.calculatedPayout is not null %}
                                    <form method="post" action="{{ path('admin_contract_pay', {'id': contract.id}) }}">
                                        <button class="action-icon-btn btn-pay">PAY FIGHTER</button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('admin_contract_delete', {'id': contract.id}) }}" onsubmit="return confirm('Revoke this contract?');">
                                    <button class="action-icon-btn btn-revoke"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No active contracts found in the organization archives.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Create Contract Modal (Pro Edition) -->
<div class="modal fade" id="createContractModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" action="{{ path('admin_contract_create') }}" class="modal-content" style="background: #0f0f14; border: 1px solid rgba(220, 38, 38, 0.3); border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); overflow: hidden;">
            <div class="modal-header border-0 pb-0" style="padding: 1.5rem 1.5rem 0.5rem; background: #0f0f14;">
                <div>
                    <h5 class="modal-title text-white mb-0" style="font-family:'Oswald',sans-serif; font-size: 1.5rem; letter-spacing: 1.5px; text-transform: uppercase;">
                        <span style="color: #dc2626;">SIGN</span> FIGHTER CONTRACT
                    </h5>
                    <p class="text-muted small mb-0">Legalizing bout participation & purse details</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" style="opacity: 0.5;"></button>
            </div>
            
            <div class="modal-body" style="padding: 1.5rem;">
                <!-- Event Selection -->
                <div class="mb-4">
                    <label class="form-label d-flex align-items-center gap-2" style="color: #a1a1aa; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                        <i class="fa-solid fa-calendar-day text-danger"></i> Select Event
                    </label>
                    <div class="input-group">
                        <select name="event_id" id="eventSelect" class="form-select" style="background: #09090b; border: 1px solid #27272a; color: #fff; padding: 0.75rem 1rem; border-radius: 8px;" required>
                            <option value="">Choose organization event...</option>
                            {% for event in events %}
                            <option value="{{ event.eventId }}">{{ event.eventName }} ({{ event.eventDate|date('Y-m-d') }})</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <!-- Fighter Selection -->
                <div class="mb-4">
                    <label class="form-label d-flex align-items-center gap-2" style="color: #a1a1aa; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                        <i class="fa-solid fa-user-ninja text-danger"></i> Assign Fighter
                    </label>
                    <select name="fighter_id" id="fighterSelect" class="form-select" style="background: #09090b; border: 1px solid #27272a; color: #fff; padding: 0.75rem 1rem; border-radius: 8px;" required>
                        <option value="">Select an Event first...</option>
                    </select>
                </div>

                <!-- Financial Configuration -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label d-flex align-items-center gap-2" style="color: #a1a1aa; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                            <i class="fa-solid fa-money-bill-1 text-success"></i> Base Pay
                        </label>
                        <div class="input-group">
                            <span class="input-group-text" style="background: #27272a; border: 1px solid #27272a; color: #71717a;">$</span>
                            <input type="number" step="0.01" name="base_pay" class="form-control" style="background: #09090b; border: 1px solid #27272a; color: #fff;" required placeholder="0.00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label d-flex align-items-center gap-2" style="color: #a1a1aa; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">
                            <i class="fa-solid fa-trophy text-warning"></i> Win Bonus
                        </label>
                        <div class="input-group">
                            <span class="input-group-text" style="background: #27272a; border: 1px solid #27272a; color: #71717a;">$</span>
                            <input type="number" step="0.01" name="win_bonus" class="form-control" style="background: #09090b; border: 1px solid #27272a; color: #fff;" required placeholder="0.00">
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0" style="padding: 0.5rem 1.5rem 1.5rem;">
                <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger px-4 py-2" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); border: none; border-radius: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);">
                    Sign Contract
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const eventFighters = {{ eventFightersJson|raw }};
        const eventSelect = document.getElementById('eventSelect');
        const fighterSelect = document.getElementById('fighterSelect');

        eventSelect.addEventListener('change', function() {
            const eventId = this.value;
            fighterSelect.innerHTML = '<option value="">Select Fighter...</option>';
            
            if (eventId && eventFighters[eventId]) {
                const fighters = eventFighters[eventId];
                for (const [id, name] of Object.entries(fighters)) {
                    const opt = document.createElement('option');
                    opt.value = id;
                    opt.textContent = name;
                    fighterSelect.appendChild(opt);
                }
            } else if (!eventId) {
                fighterSelect.innerHTML = '<option value="">Select an Event first...</option>';
            } else {
                fighterSelect.innerHTML = '<option value="">No fighters found for this event</option>';
            }
        });
    </script>
{% endblock %}
