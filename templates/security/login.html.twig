<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - SmartFight Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/smartfight-admin.css') }}">
    <style>
        body { background: #09090b; display: flex; align-items: center; min-height: 100vh; overflow: hidden; }
        .login-card { background: #18181b; border: 1px solid #27272a; border-radius: 12px; max-width: 420px; margin: auto; padding: 2.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4); position: relative; z-index: 10; }
        .bg-element { position: absolute; border-radius: 50%; filter: blur(100px); z-index: 0; opacity: 0.15; }
        .bg-red { background: #dc2626; width: 600px; height: 600px; top: -200px; left: -200px; }
        .bg-gold { background: #c9a227; width: 500px; height: 500px; bottom: -100px; right: -100px; }
        .btn-google-pro {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background: #ffffff;
            color: #1f2937;
            font-weight: 600;
            padding: 0.75rem;
            border-radius: 8px;
            text-decoration: none;
            width: 100%;
            border: 1px solid #e5e7eb;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .btn-google-pro:hover {
            background: #f9fafb;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            color: #111827;
        }
    </style>
</head>
<body class="antialiased">

<div class="bg-element bg-red"></div>
<div class="bg-element bg-gold"></div>

<div class="container-tight py-4">
    <div class="login-card w-100">
        <div class="text-center mb-4">
            <a href="#" class="smartfight-logo justify-content-center mb-3">
                <div class="logo-icon fs-3"><i class="fa-solid fa-fist-raised"></i></div>
            </a>
            <h2 class="h2 text-center" style="color:#fafafa;">Login to Account</h2>
            <p class="text-muted mt-2">Enter your credentials to access the analytics portal</p>
        </div>
        
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        {% for msg in app.flashes('success') %}
            <div class="alert alert-success">{{ msg }}</div>
        {% endfor %}

        <form action="{{ path('app_login') }}" method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="_username" class="form-control" placeholder="Enter username" value="{{ last_username }}" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label">
                    Password
                    <span class="form-label-description">
                        <a href="{{ path('app_forgot_password') }}" class="text-muted text-decoration-none" style="font-size:0.75rem;">Forgot password?</a>
                    </span>
                </label>
                <div class="input-group input-group-flat">
                    <input type="password" name="_password" class="form-control" placeholder="Password" required>
                </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            
            <div class="form-footer">
                <button type="submit" class="btn btn-danger w-100 py-2 fs-5 fw-bold">Sign In</button>
            </div>

            <div class="hr-text" style="color: #52525b; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Or continue with</div>
            <div class="row g-2">
                <div class="col-6">
                    <button type="button" id="faceIdLoginBtn" class="btn w-100 py-2 btn-dark border-secondary">
                        <i class="fa-solid fa-fingerprint me-2 text-info"></i> Passkey
                    </button>
                </div>
                <div class="col-6">
                    <button type="button" id="btn-face-scan-toggle" class="btn w-100 py-2 btn-dark border-secondary disabled">
                        <i class="fa-solid fa-spinner fa-spin me-2 text-primary" id="ai-loader-icon"></i>
                        <span id="ai-loader-text">Loading AI...</span>
                    </button>
                </div>
                
                <div class="col-12">
                    <div id="login-camera-container" class="mt-3 d-none" style="position: relative;">
                        <video id="login-webcam" autoplay playsinline class="rounded-3 border border-primary w-100" style="transform: scaleX(-1);"></video>
                        <div class="scanner-line"></div>
                        <canvas id="login-canvas" class="d-none"></canvas>
                        <div class="mt-2">
                            <button type="button" id="btn-login-capture" class="btn btn-primary w-100 fw-bold">IDENTIFY & LOGIN</button>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <a href="{{ path('connect_google') }}" class="btn-google-pro">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            <path fill="none" d="M0 0h48v48H0z"/>
                        </svg>
                        <span>Sign in with Google</span>
                    </a>
                </div>
            </div>
        </form>
        
        <div class="text-center text-muted mt-4">
            Don't have account yet? <a href="{{ path('app_register') }}" class="text-gold text-decoration-none">Sign up</a>
        </div>
    </div>
</div>

<style>
    .scanner-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: rgba(0, 255, 255, 0.5);
        box-shadow: 0 0 15px #00ffff;
        animation: scan 2s linear infinite;
        z-index: 10;
    }
    @keyframes scan {
        0% { top: 0; }
        50% { top: 100%; }
        100% { top: 0; }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    // Background AI Warming (Preload models silently)
    const MODEL_URL = 'https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights';
    const loaderText = document.getElementById('ai-loader-text');
    const loaderIcon = document.getElementById('ai-loader-icon');
    const toggleBtn = document.getElementById('btn-face-scan-toggle');
    
    let modelsLoaded = false;

    // Load models silently to keep UI clean
    Promise.all([
        faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
        faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL)
    ]).then(() => {
        modelsLoaded = true;
        console.log('AI Models Armed');
        if (loaderIcon) {
            loaderIcon.classList.remove('fa-circle-notch', 'fa-spin');
            loaderIcon.classList.add('fa-face-viewfinder');
        }
    }).catch(err => {
        console.warn('AI Models failed to warm in background:', err);
    });

    // Ensure button is always enabled so user doesn't feel "stuck"
    if (toggleBtn) {
        toggleBtn.classList.remove('disabled');
        loaderText.innerText = 'Face ID';
    }

    const faceIdBtn = document.getElementById('faceIdLoginBtn');
    const toggleBtn = document.getElementById('btn-face-scan-toggle');
    const container = document.getElementById('login-camera-container');
    const video = document.getElementById('login-webcam');
    const canvas = document.getElementById('login-canvas');
    const captureBtn = document.getElementById('btn-login-capture');
    const usernameInput = document.querySelector('input[name="_username"]');

    // Hardware Passkey Logic
    if (faceIdBtn) {
        faceIdBtn.addEventListener('click', async () => {
            if (!window.PublicKeyCredential) {
                alert('WebAuthn is not supported.');
                return;
            }
            try {
                const challenge = new Uint8Array(32);
                window.crypto.getRandomValues(challenge);
                const assertion = await navigator.credentials.get({
                    publicKey: { challenge: challenge, timeout: 60000, userVerification: 'preferred' }
                });
                if (assertion) {
                    const credentialId = btoa(String.fromCharCode.apply(null, new Uint8Array(assertion.rawId)));
                    const response = await fetch('{{ path('app_face_id_login') }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ credentialId: credentialId })
                    });
                    const result = await response.json();
                    if (result.success) window.location.href = result.redirect;
                    else alert(result.error);
                }
            } catch (err) {
                alert('Passkey login failed.');
            }
        });
    }

    if (toggleBtn) {
        toggleBtn.addEventListener('click', async function() {
            if (!modelsLoaded) {
                const originalText = loaderText.innerText;
                loaderText.innerText = 'Warming up AI...';
                setTimeout(() => { if (!modelsLoaded) loaderText.innerText = originalText; }, 2000);
                if (!modelsLoaded) return;
            }
            
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                video.srcObject = stream;
                container.classList.remove('d-none');
                toggleBtn.classList.add('d-none');

                // Start AI Tracking
                video.addEventListener('play', () => {
                    const overlay = faceapi.createCanvasFromMedia(video);
                    overlay.style.position = 'absolute';
                    overlay.style.top = '0';
                    overlay.style.left = '0';
                    overlay.style.zIndex = '5';
                    container.append(overlay);
                    
                    const displaySize = { width: video.clientWidth, height: video.clientHeight };
                    faceapi.matchDimensions(overlay, displaySize);

                    setInterval(async () => {
                        // High-Speed Detection Optimization: inputSize 128 is much faster than default 416
                        const detections = await faceapi.detectAllFaces(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 128, scoreThreshold: 0.5 })).withFaceLandmarks();
                        const resizedDetections = faceapi.resizeResults(detections, displaySize);
                        overlay.getContext('2d').clearRect(0, 0, overlay.width, overlay.height);
                        
                        // Draw AI box and points
                        faceapi.draw.drawDetections(overlay, resizedDetections);
                        faceapi.draw.drawFaceLandmarks(overlay, resizedDetections);
                        
                        if (detections.length > 0) {
                            captureBtn.classList.remove('disabled');
                            captureBtn.innerHTML = 'IDENTIFY & LOGIN';
                        } else {
                            captureBtn.classList.add('disabled');
                            captureBtn.innerHTML = '<i class="fa-solid fa-hourglass-start me-2"></i>WAITING FOR FACE...';
                        }
                    }, 150); // Balanced interval for performance and battery
                });
                });

            } catch (err) {
                alert('Camera access denied.');
            }
        });
    }

    if (captureBtn) {
        captureBtn.addEventListener('click', async function() {
            if (this.classList.contains('disabled')) return;

            const context = canvas.getContext('2d');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            const photoData = canvas.toDataURL('image/jpeg', 0.8);
            const username = usernameInput.value.trim();
            
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>BIOMETRIC MATCHING...';
            this.disabled = true;

            try {
                const response = await fetch('{{ path('app_face_id_verify_visual') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: username, photo: photoData })
                });
                const result = await response.json();
                if (result.success) {
                    window.location.href = result.redirect;
                } else {
                    alert(result.error);
                    this.disabled = false;
                }
            } catch (err) {
                alert('Security server unreachable.');
                this.disabled = false;
            }
        });
    }
});
</script>
</body>
</html>
