<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reset Password - SmartFight</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/smartfight-admin.css') }}">
    <style>
        body { background: #09090b; display: flex; align-items: center; min-height: 100vh; overflow: hidden; }
        .login-card { background: #18181b; border: 1px solid #27272a; border-radius: 12px; max-width: 420px; margin: auto; padding: 2.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4); position: relative; z-index: 10; }
        .bg-element { position: absolute; border-radius: 50%; filter: blur(100px); z-index: 0; opacity: 0.15; }
        .bg-red { background: #dc2626; width: 600px; height: 600px; top: -200px; left: -200px; }
    </style>
</head>
<body class="antialiased">

<div class="bg-element bg-red"></div>

<div class="container-tight py-4">
    <div class="login-card w-100">
        <div class="text-center mb-4">
            <h2 class="h2 text-center" style="color:#fafafa;">Reset Password</h2>
            <p class="text-muted mt-2">Enter your new password below.</p>
        </div>
        
        {% for msg in app.flashes('error') %}
            <div class="alert alert-danger">{{ msg }}</div>
        {% endfor %}

        <form action="{{ path('app_reset_password', {token: token}) }}" method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="password" class="form-control" placeholder="Minimum 6 characters" required autofocus>
            </div>
            
            <div class="form-footer">
                <button type="submit" class="btn btn-danger w-100 py-2 fs-5 fw-bold">Update Password</button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
