<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reset Password - SmartFight</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/smartfight-admin.css') }}">
    <style>
        body { background: #09090b; display: flex; align-items: center; min-height: 100vh; overflow: hidden; }
        .login-card { background: #18181b; border: 1px solid #27272a; border-radius: 16px; max-width: 440px; margin: auto; padding: 2.5rem; box-shadow: 0 25px 60px rgba(0,0,0,0.5); position: relative; z-index: 10; }
        .bg-element { position: absolute; border-radius: 50%; filter: blur(120px); z-index: 0; opacity: 0.12; }
        .bg-red { background: #dc2626; width: 600px; height: 600px; top: -200px; left: -200px; }
        .bg-green { background: #22c55e; width: 350px; height: 350px; bottom: -100px; right: -100px; }
        .icon-circle { width: 56px; height: 56px; border-radius: 50%; background: rgba(34,197,94,0.1); border: 2px solid rgba(34,197,94,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
        .strength-bar { height: 4px; border-radius: 2px; background: #27272a; overflow: hidden; margin-top: .5rem; }
        .strength-fill { height: 100%; border-radius: 2px; transition: width 0.3s, background 0.3s; }
    </style>
</head>
<body class="antialiased">

<div class="bg-element bg-red"></div>
<div class="bg-element bg-green"></div>

<div class="container-tight py-4">
    <div class="login-card w-100">
        <div class="text-center mb-4">
            <div class="icon-circle">
                <i class="fa-solid fa-shield-halved fa-lg" style="color:#22c55e;"></i>
            </div>
            <h2 class="h3 fw-bold" style="color:#fafafa;">Create New Password</h2>
            <p class="text-muted mt-2" style="font-size:.85rem;">Choose a strong password to protect your account.</p>
        </div>
        
        {% for msg in app.flashes('error') %}
            <div class="alert alert-danger py-2" style="font-size:.85rem; border-radius:8px;">
                <i class="fa-solid fa-circle-exclamation me-1"></i>{{ msg }}
            </div>
        {% endfor %}

        <form action="{{ path('app_reset_password', {token: token}) }}" method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label" style="font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color:#a1a1aa;">New Password</label>
                <div class="input-group">
                    <span class="input-group-text" style="background:#09090b; border-color:#27272a; color:#71717a;">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input type="password" name="password" id="newPwd" class="form-control" placeholder="Minimum 6 characters" required autofocus minlength="6" style="background:#09090b; border-color:#27272a; color:#fafafa;">
                </div>
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <div class="small mt-1" id="strengthText" style="color:#71717a; font-size:.7rem;"></div>
            </div>

            <div class="mb-4">
                <label class="form-label" style="font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color:#a1a1aa;">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text" style="background:#09090b; border-color:#27272a; color:#71717a;">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input type="password" id="confirmPwd" class="form-control" placeholder="Re-enter password" required style="background:#09090b; border-color:#27272a; color:#fafafa;">
                </div>
                <div class="small mt-1" id="matchText" style="font-size:.7rem;"></div>
            </div>
            
            <div class="form-footer">
                <button type="submit" id="submitBtn" class="btn btn-danger w-100 py-2 fw-bold" style="font-size:.9rem; border-radius:8px;">
                    <i class="fa-solid fa-check-double me-2"></i>Update Password
                </button>
            </div>
        </form>
    </div>
</div>

<script>
const pwd = document.getElementById('newPwd');
const confirm = document.getElementById('confirmPwd');
const fill = document.getElementById('strengthFill');
const text = document.getElementById('strengthText');
const match = document.getElementById('matchText');
const btn = document.getElementById('submitBtn');

pwd.addEventListener('input', () => {
    const v = pwd.value;
    let s = 0;
    if (v.length >= 6) s++;
    if (v.length >= 10) s++;
    if (/[A-Z]/.test(v)) s++;
    if (/[0-9]/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    
    const pct = (s / 5) * 100;
    fill.style.width = pct + '%';
    fill.style.background = s <= 1 ? '#ef4444' : s <= 3 ? '#f59e0b' : '#22c55e';
    text.textContent = s <= 1 ? 'Weak' : s <= 3 ? 'Medium' : 'Strong';
    text.style.color = s <= 1 ? '#ef4444' : s <= 3 ? '#f59e0b' : '#22c55e';
    checkMatch();
});

confirm.addEventListener('input', checkMatch);

function checkMatch() {
    if (!confirm.value) { match.textContent = ''; return; }
    if (pwd.value === confirm.value) {
        match.textContent = '✓ Passwords match';
        match.style.color = '#22c55e';
        btn.disabled = false;
    } else {
        match.textContent = '✗ Passwords do not match';
        match.style.color = '#ef4444';
        btn.disabled = true;
    }
}
</script>

</body>
</html>
