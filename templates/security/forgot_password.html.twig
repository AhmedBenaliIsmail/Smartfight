<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot Password - SmartFight</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/smartfight-admin.css') }}">
    <style>
        body { background: #09090b; display: flex; align-items: center; min-height: 100vh; overflow: hidden; }
        .login-card { background: #18181b; border: 1px solid #27272a; border-radius: 16px; max-width: 440px; margin: auto; padding: 2.5rem; box-shadow: 0 25px 60px rgba(0,0,0,0.5); position: relative; z-index: 10; }
        .bg-element { position: absolute; border-radius: 50%; filter: blur(120px); z-index: 0; opacity: 0.12; }
        .bg-red { background: #dc2626; width: 600px; height: 600px; top: -200px; left: -200px; }
        .bg-blue { background: #3b82f6; width: 400px; height: 400px; bottom: -150px; right: -150px; }
        .icon-circle { width: 56px; height: 56px; border-radius: 50%; background: rgba(220,38,38,0.1); border: 2px solid rgba(220,38,38,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
    </style>
</head>
<body class="antialiased">

<div class="bg-element bg-red"></div>
<div class="bg-element bg-blue"></div>

<div class="container-tight py-4">
    <div class="login-card w-100">
        <div class="text-center mb-4">
            <div class="icon-circle">
                <i class="fa-solid fa-key fa-lg text-danger"></i>
            </div>
            <h2 class="h3 fw-bold" style="color:#fafafa;">Account Recovery</h2>
            <p class="text-muted mt-2" style="font-size:.85rem;">Enter your <strong>username</strong> or <strong>email</strong> to receive a password reset link.</p>
        </div>
        
        {% for msg in app.flashes('error') %}
            <div class="alert alert-danger py-2" style="font-size:.85rem; border-radius:8px;">
                <i class="fa-solid fa-circle-exclamation me-1"></i>{{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('success') %}
            <div class="alert alert-success py-2" style="font-size:.85rem; border-radius:8px; word-break:break-all;">
                <i class="fa-solid fa-circle-check me-1"></i>{{ msg }}
            </div>
        {% endfor %}

        <form action="{{ path('app_forgot_password') }}" method="post" autocomplete="off">
            <div class="mb-4">
                <label class="form-label" style="font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color:#a1a1aa;">Username or Email</label>
                <div class="input-group">
                    <span class="input-group-text" style="background:#09090b; border-color:#27272a; color:#71717a;">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <input type="text" name="email" class="form-control" placeholder="e.g. admin or user@gmail.com" required autofocus style="background:#09090b; border-color:#27272a; color:#fafafa;">
                </div>
            </div>
            
            <div class="form-footer">
                <button type="submit" class="btn btn-danger w-100 py-2 fw-bold" style="font-size:.9rem; border-radius:8px;">
                    <i class="fa-solid fa-paper-plane me-2"></i>Send Recovery Link
                </button>
            </div>
        </form>
        
        <div class="text-center mt-4" style="font-size:.85rem;">
            <span class="text-muted">Remember your password?</span>
            <a href="{{ path('app_login') }}" class="text-danger text-decoration-none fw-bold ms-1">Sign In</a>
        </div>
    </div>
</div>

</body>
</html>
