{% extends 'base.html.twig' %}

{% block title %}SmartFight Entry — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_stats') }}" style="color:#a1a1aa;text-decoration:none;">Statistics</a></li>
    <li class="breadcrumb-item active">SmartFight Entry</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Step 3: Professional Bouting Stats — Round {{ currentRound }}</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">{{ event.eventName|default('Unknown Event') }} — {{ fighter1.fullName }} vs {{ fighter2.fullName }}</p>
    </div>
    <a href="{{ path('app_stat_new', {'eventId': event.eventId}) }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;"><i class="fa-solid fa-arrow-left me-1"></i>Back to Card</a>
</div>

{# Round Selector #}
<div class="mb-4 d-flex flex-wrap gap-2 justify-content-center">
    {% for r in 1..totalRounds %}
        <a href="{{ path('app_stat_new', {'fightId': fight.resultId, 'round': r}) }}" 
           class="btn btn-sm rounded-pill px-3 {% if r == currentRound %}btn-danger{% else %}btn-outline-secondary{% endif %}"
           style="min-width: 80px;">
            Round {{ r }}
        </a>
    {% endfor %}
</div>

<form method="post" id="statsForm">
    <div class="row g-4">
        <!-- Boxer 1 (Red Corner) -->
        <div class="col-lg-6">
            <div class="card" style="background:#18181b;border:1px solid #ef4444; border-top-width: 4px;">
                <div class="card-header d-flex justify-content-between align-items-center" style="background:rgba(239, 68, 68, 0.05);border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-mitten me-2" style="color:#ef4444;"></i>{{ fighter1.fullName }} (Red)</h3>
                    <span class="badge bg-danger">Boxer 1</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Total Punches Thrown</label>
                            <input type="number" name="s1_punchesThrown" id="s1_punchesThrown" class="form-control" value="{{ stat1 ? stat1.punchesThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total Punches Landed</label>
                            <input type="number" name="s1_punchesLanded" id="s1_punchesLanded" class="form-control" value="{{ stat1 ? stat1.punchesLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Power Punches Thrown</label>
                            <input type="number" name="s1_powerPunchesThrown" id="s1_powerPunchesThrown" class="form-control" value="{{ stat1 ? stat1.powerPunchesThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Power Punches Landed</label>
                            <input type="number" name="s1_powerPunchesLanded" id="s1_powerPunchesLanded" class="form-control" value="{{ stat1 ? stat1.powerPunchesLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Jabs Thrown</label>
                            <input type="number" name="s1_jabsThrown" id="s1_jabsThrown" class="form-control" value="{{ stat1 ? stat1.jabsThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Jabs Landed</label>
                            <input type="number" name="s1_jabsLanded" id="s1_jabsLanded" class="form-control" value="{{ stat1 ? stat1.jabsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Uppercuts Thrown</label>
                            <input type="number" name="s1_uppercutsThrown" id="s1_uppercutsThrown" class="form-control" value="{{ stat1 ? stat1.uppercutsThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Uppercuts Landed</label>
                            <input type="number" name="s1_uppercutsLanded" id="s1_uppercutsLanded" class="form-control" value="{{ stat1 ? stat1.uppercutsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Right Hand Thrown</label>
                            <input type="number" name="s1_rightThrown" id="s1_rightThrown" class="form-control" value="{{ stat1 ? stat1.rightHandThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Right Hand Landed</label>
                            <input type="number" name="s1_rightLanded" id="s1_rightLanded" class="form-control" value="{{ stat1 ? stat1.rightHandLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Left Hand Thrown</label>
                            <input type="number" name="s1_leftThrown" id="s1_leftThrown" class="form-control" value="{{ stat1 ? stat1.leftHandThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Left Hand Landed</label>
                            <input type="number" name="s1_leftLanded" id="s1_leftLanded" class="form-control" value="{{ stat1 ? stat1.leftHandLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Body Shots Landed</label>
                            <input type="number" name="s1_bodyShotsLanded" id="s1_bodyShotsLanded" class="form-control" value="{{ stat1 ? stat1.bodyShotsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Knockdowns</label>
                            <input type="number" name="s1_knockdowns" id="s1_knockdowns" class="form-control" value="{{ stat1 ? stat1.knockdowns : 0 }}" min="0" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Boxer 2 (Blue Corner) -->
        <div class="col-lg-6">
            <div class="card" style="background:#18181b;border:1px solid #3b82f6; border-top-width: 4px;">
                <div class="card-header d-flex justify-content-between align-items-center" style="background:rgba(59, 130, 246, 0.05);border-bottom:1px solid #27272a;">
                    <h3 class="card-title mb-0" style="color:#fafafa;font-size:.9375rem;font-weight:600;"><i class="fa-solid fa-mitten me-2" style="color:#3b82f6;"></i>{{ fighter2.fullName }} (Blue)</h3>
                    <span class="badge bg-primary">Boxer 2</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Total Punches Thrown</label>
                            <input type="number" name="s2_punchesThrown" id="s2_punchesThrown" class="form-control" value="{{ stat2 ? stat2.punchesThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total Punches Landed</label>
                            <input type="number" name="s2_punchesLanded" id="s2_punchesLanded" class="form-control" value="{{ stat2 ? stat2.punchesLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Power Punches Thrown</label>
                            <input type="number" name="s2_powerPunchesThrown" id="s2_powerPunchesThrown" class="form-control" value="{{ stat2 ? stat2.powerPunchesThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Power Punches Landed</label>
                            <input type="number" name="s2_powerPunchesLanded" id="s2_powerPunchesLanded" class="form-control" value="{{ stat2 ? stat2.powerPunchesLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Jabs Thrown</label>
                            <input type="number" name="s2_jabsThrown" id="s2_jabsThrown" class="form-control" value="{{ stat2 ? stat2.jabsThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Jabs Landed</label>
                            <input type="number" name="s2_jabsLanded" id="s2_jabsLanded" class="form-control" value="{{ stat2 ? stat2.jabsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Uppercuts Thrown</label>
                            <input type="number" name="s2_uppercutsThrown" id="s2_uppercutsThrown" class="form-control" value="{{ stat2 ? stat2.uppercutsThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Uppercuts Landed</label>
                            <input type="number" name="s2_uppercutsLanded" id="s2_uppercutsLanded" class="form-control" value="{{ stat2 ? stat2.uppercutsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Right Hand Thrown</label>
                            <input type="number" name="s2_rightThrown" id="s2_rightThrown" class="form-control" value="{{ stat2 ? stat2.rightHandThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Right Hand Landed</label>
                            <input type="number" name="s2_rightLanded" id="s2_rightLanded" class="form-control" value="{{ stat2 ? stat2.rightHandLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Left Hand Thrown</label>
                            <input type="number" name="s2_leftThrown" id="s2_leftThrown" class="form-control" value="{{ stat2 ? stat2.leftHandThrown : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Left Hand Landed</label>
                            <input type="number" name="s2_leftLanded" id="s2_leftLanded" class="form-control" value="{{ stat2 ? stat2.leftHandLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Body Shots Landed</label>
                            <input type="number" name="s2_bodyShotsLanded" id="s2_bodyShotsLanded" class="form-control" value="{{ stat2 ? stat2.bodyShotsLanded : 0 }}" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Knockdowns</label>
                            <input type="number" name="s2_knockdowns" id="s2_knockdowns" class="form-control" value="{{ stat2 ? stat2.knockdowns : 0 }}" min="0" required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4">
            <div class="card" style="background:#18181b;border:1px solid #27272a;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 text-muted small"><i class="fa-solid fa-circle-info me-2"></i>SmartFight logic will analyze accuracy rates and power impact after saving.</p>
                    </div>
                    <button type="submit" class="btn btn-lg btn-danger px-5"><i class="fa-solid fa-floppy-disk me-2"></i>Save Round {{ currentRound }} Stats</button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
// Live validation: Landed cannot exceed Thrown
const validateStat = (landedId, thrownId, label) => {
    const landed = document.getElementById(landedId);
    const thrown = document.getElementById(thrownId);
    
    const sync = () => {
        const lVal = parseInt(landed.value) || 0;
        const tVal = parseInt(thrown.value) || 0;
        
        if (lVal > tVal) {
            landed.classList.add('is-invalid');
            landed.setCustomValidity(`${label}: Landed cannot exceed thrown.`);
        } else {
            landed.classList.remove('is-invalid');
            landed.setCustomValidity('');
        }
    };

    landed.addEventListener('input', sync);
    thrown.addEventListener('input', sync);
    sync(); 
};

validateStat('s1_punchesLanded', 's1_punchesThrown', 'B1 Punches');
validateStat('s1_powerPunchesLanded', 's1_powerPunchesThrown', 'B1 Power');
validateStat('s1_jabsLanded', 's1_jabsThrown', 'B1 Jabs');
validateStat('s1_uppercutsLanded', 's1_uppercutsThrown', 'B1 Uppercuts');
validateStat('s1_rightLanded', 's1_rightThrown', 'B1 Right Hand');
validateStat('s1_leftLanded', 's1_leftThrown', 'B1 Left Hand');

validateStat('s2_punchesLanded', 's2_punchesThrown', 'B2 Punches');
validateStat('s2_powerPunchesLanded', 's2_powerPunchesThrown', 'B2 Power');
validateStat('s2_jabsLanded', 's2_jabsThrown', 'B2 Jabs');
validateStat('s2_uppercutsLanded', 's2_uppercutsThrown', 'B2 Uppercuts');
validateStat('s2_rightLanded', 's2_rightThrown', 'B2 Right Hand');
validateStat('s2_leftLanded', 's2_leftThrown', 'B2 Left Hand');

// Strict logic: Left + Right must equal Total
const enforceTotalLogic = (prefix) => {
    const totalT = document.getElementById(prefix + '_punchesThrown');
    const totalL = document.getElementById(prefix + '_punchesLanded');
    const rightT = document.getElementById(prefix + '_rightThrown');
    const rightL = document.getElementById(prefix + '_rightLanded');
    const leftT = document.getElementById(prefix + '_leftThrown');
    const leftL = document.getElementById(prefix + '_leftLanded');

    const check = () => {
        const tt = parseInt(totalT.value) || 0;
        const tl = parseInt(totalL.value) || 0;
        const rt = parseInt(rightT.value) || 0;
        const rl = parseInt(rightL.value) || 0;
        const lt = parseInt(leftT.value) || 0;
        const ll = parseInt(leftL.value) || 0;

        if (rt + lt !== tt) {
            totalT.classList.add('is-invalid');
            totalT.setCustomValidity('Right + Left thrown must equal Total thrown');
        } else {
            totalT.classList.remove('is-invalid');
            totalT.setCustomValidity('');
        }

        if (rl + ll !== tl) {
            totalL.classList.add('is-invalid');
            totalL.setCustomValidity('Right + Left landed must equal Total landed');
        } else {
            totalL.classList.remove('is-invalid');
            totalL.setCustomValidity('');
        }
    };

    [totalT, totalL, rightT, rightL, leftT, leftL].forEach(el => el.addEventListener('input', check));
};

enforceTotalLogic('s1');
enforceTotalLogic('s2');
</script>

<style>
    .is-invalid {
        border-color: #dc3545 !important;
        background-image: none !important;
    }
</style>
{% endblock %}

