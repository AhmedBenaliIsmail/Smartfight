{% extends 'base.html.twig' %}
{% block title %}CompuBox Entry — Round {{ currentRound }}{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
:root { --red:#ef4444;--blue:#3b82f6;--gold:#f59e0b;--surface:#18181b;--border:#27272a;--muted:#71717a; }
.cb-card { background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden; }
.cb-red-top { border-top:3px solid var(--red); }
.cb-blue-top { border-top:3px solid var(--blue); }
.cb-header { padding:.75rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
.corner-tag { font-size:.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:.25rem .75rem;border-radius:20px; }
.red-tag { background:rgba(239,68,68,.15);color:var(--red); }
.blue-tag { background:rgba(59,130,246,.15);color:var(--blue); }
.stat-row { display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:1rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.04); }
.stat-row:last-child { border-bottom:none; }
.stat-label { font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:.3rem; }
.stat-input { background:#0c0c0e;border:1px solid var(--border);border-radius:6px;color:#fafafa;padding:.5rem .75rem;width:100%;font-size:.9rem;transition:border-color .2s; }
.stat-input:focus { outline:none;border-color:#52525b;box-shadow:0 0 0 2px rgba(255,255,255,.05); }
.stat-input.is-invalid { border-color:var(--red) !important;background:rgba(239,68,68,.05); }
.stat-input.is-ok { border-color:#22c55e; }
.stat-group-label { font-size:.65rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#3f3f46;padding:.5rem 1.25rem .25rem;display:flex;align-items:center;gap:.5rem; }
.stat-group-label::after { content:'';flex:1;height:1px;background:var(--border); }
.round-pill { display:inline-flex;align-items:center;justify-content:center;min-width:56px;height:32px;border-radius:20px;font-size:.78rem;font-weight:600;cursor:pointer;border:1px solid var(--border);color:var(--muted);background:transparent;text-decoration:none;transition:all .2s; }
.round-pill:hover { border-color:#52525b;color:#fafafa; }
.round-pill.active { background:var(--red);border-color:var(--red);color:#fff; }
.round-pill.has-data { border-color:#22c55e;color:#22c55e; }
.round-pill.active.has-data { background:#16a34a;border-color:#16a34a;color:#fff; }
.commentary-btn { background:rgba(124,58,237,.15);color:#a78bfa;border:1px solid #7c3aed;border-radius:6px;padding:.4rem 1rem;font-size:.75rem;font-weight:700;letter-spacing:.5px;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;transition:background .2s; }
.commentary-btn:hover { background:rgba(124,58,237,.28); }
.commentary-btn:disabled { opacity:.5;cursor:not-allowed; }
.commentary-textarea { background:#09090b;border:1px solid #3f3f46;color:#d4d4d8;border-radius:8px;padding:.875rem;font-size:.875rem;line-height:1.6;width:100%;resize:vertical; }
.save-btn { background:var(--red);color:#fff;border:none;border-radius:8px;padding:.6rem 2rem;font-size:.9rem;font-weight:600;cursor:pointer;transition:opacity .2s; }
.save-btn:hover { opacity:.85; }
.error-hint { font-size:.7rem;color:var(--red);margin-top:.2rem;display:none; }
.stat-input.is-invalid + .error-hint { display:block; }
</style>
{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none">Home</a></li>
<li class="breadcrumb-item"><a href="{{ path('app_stats') }}" style="color:#a1a1aa;text-decoration:none">Statistics</a></li>
<li class="breadcrumb-item active">CompuBox Entry</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-start justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#fafafa">CompuBox Statistics Entry</h1>
        <p class="mb-0" style="color:#71717a;font-size:.8rem">{{ event.eventName }} — <span style="color:#ef4444">{{ fighter1.fullName }}</span> vs <span style="color:#3b82f6">{{ fighter2.fullName }}</span></p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="button" id="aiGenerateStatsBtn" class="commentary-btn">
            <i class="fa-solid fa-wand-magic-sparkles"></i>GENERATE STATS
        </button>
        <a href="{{ path('app_stat_new', {eventId: event.eventId}) }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;font-size:.8rem"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
    </div>
</div>

{# Round Selector #}
<div class="mb-4 d-flex flex-wrap gap-2">
    {% for r in 1..totalRounds %}
        <a href="{{ path('app_stat_new', {fightId: fight.resultId, round: r}) }}"
           class="round-pill {% if r == currentRound %}active{% endif %}">
            R{{ r }}
        </a>
    {% endfor %}
</div>

<form method="post" id="statsForm" novalidate>
<div class="row g-3">

    {# ─── RED CORNER ─── #}
    <div class="col-lg-6">
        <div class="cb-card cb-red-top">
            <div class="cb-header">
                <span style="color:#fafafa;font-size:.9rem;font-weight:600">{{ fighter1.fullName }}</span>
                <span class="corner-tag red-tag">Red Corner</span>
            </div>

            <div class="stat-group-label">Total Punches</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Punches Thrown</div>
                    <input type="number" name="s1_punchesThrown" id="s1_pt" class="stat-input" value="{{ stat1 ? stat1.punchesThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Punches Landed</div>
                    <input type="number" name="s1_punchesLanded" id="s1_pl" class="stat-input" value="{{ stat1 ? stat1.punchesLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Right Hand</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Right Thrown</div>
                    <input type="number" name="s1_rightThrown" id="s1_rt" class="stat-input" value="{{ stat1 ? stat1.rightHandThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Right Landed</div>
                    <input type="number" name="s1_rightLanded" id="s1_rl" class="stat-input" value="{{ stat1 ? stat1.rightHandLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Left Hand</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Left Thrown</div>
                    <input type="number" name="s1_leftThrown" id="s1_lt" class="stat-input" value="{{ stat1 ? stat1.leftHandThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Left Landed</div>
                    <input type="number" name="s1_leftLanded" id="s1_ll" class="stat-input" value="{{ stat1 ? stat1.leftHandLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Power & Jabs</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Power Thrown</div>
                    <input type="number" name="s1_powerPunchesThrown" id="s1_pwt" class="stat-input" value="{{ stat1 ? stat1.powerPunchesThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Power Landed</div>
                    <input type="number" name="s1_powerPunchesLanded" id="s1_pwl" class="stat-input" value="{{ stat1 ? stat1.powerPunchesLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Jabs Thrown</div>
                    <input type="number" name="s1_jabsThrown" id="s1_jt" class="stat-input" value="{{ stat1 ? stat1.jabsThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Jabs Landed</div>
                    <input type="number" name="s1_jabsLanded" id="s1_jl" class="stat-input" value="{{ stat1 ? stat1.jabsLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Uppercuts & Body</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Uppercuts Thrown</div>
                    <input type="number" name="s1_uppercutsThrown" id="s1_ut" class="stat-input" value="{{ stat1 ? stat1.uppercutsThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Uppercuts Landed</div>
                    <input type="number" name="s1_uppercutsLanded" id="s1_ul" class="stat-input" value="{{ stat1 ? stat1.uppercutsLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Body Shots Landed</div>
                    <input type="number" name="s1_bodyShotsLanded" id="s1_bs" class="stat-input" value="{{ stat1 ? stat1.bodyShotsLanded : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Knockdowns</div>
                    <input type="number" name="s1_knockdowns" id="s1_kd" class="stat-input" value="{{ stat1 ? stat1.knockdowns : 0 }}" min="0" max="3">
                </div>
            </div>
        </div>
    </div>

    {# ─── BLUE CORNER ─── #}
    <div class="col-lg-6">
        <div class="cb-card cb-blue-top">
            <div class="cb-header">
                <span style="color:#fafafa;font-size:.9rem;font-weight:600">{{ fighter2.fullName }}</span>
                <span class="corner-tag blue-tag">Blue Corner</span>
            </div>

            <div class="stat-group-label">Total Punches</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Punches Thrown</div>
                    <input type="number" name="s2_punchesThrown" id="s2_pt" class="stat-input" value="{{ stat2 ? stat2.punchesThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Punches Landed</div>
                    <input type="number" name="s2_punchesLanded" id="s2_pl" class="stat-input" value="{{ stat2 ? stat2.punchesLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Right Hand</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Right Thrown</div>
                    <input type="number" name="s2_rightThrown" id="s2_rt" class="stat-input" value="{{ stat2 ? stat2.rightHandThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Right Landed</div>
                    <input type="number" name="s2_rightLanded" id="s2_rl" class="stat-input" value="{{ stat2 ? stat2.rightHandLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Left Hand</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Left Thrown</div>
                    <input type="number" name="s2_leftThrown" id="s2_lt" class="stat-input" value="{{ stat2 ? stat2.leftHandThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Left Landed</div>
                    <input type="number" name="s2_leftLanded" id="s2_ll" class="stat-input" value="{{ stat2 ? stat2.leftHandLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Power & Jabs</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Power Thrown</div>
                    <input type="number" name="s2_powerPunchesThrown" id="s2_pwt" class="stat-input" value="{{ stat2 ? stat2.powerPunchesThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Power Landed</div>
                    <input type="number" name="s2_powerPunchesLanded" id="s2_pwl" class="stat-input" value="{{ stat2 ? stat2.powerPunchesLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Jabs Thrown</div>
                    <input type="number" name="s2_jabsThrown" id="s2_jt" class="stat-input" value="{{ stat2 ? stat2.jabsThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Jabs Landed</div>
                    <input type="number" name="s2_jabsLanded" id="s2_jl" class="stat-input" value="{{ stat2 ? stat2.jabsLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>

            <div class="stat-group-label">Uppercuts & Body</div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Uppercuts Thrown</div>
                    <input type="number" name="s2_uppercutsThrown" id="s2_ut" class="stat-input" value="{{ stat2 ? stat2.uppercutsThrown : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Uppercuts Landed</div>
                    <input type="number" name="s2_uppercutsLanded" id="s2_ul" class="stat-input" value="{{ stat2 ? stat2.uppercutsLanded : 0 }}" min="0">
                    <div class="error-hint">Cannot exceed thrown</div>
                </div>
            </div>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Body Shots Landed</div>
                    <input type="number" name="s2_bodyShotsLanded" id="s2_bs" class="stat-input" value="{{ stat2 ? stat2.bodyShotsLanded : 0 }}" min="0">
                </div>
                <div>
                    <div class="stat-label">Knockdowns</div>
                    <input type="number" name="s2_knockdowns" id="s2_kd" class="stat-input" value="{{ stat2 ? stat2.knockdowns : 0 }}" min="0" max="3">
                </div>
            </div>
        </div>
    </div>

    {# ─── PER-ROUND COMMENTARY ─── #}
    <div class="col-12">
        <div class="cb-card" style="padding:1rem 1.25rem">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:.65rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#a1a1aa"><i class="fa-solid fa-microphone-lines me-2"></i>Round {{ currentRound }} Commentary</span>
                <button type="button" id="commentaryGenerateBtn" class="commentary-btn">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>GENERATE
                </button>
            </div>
            <textarea name="roundCommentary" id="roundCommentaryTextarea" class="commentary-textarea" rows="3"
                      placeholder="Click GENERATE for broadcast-style commentary, or type manually...">{{ roundCommentary ?? '' }}</textarea>
        </div>
    </div>

    {# ─── ACTIONS ─── #}
    <div class="col-12">
        <div class="cb-card">
            <div style="padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
                <p class="mb-0" style="color:#52525b;font-size:.78rem"><i class="fa-solid fa-circle-info me-1"></i>Right + Left Thrown must equal Total Thrown. Same rule applies for Landed.</p>
                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="save-btn">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Save Round {{ currentRound }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
</form>

<script>
// ── helpers ──────────────────────────────────────────────
const $ = id => document.getElementById(id);
const val = id => parseInt($(id)?.value) || 0;
const set = (id, v) => { if ($(id)) $(id).value = v; };

function markInvalid(id, msg) {
    const el = $(id); if (!el) return;
    el.classList.add('is-invalid'); el.classList.remove('is-ok');
    el.setCustomValidity(msg);
    const hint = el.nextElementSibling;
    if (hint && hint.classList.contains('error-hint')) { hint.textContent = msg; hint.style.display = 'block'; }
}
function markOk(id) {
    const el = $(id); if (!el) return;
    el.classList.remove('is-invalid'); el.classList.add('is-ok');
    el.setCustomValidity('');
    const hint = el.nextElementSibling;
    if (hint && hint.classList.contains('error-hint')) hint.style.display = 'none';
}

// ── per-boxer validation ──────────────────────────────────
function validate(p) {
    const pt=val(p+'_pt'), pl=val(p+'_pl');
    const rt=val(p+'_rt'), rl=val(p+'_rl');
    const lt=val(p+'_lt'), ll=val(p+'_ll');
    const pwt=val(p+'_pwt'), pwl=val(p+'_pwl');
    const jt=val(p+'_jt'), jl=val(p+'_jl');
    const ut=val(p+'_ut'), ul=val(p+'_ul');

    // landed ≤ thrown
    pl > pt ? markInvalid(p+'_pl','Landed > Thrown') : markOk(p+'_pl');
    rl > rt ? markInvalid(p+'_rl','Landed > Thrown') : markOk(p+'_rl');
    ll > lt ? markInvalid(p+'_ll','Landed > Thrown') : markOk(p+'_ll');
    pwl > pwt ? markInvalid(p+'_pwl','Landed > Thrown') : markOk(p+'_pwl');
    jl > jt ? markInvalid(p+'_jl','Landed > Thrown') : markOk(p+'_jl');
    ul > ut ? markInvalid(p+'_ul','Landed > Thrown') : markOk(p+'_ul');

    // right + left = total
    if (rt + lt !== pt) {
        markInvalid(p+'_pt', `Right(${rt}) + Left(${lt}) = ${rt+lt} ≠ Total(${pt})`);
    } else { markOk(p+'_pt'); }
    if (rl + ll !== pl) {
        markInvalid(p+'_pl', `Right(${rl}) + Left(${ll}) = ${rl+ll} ≠ Total(${pl})`);
    } else if (pl <= pt) { markOk(p+'_pl'); }
}

['s1','s2'].forEach(p => {
    ['_pt','_pl','_rt','_rl','_lt','_ll','_pwt','_pwl','_jt','_jl','_ut','_ul'].forEach(s => {
        const el = $(p+s); if(el) el.addEventListener('input', ()=>validate(p));
    });
    validate(p);
});

// ── AI Generate Stats ─────────────────────────────────────
document.getElementById('aiGenerateStatsBtn').addEventListener('click', async function() {
    const btn = this;
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> GENERATING...';

    try {
        const res = await fetch('{{ path("app_result_generate_ai_stats", {"id": fight.resultId}) }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ totalRounds: {{ currentRound }} })
        });
        const data = await res.json();
        if (data.success) {
            const r = data.rounds[{{ currentRound }}];
            if (r) {
                set('s1_pt',  r.f1.punches_thrown);
                set('s1_pl',  r.f1.punches_landed);
                set('s1_rt',  r.f1.right_thrown);
                set('s1_rl',  r.f1.right_landed);
                set('s1_lt',  r.f1.left_thrown);
                set('s1_ll',  r.f1.left_landed);
                set('s1_pwt', r.f1.power_thrown);
                set('s1_pwl', r.f1.power_landed);
                set('s1_jt',  r.f1.jabs_thrown);
                set('s1_jl',  r.f1.jabs_landed);
                set('s1_bs',  r.f1.body_shots);
                set('s1_kd',  r.f1.kds);

                set('s2_pt',  r.f2.punches_thrown);
                set('s2_pl',  r.f2.punches_landed);
                set('s2_rt',  r.f2.right_thrown);
                set('s2_rl',  r.f2.right_landed);
                set('s2_lt',  r.f2.left_thrown);
                set('s2_ll',  r.f2.left_landed);
                set('s2_pwt', r.f2.power_thrown);
                set('s2_pwl', r.f2.power_landed);
                set('s2_jt',  r.f2.jabs_thrown);
                set('s2_jl',  r.f2.jabs_landed);
                set('s2_bs',  r.f2.body_shots);
                set('s2_kd',  r.f2.kds);

                validate('s1'); validate('s2');
            }
        }
    } catch (err) {
        alert('Error generating stats: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
    }
});

// ── Per-round commentary generator ───────────────────────
function collectCornerStats(prefix) {
    return {
        landed:       val(prefix+'_pl'),
        thrown:       val(prefix+'_pt'),
        right_landed: val(prefix+'_rl'),
        right_thrown: val(prefix+'_rt'),
        left_landed:  val(prefix+'_ll'),
        left_thrown:  val(prefix+'_lt'),
        power_landed: val(prefix+'_pwl'),
        power_thrown: val(prefix+'_pwt'),
        jabs_landed:  val(prefix+'_jl'),
        body_shots:   val(prefix+'_bs'),
        kds:          val(prefix+'_kd')
    };
}

document.getElementById('commentaryGenerateBtn').addEventListener('click', async function() {
    const btn = this;
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> GENERATING...';

    try {
        const res = await fetch('{{ path("app_result_generate_round_commentary", {"id": fight.resultId}) }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                round: {{ currentRound }},
                f1: collectCornerStats('s1'),
                f2: collectCornerStats('s2')
            })
        });
        const data = await res.json();
        if (data.success) document.getElementById('roundCommentaryTextarea').value = data.commentary;
    } catch (err) {
        alert('Error generating commentary: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
    }
});

// ── prevent submit if invalid ─────────────────────────────
document.getElementById('statsForm').addEventListener('submit', function(e) {
    validate('s1'); validate('s2');
    if (document.querySelector('.stat-input.is-invalid')) {
        e.preventDefault();
        alert('Please fix validation errors before saving.');
    }
});
</script>
{% endblock %}
