{% extends 'front/base_front.html.twig' %}

{% block title %}Select Event — SmartFight Statistics{% endblock %}

{% block content %}
<div class="sf-broadcast-container py-5">
    <div class="container mb-5">
        <div class="header-console">
            <div class="path-indicator mb-2">
                <span class="active">EVENT</span>
                <span class="sep">/</span>
                <span>BOUT</span>
                <span class="sep">/</span>
                <span>ANALYTICS</span>
            </div>
            <h1 class="display-4 fw-bold text-white mb-2" style="font-family: 'Oswald', sans-serif; letter-spacing: 3px;">PHASE 1: BATTLEGROUND SELECTION</h1>
            <p class="text-muted fs-5">Identify the event to unlock specific performance intelligence and tactical logs.</p>
        </div>

        {# Search bar #}
        <div class="mt-5" style="max-width: 600px;">
            <div class="input-group input-group-flat shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2);">
                <span class="input-group-text bg-transparent border-0 px-4">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" id="eventSearchInput" class="form-control bg-transparent border-0 text-white ps-0 py-3" placeholder="FILTER BY EVENT NAME, VENUE, OR CITY..." style="letter-spacing: 1px; font-weight: 700; font-size: 0.8rem;">
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row g-4 justify-content-center" id="eventGrid">
            {% for event in events %}
            <div class="col-lg-4 col-md-6 event-card-item" data-search="{{ event.eventName|lower }} {{ event.venue|lower }} {{ event.city|lower }}">
                <a href="{{ path('app_stat_selection', {'eventId': event.eventId}) }}" class="sf-event-panel">
                    <div class="panel-bg"></div>
                    <div class="panel-content">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="event-id">KO-{{ event.eventId + 1000 }}</div>
                            <div class="status-tag">FINALIZED</div>
                        </div>
                        
                        <h3 class="event-title">{{ event.eventName|upper }}</h3>
                        
                        <div class="event-details mb-4">
                            <div class="detail-item">
                                <i class="fa-solid fa-calendar"></i>
                                <span>{{ event.eventDate|date('D, M d, Y') }}</span>
                            </div>
                            <div class="detail-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>{{ event.venue }}, {{ event.city }}</span>
                            </div>
                        </div>

                        <div class="panel-action">
                            <span>INITIALIZE DECRYPT</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="panel-border-glow"></div>
                </a>
            </div>
            {% else %}
            <div class="col-12 text-center py-5">
                <div class="empty-state-console">
                    <i class="fa-solid fa-database-slash mb-4"></i>
                    <h2>NO ARCHIVED EVENTS</h2>
                    <p>Statistical intelligence is only available for bouts that have reached their conclusion.</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
.sf-broadcast-container { min-vh: 100vh; }

.header-console { border-left: 4px solid #dc2626; padding-left: 25px; }
.path-indicator { font-size: 0.65rem; font-weight: 900; color: #52525b; letter-spacing: 2px; }
.path-indicator .active { color: #dc2626; }
.path-indicator .sep { margin: 0 8px; color: #27272a; }

.sf-event-panel {
    display: block;
    position: relative;
    background: #121214;
    border-radius: 24px;
    padding: 35px;
    text-decoration: none !important;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(255,255,255,0.05);
}

.panel-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.05) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
}

.sf-event-panel:hover {
    transform: translateY(-10px);
    border-color: rgba(220, 38, 38, 0.3);
    box-shadow: 0 25px 50px rgba(0,0,0,0.6);
}

.sf-event-panel:hover .panel-bg { opacity: 1; }

.panel-content { position: relative; z-index: 2; }

.event-id {
    font-size: 0.65rem;
    font-weight: 900;
    color: #52525b;
    letter-spacing: 2px;
}

.status-tag {
    font-size: 0.6rem;
    font-weight: 900;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(34, 197, 94, 0.2);
}

.event-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.75rem;
    color: #fff;
    margin-bottom: 20px;
    letter-spacing: 1px;
}

.detail-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #71717a;
    font-size: 0.85rem;
    margin-bottom: 8px;
}

.detail-item i { color: #dc2626; width: 16px; text-align: center; }

.panel-action {
    margin-top: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 2px;
    opacity: 0.4;
    transition: all 0.3s ease;
}

.sf-event-panel:hover .panel-action {
    opacity: 1;
    color: #dc2626;
}

.panel-border-glow {
    position: absolute;
    bottom: 0; left: 0; right: 0; height: 3px;
    background: #dc2626;
    transform: scaleX(0);
    transition: transform 0.4s ease;
}

.sf-event-panel:hover .panel-border-glow {
    transform: scaleX(1);
}

.empty-state-console {
    padding: 100px 0;
    opacity: 0.3;
}

.empty-state-console i { font-size: 5rem; color: #52525b; }
.empty-state-console h2 { font-family: 'Oswald', sans-serif; color: #fff; letter-spacing: 3px; margin-top: 20px; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('eventSearchInput');
    const items = document.querySelectorAll('.event-card-item');

    if (input) {
        input.addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase().trim();
            items.forEach(item => {
                const content = item.getAttribute('data-search');
                item.style.display = content.includes(q) ? 'block' : 'none';
            });
        });
    }
});
</script>
{% endblock %}
