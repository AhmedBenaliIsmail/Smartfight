{% extends 'base.html.twig' %}

{% block title %}Select Fight — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_stats') }}" style="color:#a1a1aa;text-decoration:none;">Statistics</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_stat_new') }}" style="color:#a1a1aa;text-decoration:none;">Select Event</a></li>
    <li class="breadcrumb-item active">Select Fight</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Step 2: Select Fight in {{ event.eventName }}</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Showing all completed fights for this event</p>
    </div>
    <a href="{{ path('app_stat_new') }}" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Back to Events</a>
</div>

<div class="row g-4">
    {% for fight in fights %}
    <div class="col-md-6">
        <a href="{{ path('app_stat_new', {'fightId': fight.resultId}) }}" style="text-decoration:none;">
            <div class="card card-link" style="background:#18181b;border:1px solid #27272a;transition:transform 0.2s; border-radius: 12px; overflow: hidden;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-danger rounded-pill px-3 py-1" style="font-size: 0.7rem; letter-spacing: 1px;">BOUT #{{ fight.fightNumber }}</span>
                        <div class="text-muted small" style="font-family: monospace;">FR-{{ fight.resultId }}</div>
                    </div>
                    
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <!-- Fighter 1 -->
                        <div class="text-center" style="flex: 1;">
                            {% if fight.fighter1 and fight.fighter1.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ fight.fighter1.photoFilename) }}" class="rounded-circle mb-2" style="width:70px; height:70px; object-fit:cover; border:2px solid #ef4444;" alt="">
                            {% else %}
                                <div class="rounded-circle mb-2 d-inline-flex align-items-center justify-content-center bg-dark" style="width:70px; height:70px; border:2px solid #ef4444;">
                                    <i class="fa-solid fa-user text-muted"></i>
                                </div>
                            {% endif %}
                            <div class="fw-bold text-white small">{{ fight.fighter1.fullName }}</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700;">{{ fight.fighter1.wins }}-{{ fight.fighter1.losses }}-{{ fight.fighter1.draws }}</div>
                        </div>

                        <div class="px-3">
                            <div class="badge bg-dark border border-secondary text-muted" style="font-size: 0.6rem;">VS</div>
                        </div>

                        <!-- Fighter 2 -->
                        <div class="text-center" style="flex: 1;">
                            {% if fight.fighter2 and fight.fighter2.photoFilename %}
                                <img src="{{ asset('uploads/boxers/' ~ fight.fighter2.photoFilename) }}" class="rounded-circle mb-2" style="width:70px; height:70px; object-fit:cover; border:2px solid #3b82f6;" alt="">
                            {% else %}
                                <div class="rounded-circle mb-2 d-inline-flex align-items-center justify-content-center bg-dark" style="width:70px; height:70px; border:2px solid #3b82f6;">
                                    <i class="fa-solid fa-user text-muted"></i>
                                </div>
                            {% endif %}
                            <div class="fw-bold text-white small">{{ fight.fighter2.fullName }}</div>
                            <div class="text-muted" style="font-size: 0.65rem; font-weight: 700;">{{ fight.fighter2.wins }}-{{ fight.fighter2.losses }}-{{ fight.fighter2.draws }}</div>
                        </div>
                    </div>
                    
                    <div class="mt-3 p-3 rounded text-center" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05);">
                        <div class="text-muted xsmall mb-1" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px;">Official Result</div>
                        <div class="fw-black" style="color:#fbbf24; font-size: 0.9rem;">
                            {{ fight.winner ? fight.winner.fullName|upper : 'DRAW' }}
                            <span class="ms-1 text-muted" style="font-weight: 400; font-size: 0.8rem;">({{ fight.methodOfVictory }})</span>
                        </div>
                        <div class="text-muted mt-1" style="font-size: 0.7rem;">{{ fight.fighter1.weightDivision.name }} Division</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    {% else %}
    <div class="col-12 text-center py-5">
        <i class="fa-solid fa-triangle-exclamation fa-4x mb-3 text-muted"></i>
        <h3 class="text-muted">No completed fights found for this event.</h3>
        <p class="text-muted">You must enter fight results before adding statistics.</p>
    </div>
    {% endfor %}
</div>

<style>
.card-link:hover { transform: translateY(-3px); border-color: #ef4444 !important; }
</style>
{% endblock %}
