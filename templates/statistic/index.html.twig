{% extends 'base.html.twig' %}

{% block title %}Boxing Statistics — SmartFight Admin{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" style="color:#a1a1aa;text-decoration:none;">Home</a></li>
    <li class="breadcrumb-item active">Statistics</li>
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold" style="color:#fafafa;">Bout Statistics</h1>
        <p class="mb-0" style="color:#a1a1aa;font-size:.875rem;">Paired SmartFight performance metrics with comparison analysis</p>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_stat_new') }}" class="btn btn-danger"><i class="fa-solid fa-plus me-2"></i>Add Statistics</a>
    {% endif %}
</div>

<div class="card mb-3" style="background:#18181b;border:1px solid #27272a;">
    <div class="card-body py-3">
        <form onsubmit="return false;">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control" placeholder="Type event or boxer to filter..." data-live-search="#stats-container" data-live-search-item=".stat-card" />
                    </div>
                </div>
                <div class="col-md-7 text-end">
                    <span class="badge bg-green-lt">Instant Filter Active</span>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="stats-container">
{% for rid, group in groupedStats %}
<div class="card mb-4 overflow-hidden stat-card" style="background:#18181b; border:1px solid {% if group.event.organization != 'INDEPENDENT' %}#c9a227{% else %}#27272a{% endif %}; {% if group.event.organization != 'INDEPENDENT' %}box-shadow: 0 0 15px rgba(201,162,39, 0.05);{% endif %}">
    <div class="card-header border-0 d-flex justify-content-between align-items-center" style="background:rgba(255,255,255,0.02);">
        <div>
            <span class="badge {% if group.event.organization != 'INDEPENDENT' %}bg-yellow-lt text-yellow{% else %}bg-secondary{% endif %} me-2">Bout #{{ group.result.fightNumber|default('?') }}</span>
            <span class="fw-bold" style="color:#fafafa;">{{ group.event.eventName|default('Unknown Event') }}</span>
            {% if group.event.organization != 'INDEPENDENT' %}
                <i class="fa-solid fa-crown text-yellow ms-1" title="World Title Bout"></i>
            {% endif %}
            <span class="text-muted small ms-2">{{ group.result.fightDate|date('Y-m-d') }}</span>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex gap-2">
            <a href="{{ path('app_stat_new', {'fightId': rid}) }}" class="btn btn-sm" style="background:#27272a;color:#a1a1aa;border:none;" title="Edit Comparison"><i class="fa-solid fa-pen me-1"></i> Edit</a>
            <form action="{{ path('app_stat_delete_fight', {'fightId': rid}) }}" method="post" onsubmit="return confirm('Are you sure you want to remove all statistics for this bout?');">
                <button type="submit" class="btn btn-sm" style="background:rgba(220,38,38,.1);color:#dc2626;border:none;" title="Remove Statistics"><i class="fa-solid fa-trash me-1"></i> Delete</button>
            </form>
        </div>
        {% endif %}
    </div>
    
    <div class="table-responsive">
        <table class="table table-dark table-bordered mb-0" style="background:#18181b; border: 1px solid #27272a;">
            <thead>
                <tr style="background: #dc2626; color: #ffffff; text-align: center; text-transform: uppercase; font-size: 0.85rem;">
                    <th style="width: 25%; border-color: #27272a;"></th>
                    <th style="width: 25%; border-color: #27272a;">Total Punches (Body Landed)</th>
                    <th style="width: 25%; border-color: #27272a;">Total Jabs (Body Landed)</th>
                    <th style="width: 25%; border-color: #27272a;">Power Punches (Body Landed)</th>
                </tr>
            </thead>
            <tbody>
                {% set s1 = null %}
                {% set s2 = null %}
                {% for s in group.stats %}
                    {% if loop.first %}{% set s1 = s %}{% else %}{% set s2 = s %}{% endif %}
                {% endfor %}

                {% for s in group.stats %}
                    <tr style="text-align: center; vertical-align: middle; background: rgba(255,255,255,0.01);">
                        <td rowspan="2" style="border-color: #27272a; text-align: left; padding-left: 1.5rem;">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    {% if s.fighter.photoFilename %}
                                        <img src="{{ asset('uploads/boxers/' ~ s.fighter.photoFilename) }}" class="rounded" style="width:50px; height:50px; object-fit:cover; border:1px solid #3f3f46;" alt="Photo" />
                                    {% else %}
                                        <div class="rounded d-flex align-items-center justify-content-center" style="width:50px; height:50px; background:#27272a; color:#a1a1aa;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="fw-bold" style="text-transform: uppercase; letter-spacing: 0.05em; color: #fafafa;">
                                    {{ s.fighter.lastName }}
                                </div>
                            </div>
                        </td>
                        <td style="border-color: #27272a; font-size: 1.1rem; color: #fafafa;">
                            {{ s.punchesLanded }} ({{ s.bodyShotsLanded }})/{{ s.punchesThrown }}
                        </td>
                        <td style="border-color: #27272a; font-size: 1.1rem; color: #fafafa;">
                            {{ s.jabsLanded }} ({{ (s.bodyShotsLanded * 0.1)|round }})/{{ s.jabsThrown }}
                        </td>
                        <td style="border-color: #27272a; font-size: 1.1rem; color: #fafafa;">
                            {{ s.powerPunchesLanded }} ({{ (s.bodyShotsLanded * 0.9)|round }})/{{ s.powerPunchesThrown }}
                        </td>
                    </tr>
                    <tr style="text-align: center; vertical-align: middle; background: rgba(255,255,255,0.01);">
                        <td style="border-color: #27272a; color: #a1a1aa; font-weight: 500;">
                            {{ s.punchAccuracy|round(1) }}%
                        </td>
                        <td style="border-color: #27272a; color: #a1a1aa; font-weight: 500;">
                            {{ s.jabAccuracy|round(1) }}%
                        </td>
                        <td style="border-color: #27272a; color: #a1a1aa; font-weight: 500;">
                            {{ s.powerAccuracy|round(1) }}%
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="p-3" style="background: #dc2626; color: #ffffff;">
        <h5 class="mb-1 fw-bold" style="text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.05em;">Inside The Numbers</h5>
        <p class="mb-0 small" style="opacity: 0.9;">
            {{ group.analysis|default('Analysis pending complete data entry.') }}
        </p>
    </div>

</div>
{% else %}
<div class="card text-center py-5" style="background:#18181b;border:1px solid #27272a;">
    <div class="card-body">
        <i class="fa-solid fa-chart-line fa-4x mb-3 text-muted"></i>
        <h3 class="text-muted">No bout statistics found.</h3>
        <p class="text-muted">Add SmartFight statistics to see comparison data.</p>
    </div>
</div>
{% endfor %}
</div>
{% endblock %}

