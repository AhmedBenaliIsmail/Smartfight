<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.smartfight.controller.LoginController"
            styleClass="root">

    <center>
        <VBox alignment="CENTER" spacing="14" maxWidth="360">
            <padding><Insets top="60" bottom="60" left="40" right="40"/></padding>

            <!-- Brand -->
            <Label text="SMARTFIGHT" styleClass="h1"/>
            <Label text="Sign in to your account" styleClass="caption"
                   style="-fx-padding:0 0 6 0;"/>

            <!-- Credentials -->
            <VBox spacing="6">
                <Label text="Username or Email"
                       style="-fx-text-fill:#a1a1aa;-fx-font-size:12px;"/>
                <TextField fx:id="usernameField" promptText="Username or email"
                           style="-fx-background-color:#18181b;-fx-border-color:#27272a;-fx-text-fill:#fafafa;-fx-prompt-text-fill:#52525b;"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Password"
                       style="-fx-text-fill:#a1a1aa;-fx-font-size:12px;"/>
                <PasswordField fx:id="passwordField" promptText="Password"
                               onAction="#onLogin"
                               style="-fx-background-color:#18181b;-fx-border-color:#27272a;-fx-text-fill:#fafafa;-fx-prompt-text-fill:#52525b;"/>
            </VBox>

            <Button text="Sign In" onAction="#onLogin" styleClass="btn-primary"
                    maxWidth="Infinity"/>
            <Button text="Sign In with Face ID" onAction="#onFaceIdLogin" styleClass="btn-outline"
                    maxWidth="Infinity"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="8">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OR" style="-fx-text-fill:#52525b;-fx-font-size:11px;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Google Sign-In -->
            <Button fx:id="googleBtn" onAction="#onGoogleLogin" maxWidth="Infinity"
                    style="-fx-background-color:#ffffff;-fx-text-fill:#1f1f1f;-fx-font-weight:bold;-fx-font-size:13px;-fx-background-radius:4;-fx-border-color:#dadce0;-fx-border-radius:4;-fx-padding:9 16;-fx-cursor:hand;">
                <graphic>
                    <HBox spacing="8" alignment="CENTER">
                        <!-- Google G SVG via text approximation -->
                        <Label text="G" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#4285f4;"/>
                        <Label text="Sign in with Google" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1f1f1f;"/>
                    </HBox>
                </graphic>
            </Button>

            <Label fx:id="statusLabel" styleClass="caption" wrapText="true"/>

            <Separator/>
            <Button text="Create an account" onAction="#onGoToRegister"
                    styleClass="btn-outline" maxWidth="Infinity"/>
        </VBox>
    </center>
</BorderPane>
