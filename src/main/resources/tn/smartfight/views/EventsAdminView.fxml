<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controllers.EventsAdminController"
      spacing="0" style="-fx-background-color:#09090b;">

    <HBox style="-fx-padding:24 28 16 28;-fx-spacing:12;-fx-alignment:CENTER_LEFT;">
        <Label text="EVENTS" style="-fx-text-fill:#fafafa;-fx-font-size:22px;-fx-font-weight:bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="tfSearch" promptText="Search events..."
                   style="-fx-background-color:#18181b;-fx-text-fill:#fff;-fx-prompt-text-fill:#71717a;-fx-background-radius:6;-fx-border-color:#27272a;-fx-border-radius:6;-fx-padding:7 14;"
                   prefWidth="220"/>
        <Button text="+ ADD" onAction="#onAddClicked"
                style="-fx-background-color:#dc2626;-fx-text-fill:#fff;-fx-font-weight:bold;-fx-background-radius:6;-fx-padding:8 18;-fx-cursor:hand;"/>
        <Button text="Edit" onAction="#onEditClicked"
                style="-fx-background-color:#27272a;-fx-text-fill:#fff;-fx-background-radius:6;-fx-padding:8 18;-fx-cursor:hand;"/>
        <Button text="Delete" onAction="#onDeleteClicked"
                style="-fx-background-color:rgba(220,38,38,0.15);-fx-text-fill:#f87171;-fx-background-radius:6;-fx-padding:8 18;-fx-cursor:hand;"/>
        <Button text="↻" onAction="#onRefreshClicked"
                style="-fx-background-color:#27272a;-fx-text-fill:#a1a1aa;-fx-background-radius:6;-fx-padding:8 12;-fx-cursor:hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color:#18181b;-fx-border-color:#27272a;-fx-border-width:1 0 0 0;-fx-padding:0 28 16 28;">
        <TableView fx:id="table" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:#18181b;-fx-border-color:#27272a;-fx-table-cell-border-color:#27272a;">
            <columns>
                <TableColumn fx:id="colId"         text="ID"         prefWidth="50"/>
                <TableColumn fx:id="colName"        text="EVENT"      prefWidth="220"/>
                <TableColumn fx:id="colDate"        text="DATE"       prefWidth="110"/>
                <TableColumn fx:id="colVenue"       text="VENUE"      prefWidth="180"/>
                <TableColumn fx:id="colStatus"      text="STATUS"     prefWidth="110"/>
                <TableColumn fx:id="colCapacity"    text="CAPACITY"   prefWidth="90"/>
                <TableColumn fx:id="colVisibility"  text="VISIBILITY" prefWidth="100"/>
            </columns>
            <placeholder><Label text="No events found." style="-fx-text-fill:#52525b;"/></placeholder>
        </TableView>
        <Label fx:id="lblStatus" text="" style="-fx-text-fill:#71717a;-fx-font-size:11px;-fx-padding:6 0 0 4;"/>
    </VBox>
</VBox>
