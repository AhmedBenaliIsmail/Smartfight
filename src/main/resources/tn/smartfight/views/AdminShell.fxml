<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.smartfight.controller.AdminShellController"
            styleClass="root">

    <!-- ══════════ TOP NAVBAR ══════════ -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <!-- Logo -->
            <Label text="SMARTFIGHT" styleClass="logo-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Search -->
            <TextField fx:id="searchField" styleClass="search-field"
                       promptText="Search Fighters, Events, Analytics..."
                       prefWidth="240"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Nav links -->
            <Button text="NEWS"      styleClass="nav-link" onAction="#onShowBlog"/>
            <Button text="RANKINGS"  styleClass="nav-link" onAction="#onShowRankings"/>
            <Button text="ANALYTICS" styleClass="nav-link" onAction="#onShowPerformance"/>
            <Button text="RESULTS"   styleClass="nav-link" onAction="#onShowResults"/>
            <!-- ADMIN badge -->
            <Label text="ADMIN" styleClass="badge-admin"/>
            <!-- Bell -->
            <StackPane>
                <Button fx:id="bellBtn" text="🔔" onAction="#onBellClick" styleClass="btn-icon"/>
                <Label fx:id="badgeLabel" text="0"
                       style="-fx-background-color:#dc2626;-fx-text-fill:white;-fx-font-size:9;-fx-background-radius:8;-fx-padding:1 4;"
                       visible="false" StackPane.alignment="TOP_RIGHT" translateX="6" translateY="-4"/>
            </StackPane>
            <!-- Avatar -->
            <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36">
                <Circle fx:id="avatarCircle" radius="18"
                        style="-fx-fill:#374151;"/>
                <Label fx:id="avatarLabel" styleClass="avatar-label" text="A"/>
                <!-- green dot -->
                <Circle radius="5" fill="#16a34a" StackPane.alignment="BOTTOM_RIGHT"
                        translateX="3" translateY="3"/>
            </StackPane>
            <padding><Insets top="0" bottom="0" left="20" right="20"/></padding>
        </HBox>
    </top>

    <!-- ══════════ LEFT SIDEBAR ══════════ -->
    <left>
        <VBox fx:id="sidebarBox" styleClass="sidebar" spacing="0">
            <!-- Toggle button centered -->
            <HBox alignment="CENTER" style="-fx-padding:8 0 4 0;">
                <Button fx:id="sidebarToggle" text="«" styleClass="sidebar-toggle"
                        onAction="#onToggleSidebar"/>
            </HBox>

            <!-- Group 1: Overview -->
            <Button fx:id="btnDashboard"   text="⊞  Dashboard"        onAction="#onShowDashboard"   styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnLeaderboard" text="🏆  Leaderboard"      onAction="#onShowLeaderboard" styleClass="nav-btn" maxWidth="Infinity"/>

            <!-- Separator -->
            <Pane styleClass="sidebar-divider" maxWidth="Infinity">
                <VBox.margin><Insets top="8" bottom="8" left="16" right="16"/></VBox.margin>
            </Pane>

            <!-- Group 2: Management -->
            <Button fx:id="btnUsers"    text="👥  Users Management"  onAction="#onShowUsers"     styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnFighters" text="🥊  Boxers"            onAction="#onShowFighters"  styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnEvents"   text="📅  Events"            onAction="#onShowEvents"    styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnChampions" text="★  Champions Event"   onAction="#onShowChampions" styleClass="nav-sub-btn" maxWidth="Infinity"/>
            <Button fx:id="btnResults"  text="📋  Bout Results"      onAction="#onShowResults"   styleClass="nav-btn" maxWidth="Infinity"/>

            <!-- Separator -->
            <Pane styleClass="sidebar-divider" maxWidth="Infinity">
                <VBox.margin><Insets top="8" bottom="8" left="16" right="16"/></VBox.margin>
            </Pane>

            <!-- Group 3: Analytics -->
            <Button fx:id="btnStats"    text="📊  Statistics"        onAction="#onShowStats"       styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnPerf"     text="⚡  Performance"       onAction="#onShowPerformance" styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnRankings" text="🌐  World Ranking"     onAction="#onShowRankings"    styleClass="nav-btn" maxWidth="Infinity"/>

            <!-- Separator -->
            <Pane styleClass="sidebar-divider" maxWidth="Infinity">
                <VBox.margin><Insets top="8" bottom="8" left="16" right="16"/></VBox.margin>
            </Pane>

            <!-- Group 4: Content -->
            <Button fx:id="btnBlog"      text="📰  Blog / News"       onAction="#onShowBlog"      styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnBookings"  text="🎫  Event Bookings"    onAction="#onShowBookings"  styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnReactions" text="💬  Fan Reactions"     onAction="#onShowReactions" styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnProposals" text="🗳  Voting Pool"       onAction="#onShowProposals" styleClass="nav-btn" maxWidth="Infinity"/>

            <!-- Separator -->
            <Pane styleClass="sidebar-divider" maxWidth="Infinity">
                <VBox.margin><Insets top="8" bottom="8" left="16" right="16"/></VBox.margin>
            </Pane>

            <!-- Group 5: Finance & AI -->
            <Button fx:id="btnContracts" text="💰  Purses &amp; Contracts" onAction="#onShowContracts" styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnFinance"   text="💹  Finance"               onAction="#onShowFinance"   styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="btnInjury"    text="🩺  Injury AI"              onAction="#onShowInjury"    styleClass="nav-btn" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom separator -->
            <Pane styleClass="sidebar-divider" maxWidth="Infinity">
                <VBox.margin><Insets top="8" bottom="8" left="16" right="16"/></VBox.margin>
            </Pane>

            <!-- Bottom: Face ID + Logout -->
            <Button text="📷  Register Face ID" onAction="#onRegisterFaceId"
                    styleClass="nav-btn" maxWidth="Infinity"/>
            <Button text="⏻  Logout" onAction="#onLogout"
                    styleClass="nav-btn" maxWidth="Infinity"
                    style="-fx-text-fill:#dc2626;"/>
        </VBox>
    </left>

    <!-- ══════════ CONTENT HOST ══════════ -->
    <center>
        <StackPane fx:id="contentHost" style="-fx-background-color:#0d0d0d;"/>
    </center>
</BorderPane>
