<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.LeaderboardController"
      spacing="0"
      style="-fx-background-color:#0d0d0d;">

    <!-- Header -->
    <VBox style="-fx-background-color:#111113;-fx-border-color:#27272a;-fx-border-width:0 0 1 0;-fx-padding:16 24;">
        <Label text="FAN LEADERBOARD" styleClass="h2"/>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10 0 0 0;">
            <Label fx:id="statusLabel" styleClass="caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↻  Refresh" onAction="#onRefresh" styleClass="btn-primary"/>
        </HBox>
    </VBox>

    <!-- Podium row (top 3) -->
    <HBox fx:id="podiumRow" alignment="BOTTOM_CENTER" spacing="16"
          style="-fx-background-color:#0d0d0d;-fx-padding:28 24 0 24;"/>

    <!-- Leaderboard table -->
    <TableView fx:id="leaderTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color:#0d0d0d;-fx-border-width:0;-fx-padding:16 0 0 0;">
        <columns>
            <TableColumn fx:id="colRank"   text="#"         prefWidth="55"/>
            <TableColumn fx:id="colUser"   text="Fan"       prefWidth="220"/>
            <TableColumn fx:id="colPoints" text="Points"    prefWidth="110"/>
            <TableColumn fx:id="colStatus" text="Tier"      prefWidth="130"/>
        </columns>
        <placeholder><Label text="No rankings yet — make your first prediction!" style="-fx-text-fill:#52525b;"/></placeholder>
    </TableView>
</VBox>
