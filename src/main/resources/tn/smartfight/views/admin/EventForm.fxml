<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.EventFormController"
      spacing="10">
    <padding><Insets top="16" bottom="16" left="20" right="20"/></padding>
    <Label text="Event Details" styleClass="h2"/>

    <GridPane hgap="12" vgap="10">
        <Label text="Event Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="eventNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="eventDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Organization" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="organizationCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"
                  maxWidth="Infinity"/>

        <Label text="Venue" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="venueField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="City" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="cityField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Country (2-letter)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="countryField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Seat Capacity" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="seatCapacityField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Status" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusCombo" GridPane.rowIndex="7" GridPane.columnIndex="1"
                  maxWidth="Infinity"/>

        <Label text="Visibility" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <ComboBox fx:id="visibilityCombo" GridPane.rowIndex="8" GridPane.columnIndex="1"
                  maxWidth="Infinity"/>

        <Label text="Champions Event" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <CheckBox fx:id="championsCheck" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Label fx:id="statusLabel" styleClass="caption" HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-outline"/>
        <Button text="Save" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
