<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.ManageCardController"
      style="-fx-background-color:#0d0d0d;" spacing="0">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="24" bottom="16" left="24" right="24"/></padding>
        <VBox spacing="4">
            <Label fx:id="titleLabel" text="MANAGE CARD" styleClass="page-title"/>
            <Label text="Run the professional boxing card with precision" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="cardFullLabel" text="Card Full (max 3 bouts)"
               style="-fx-background-color:#1a1a1a;-fx-border-color:#f59e0b;-fx-border-radius:6;-fx-background-radius:6;-fx-text-fill:#f59e0b;-fx-padding:6 14;-fx-font-size:11;"
               visible="false"/>
        <Button text="← Back to Events" styleClass="button" onAction="#onBackToEvents"/>
    </HBox>

    <!-- Bouts list -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
        <content>
            <VBox spacing="12" style="-fx-background-color:#0d0d0d;">
                <padding><Insets top="0" bottom="16" left="24" right="24"/></padding>

                <VBox fx:id="boutsContainer" spacing="12"/>

                <!-- Add Fight section -->
                <VBox styleClass="card" spacing="12" fx:id="addFightSection">
                    <Label text="ADD FIGHT TO CARD"
                           style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <ComboBox fx:id="fighter1Combo" promptText="Fighter 1" prefWidth="220"/>
                        <Label text="VS" style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#dc2626;"/>
                        <ComboBox fx:id="fighter2Combo" promptText="Fighter 2" prefWidth="220"/>
                        <ComboBox fx:id="fightNumCombo" promptText="Bout #" prefWidth="90">
                            <items>
                                <javafx.collections.FXCollections fx:factory="observableArrayList">
                                    <String fx:value="1"/>
                                    <String fx:value="2"/>
                                    <String fx:value="3"/>
                                </javafx.collections.FXCollections>
                            </items>
                        </ComboBox>
                        <Button text="ADD FIGHT" styleClass="btn-primary" onAction="#onAddFight"/>
                        <Button text="🤖 AI SUGGEST" styleClass="button" onAction="#onAISuggest"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" styleClass="caption"/>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
