<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.MatchProposalsController"
      spacing="12" styleClass="content-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Match Proposals" styleClass="h2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Generate AI Proposals" onAction="#onGenerate" styleClass="btn-primary"/>
        <Button text="Approve" onAction="#onApprove" styleClass="btn-outline"/>
        <Button text="Reject" onAction="#onReject" styleClass="btn-outline"/>
        <Button text="Delete" onAction="#onDelete" styleClass="btn-danger"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="btn-outline"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Filter:"/>
        <ComboBox fx:id="statusFilter" prefWidth="140"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colMatchup"    text="Matchup"       prefWidth="280"/>
            <TableColumn fx:id="colScore"      text="Score IA"      prefWidth="90"/>
            <TableColumn fx:id="colStatus"     text="Status"        prefWidth="90"/>
            <TableColumn fx:id="colVotes"      text="Votes"         prefWidth="70"/>
            <TableColumn fx:id="colDivision"   text="Division"      prefWidth="140"/>
            <TableColumn fx:id="colNotes"      text="Notes"         prefWidth="260"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" styleClass="caption" text="Loading..."/>
</VBox>
