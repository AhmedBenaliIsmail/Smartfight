<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.StatsWizardController"
      spacing="0" styleClass="content-pane">
    <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>

    <!-- ═══ STEP 1: Select Event ═══ -->
    <VBox fx:id="step1" spacing="20">
        <Label text="FIGHT STATISTICS WIZARD"
               style="-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label text="Step 1 of 3 — Select an event to enter round statistics"
               styleClass="caption"/>
        <VBox spacing="8"
              style="-fx-background-color:#1a1a1a;-fx-background-radius:10;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:10;-fx-padding:20;"
              maxWidth="480">
            <Label text="EVENT"
                   style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#6b7280;-fx-letter-spacing:1;"/>
            <ComboBox fx:id="eventCombo" maxWidth="Infinity"/>
        </VBox>
        <Button text="Next  →" onAction="#onStep1Next" styleClass="btn-primary" prefWidth="160"/>
        <Label fx:id="step1Status" styleClass="caption"/>
    </VBox>

    <!-- ═══ STEP 2: Select Fight ═══ -->
    <VBox fx:id="step2" spacing="14" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="←" onAction="#onStep2Back" styleClass="btn-outline"/>
            <VBox spacing="3">
                <Label text="SELECT BOUT"
                       style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Step 2 of 3 — Choose the fight to enter stats for"
                       styleClass="caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="fightTable" VBox.vgrow="ALWAYS" prefHeight="320">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colFighters" text="FIGHTERS"  prefWidth="340"/>
                <TableColumn fx:id="colMethod"   text="RESULT"    prefWidth="130"/>
                <TableColumn fx:id="colRounds"   text="RDS"       prefWidth="60"/>
            </columns>
            <placeholder><Label text="No fights found for this event" styleClass="text-muted"/></placeholder>
        </TableView>
        <HBox spacing="8">
            <Button text="Enter Stats  →" onAction="#onStep2Next" styleClass="btn-primary"/>
        </HBox>
        <Label fx:id="step2Status" styleClass="caption" wrapText="true"/>
    </VBox>

    <!-- ═══ STEP 3: Enter Stats ═══ -->
    <VBox fx:id="step3" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">

        <!-- Fight header -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <Button text="←" onAction="#onStep3Back" styleClass="btn-outline"/>
            <VBox spacing="3">
                <Label fx:id="fightLabel"
                       style="-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Step 3 of 3 — Round Stats Entry" styleClass="caption"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="ROUND"
                   style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#6b7280;"/>
            <ComboBox fx:id="roundCombo" prefWidth="84"/>
        </HBox>

        <!-- Column headers (sticky above scroll) -->
        <GridPane hgap="12"
                  style="-fx-background-color:#111111;-fx-background-radius:8;-fx-padding:10 16;">
            <columnConstraints>
                <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="STATISTIC"
                   style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#6b7280;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="f1Header" text="RED CORNER"
                   style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:#dc2626;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label fx:id="f2Header" text="BLUE CORNER"
                   style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:#3b82f6;"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        </GridPane>

        <!-- Scrollable stat groups -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color:transparent;-fx-background:transparent;-fx-border-color:transparent;">
            <VBox spacing="8">
                <padding><Insets top="2" bottom="8" left="0" right="4"/></padding>

                <!-- GROUP: TOTAL PUNCHES -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="TOTAL PUNCHES"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Punches Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1PunchesThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2PunchesThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Punches Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1PunchesLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2PunchesLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: RIGHT HAND -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="RIGHT HAND"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Right Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1RightThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2RightThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Right Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1RightLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2RightLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: LEFT HAND -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="LEFT HAND"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Left Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1LeftThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2LeftThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Left Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1LeftLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2LeftLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: POWER PUNCHES -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="POWER PUNCHES"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Power Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1PowerThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2PowerThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Power Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1PowerLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2PowerLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: JABS -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="JABS"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Jabs Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1JabsThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2JabsThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Jabs Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1JabsLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2JabsLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: UPPERCUTS -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="UPPERCUTS"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Uppercuts Thrown" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1UppThrown" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2UppThrown" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Uppercuts Landed"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1UppLanded" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2UppLanded" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- GROUP: BODY & KNOCKDOWNS -->
                <VBox style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;">
                    <HBox style="-fx-background-color:#27272a;-fx-padding:7 14;-fx-background-radius:8 8 0 0;">
                        <Label text="BODY &amp; KNOCKDOWNS"
                               style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#22c55e;-fx-letter-spacing:1;"/>
                    </HBox>
                    <GridPane hgap="12" vgap="8" style="-fx-padding:10 14 14 14;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Body Shots Landed" style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="f1BodyLanded" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="f2BodyLanded" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Knockdowns (0–3)"  style="-fx-text-fill:#d4d4d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="f1Knockdowns" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="f2Knockdowns" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Commentary banner -->
                <VBox spacing="10"
                      style="-fx-background-color:linear-gradient(from 0% 0% to 100% 100%, #991b1b, #7f1d1d);-fx-background-radius:8;-fx-padding:16 20;">
                    <Label fx:id="commentaryRoundLabel" text="INSIDE THE NUMBERS — ROUND 1"
                           style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.6);-fx-letter-spacing:2;"/>
                    <TextArea fx:id="commentaryArea" prefHeight="90" wrapText="true"
                              promptText="Enter broadcast analysis or click 'AI Auto-Fill'..."
                              style="-fx-control-inner-background:rgba(0,0,0,0.35);-fx-text-fill:white;-fx-border-color:rgba(255,255,255,0.25);-fx-border-width:1;-fx-border-radius:4;-fx-background-radius:4;-fx-prompt-text-fill:rgba(255,255,255,0.4);"/>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Action bar -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:#1a1a1a;-fx-background-radius:8;-fx-border-color:#2d2d2d;-fx-border-width:1;-fx-border-radius:8;-fx-padding:12 16;">
            <Label text="ⓘ  Right+Left Thrown must equal Total Thrown. Same rule applies for Landed."
                   style="-fx-font-size:11;-fx-text-fill:#71717a;" wrapText="true" maxWidth="340"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAiAutoFill" text="✦ AI Auto-Fill" onAction="#onAiAutoFill"
                    style="-fx-background-color:rgba(139,92,246,0.12);-fx-text-fill:#8b5cf6;-fx-border-color:#8b5cf6;-fx-border-width:1;-fx-border-radius:8;-fx-background-radius:8;-fx-font-size:13;-fx-font-weight:bold;-fx-padding:8 16;-fx-cursor:hand;"/>
            <Button fx:id="btnSaveRound" text="Save Round 1" onAction="#onSave"
                    styleClass="btn-primary"
                    style="-fx-font-size:14;-fx-font-weight:bold;-fx-padding:8 22;"/>
        </HBox>

        <!-- Validation / status -->
        <Label fx:id="validationLabel" styleClass="caption" wrapText="true"
               style="-fx-text-fill:#ef4444;" visible="false" managed="false"/>
        <Label fx:id="step3Status" styleClass="caption" wrapText="true"/>
    </VBox>
</VBox>
