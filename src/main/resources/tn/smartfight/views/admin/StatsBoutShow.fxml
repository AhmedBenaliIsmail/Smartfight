<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.StatsBoutShowController"
      spacing="0" styleClass="content-pane">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent;-fx-background:#09090b;-fx-border-color:transparent;">
        <VBox spacing="28" style="-fx-background-color:#09090b;">
            <padding><Insets top="28" bottom="40" left="32" right="32"/></padding>

            <!-- ═══ BACK + BREADCRUMB ═══ -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← BACK TO ARCHIVE" onAction="#onBack"
                        style="-fx-background-color:rgba(255,255,255,0.04);-fx-border-color:rgba(255,255,255,0.1);-fx-border-width:1;-fx-border-radius:10;-fx-text-fill:#a1a1aa;-fx-font-size:10;-fx-font-weight:bold;-fx-padding:8 16;-fx-cursor:hand;-fx-letter-spacing:1;"/>
                <Label fx:id="breadcrumbLabel" text=""
                       style="-fx-text-fill:#52525b;-fx-font-size:10;-fx-font-weight:bold;-fx-letter-spacing:1;"/>
            </HBox>

            <!-- ═══ HERO HEADER ═══ -->
            <VBox fx:id="heroPanel" spacing="0"
                  style="-fx-background-color:linear-gradient(from 0% 0% to 100% 100%, #1e1b4b, #431407);-fx-background-radius:32;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:1;-fx-border-radius:32;-fx-padding:0;">
                <HBox alignment="CENTER" spacing="0">
                    <!-- Fighter 1 -->
                    <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" style="-fx-padding:40 50;">
                        <Label text="RED CORNER"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#dc2626;-fx-letter-spacing:2;"/>
                        <Label fx:id="f1HeroName" text=""
                               style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;-fx-letter-spacing:2;"/>
                        <Label fx:id="f1HeroRecord" text=""
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#71717a;-fx-letter-spacing:1;"/>
                    </VBox>
                    <!-- VS -->
                    <VBox alignment="CENTER" style="-fx-padding:20;">
                        <Label text="VS"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                    </VBox>
                    <!-- Fighter 2 -->
                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-padding:40 50;">
                        <Label text="BLUE CORNER"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#3b82f6;-fx-letter-spacing:2;"/>
                        <Label fx:id="f2HeroName" text=""
                               style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;-fx-letter-spacing:2;"/>
                        <Label fx:id="f2HeroRecord" text=""
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#71717a;-fx-letter-spacing:1;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ═══ TOTAL STATS CARDS ═══ -->
            <HBox spacing="20">
                <!-- Fighter 1 card -->
                <VBox fx:id="f1StatCard" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#121214;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 0 0 4;-fx-border-left-color:#dc2626;-fx-border-radius:24;-fx-background-radius:24;-fx-padding:0;">
                    <!-- Will be built dynamically -->
                </VBox>
                <!-- Fighter 2 card -->
                <VBox fx:id="f2StatCard" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:#121214;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 0 0 4;-fx-border-left-color:#3b82f6;-fx-border-radius:24;-fx-background-radius:24;-fx-padding:0;">
                </VBox>
            </HBox>

            <!-- ═══ ROUND-BY-ROUND TABLE ═══ -->
            <VBox style="-fx-background-color:#121214;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:1;-fx-border-radius:24;-fx-background-radius:24;">
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:18 24;">
                    <Label text="📋" style="-fx-font-size:14;-fx-text-fill:#dc2626;"/>
                    <Label text="ROUND_BY_ROUND_LOG"
                           style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:white;-fx-letter-spacing:2;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="DATA SOURCE: SMARTFIGHT_OS_v2.4"
                           style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#3f3f46;-fx-letter-spacing:1;"/>
                </HBox>
                <TableView fx:id="roundTable" prefHeight="280"
                           style="-fx-background-color:transparent;-fx-control-inner-background:#121214;-fx-border-color:transparent;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colRound"   text="ROUND"         prefWidth="70"/>
                        <TableColumn fx:id="colFighter" text="FIGHTER"        prefWidth="160"/>
                        <TableColumn fx:id="colLanded"  text="LANDED/THROWN"  prefWidth="130"/>
                        <TableColumn fx:id="colAcc"     text="ACC %"          prefWidth="90"/>
                        <TableColumn fx:id="colJabs"    text="JABS L/T"       prefWidth="100"/>
                        <TableColumn fx:id="colPower"   text="POWER L/T"      prefWidth="100"/>
                        <TableColumn fx:id="colBody"    text="BODY"           prefWidth="70"/>
                        <TableColumn fx:id="colKD"      text="KD"             prefWidth="50"/>
                    </columns>
                    <placeholder><Label text="No round data available" style="-fx-text-fill:#52525b;"/></placeholder>
                </TableView>
            </VBox>

            <!-- ═══ AI BOUT INTELLIGENCE ═══ -->
            <VBox fx:id="analysisPanel"
                  style="-fx-background-color:#121214;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:1;-fx-border-radius:24;-fx-background-radius:24;">
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding:18 24;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 0 1 0;">
                    <VBox alignment="CENTER" minWidth="36" minHeight="36"
                          style="-fx-background-color:rgba(220,38,38,0.15);-fx-background-radius:8;">
                        <Label text="🧠" style="-fx-font-size:14;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="AI_BOUT_INTELLIGENCE"
                               style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:white;-fx-letter-spacing:2;"/>
                        <Label text="POWERED BY SMARTFIGHT ANALYTICS ENGINE v2"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#3f3f46;-fx-letter-spacing:1;"/>
                    </VBox>
                </HBox>

                <!-- Key metrics row -->
                <HBox spacing="0" style="-fx-padding:20 24 10 24;">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 1 0 0;-fx-padding:10;">
                        <Label fx:id="lblDomScore" text="0.0"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <Label text="DOMINANCE SCORE"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#52525b;-fx-letter-spacing:1;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 1 0 0;-fx-padding:10;">
                        <Label fx:id="lblTotalLanded" text="0"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#22d3ee;"/>
                        <Label text="TOTAL LANDED"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#52525b;-fx-letter-spacing:1;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 1 0 0;-fx-padding:10;">
                        <Label fx:id="lblKnockdowns" text="0"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#fbbf24;"/>
                        <Label text="KNOCKDOWNS"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#52525b;-fx-letter-spacing:1;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-padding:10;">
                        <Label fx:id="lblOverallAcc" text="0%"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#22c55e;"/>
                        <Label text="OVERALL ACC"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#52525b;-fx-letter-spacing:1;"/>
                    </VBox>
                </HBox>

                <!-- Summary -->
                <VBox style="-fx-background-color:rgba(220,38,38,0.06);-fx-border-color:rgba(220,38,38,0.15);-fx-border-width:1;-fx-border-radius:14;-fx-background-radius:14;-fx-padding:20;-fx-margin:0 24 16 24;">
                    <padding><Insets top="0" bottom="16" left="24" right="24"/></padding>
                    <Label text="📡 BROADCAST SUMMARY"
                           style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#dc2626;-fx-letter-spacing:2;"/>
                    <Label fx:id="lblSummary" text=""
                           style="-fx-font-size:13;-fx-text-fill:rgba(255,255,255,0.8);-fx-line-spacing:4;" wrapText="true"/>
                </VBox>

                <!-- Insights -->
                <VBox fx:id="insightsPanel"
                      style="-fx-background-color:rgba(59,130,246,0.06);-fx-border-color:rgba(59,130,246,0.15);-fx-border-width:1;-fx-border-radius:14;-fx-background-radius:14;-fx-padding:20;">
                    <padding><Insets top="0" bottom="24" left="24" right="24"/></padding>
                    <Label text="📈 DEEP DIVE INSIGHTS"
                           style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#3b82f6;-fx-letter-spacing:2;"/>
                    <!-- Insight labels added dynamically -->
                </VBox>
            </VBox>

            <!-- ═══ ROUND COMMENTARY LOG ═══ -->
            <VBox fx:id="commentaryPanel"
                  style="-fx-background-color:#121214;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:1;-fx-border-radius:24;-fx-background-radius:24;" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding:18 24;-fx-border-color:rgba(255,255,255,0.05);-fx-border-width:0 0 1 0;">
                    <VBox alignment="CENTER" minWidth="36" minHeight="36"
                          style="-fx-background-color:rgba(59,130,246,0.15);-fx-background-radius:8;">
                        <Label text="🎙" style="-fx-font-size:14;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="ROUND_COMMENTARY_LOG"
                               style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:white;-fx-letter-spacing:2;"/>
                        <Label text="BROADCAST-STYLE ROUND ANALYSIS"
                               style="-fx-font-size:9;-fx-font-weight:bold;-fx-text-fill:#3f3f46;-fx-letter-spacing:1;"/>
                    </VBox>
                </HBox>
                <VBox fx:id="commentaryContainer" spacing="14" style="-fx-padding:20 24 24 24;">
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
