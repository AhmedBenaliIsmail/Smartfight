<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.smartfight.controller.DashboardController"
            fitToWidth="true" styleClass="scroll-pane">
  <content>
    <VBox spacing="0" style="-fx-background-color:#0d0d0d;">

      <!-- ── Page header ── -->
      <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="24" bottom="16" left="24" right="24"/></padding>
        <VBox spacing="4">
          <Label text="COMMAND CENTER" styleClass="page-title"/>
          <Label text="System Overview &amp; Management Tools" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color:#dc2626;-fx-background-radius:20;-fx-padding:6 14;">
          <Label text="● ADMIN SESSIONS ACTIVE"
                 style="-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;"/>
        </HBox>
      </HBox>

      <!-- ── SECTION A: Quick Action Cards (2×2) ── -->
      <VBox spacing="12">
        <padding><Insets top="8" bottom="0" left="24" right="24"/></padding>
        <GridPane hgap="16" vgap="16">
          <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
          </columnConstraints>
          <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
            <RowConstraints vgrow="ALWAYS"/>
          </rowConstraints>

          <!-- Schedule Fight -->
          <VBox styleClass="quick-action-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="📅" style="-fx-font-size:28;"/>
            <Label text="Schedule Fight" style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="Create a new bout" styleClass="text-muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="SCHEDULE FIGHT" styleClass="btn-primary" onAction="#onScheduleFight" maxWidth="Infinity"/>
          </VBox>

          <!-- Manage Events -->
          <VBox styleClass="quick-action-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="🏆" style="-fx-font-size:28;"/>
            <Label text="Manage Events" style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="View/edit your events" styleClass="text-muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="MANAGE EVENTS" styleClass="btn-primary" onAction="#onManageEvents" maxWidth="Infinity"/>
          </VBox>

          <!-- Boxer Roster -->
          <VBox styleClass="quick-action-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="🥊" style="-fx-font-size:28;"/>
            <Label text="Boxer Roster" style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="Control fighter data" styleClass="text-muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="BOXER ROSTER" styleClass="btn-primary" onAction="#onBoxerRoster" maxWidth="Infinity"/>
          </VBox>

          <!-- Publish News -->
          <VBox styleClass="quick-action-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="📰" style="-fx-font-size:28;"/>
            <Label text="Publish News" style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="Write blog article" styleClass="text-muted"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="PUBLISH NEWS" styleClass="btn-primary" onAction="#onPublishNews" maxWidth="Infinity"/>
          </VBox>
        </GridPane>
      </VBox>

      <!-- ── SECTION B: Financial Summary (4 metrics) ── -->
      <VBox spacing="8">
        <padding><Insets top="24" bottom="0" left="24" right="24"/></padding>
        <Label text="FINANCIAL OVERVIEW"
               style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#6b7280;"/>
        <HBox spacing="12">
          <!-- Gross Revenue -->
          <VBox styleClass="metric-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="GROSS REVENUE" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblGrossRevenue" text="0.00"
                   style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="▲ Operating Income" style="-fx-font-size:10;-fx-text-fill:#16a34a;"/>
          </VBox>
          <!-- Customer Deposits -->
          <VBox styleClass="metric-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="CUSTOMER DEPOSITS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblDeposits" text="0.00"
                   style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="Customer Obligation" style="-fx-font-size:10;-fx-text-fill:#dc2626;"/>
          </VBox>
          <!-- Net P/L -->
          <VBox styleClass="metric-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="NET OPERATING P/L" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblNetPL" text="0.00"
                   style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="▲ Operating Profit" style="-fx-font-size:10;-fx-text-fill:#16a34a;"/>
          </VBox>
          <!-- Pending Payouts -->
          <VBox styleClass="metric-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="PENDING PAYOUTS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblPendingPayouts" text="0.00"
                   style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="Awaiting Distribution" style="-fx-font-size:10;-fx-text-fill:#16a34a;"/>
          </VBox>
        </HBox>
      </VBox>

      <!-- ── SECTION C: Fan Favorite Center ── -->
      <VBox spacing="12">
        <padding><Insets top="24" bottom="0" left="24" right="24"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="12">
          <VBox spacing="4">
            <Label text="FAN FAVORITE CENTER"
                   style="-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            <Label text="The Leaderboard fan system. These are the most anticipated matchups."
                   styleClass="text-muted"/>
          </VBox>
          <Region HBox.hgrow="ALWAYS"/>
          <Button text="CREATE FAN EVENT" styleClass="btn-primary" onAction="#onCreateFanEvent"/>
        </HBox>
        <!-- 3 proposal cards -->
        <HBox spacing="12" fx:id="proposalsBox">
          <!-- populated programmatically -->
          <Label fx:id="proposalsPlaceholder" text="Loading proposals..."
                 styleClass="text-muted" HBox.hgrow="ALWAYS"/>
        </HBox>
      </VBox>

      <!-- ── SECTION D: Charts ── -->
      <HBox spacing="16">
        <padding><Insets top="24" bottom="0" left="24" right="24"/></padding>

        <!-- Revenue chart -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
          <HBox alignment="CENTER_LEFT">
            <VBox spacing="2">
              <Label text="PLATFORM REVENUE GROWTH"
                     style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
              <Label text="Last 7 Days" styleClass="text-muted" style="-fx-font-size:11;"/>
            </VBox>
          </HBox>
          <LineChart fx:id="revenueChart" prefHeight="200"
                     style="-fx-background-color:transparent;">
            <xAxis><CategoryAxis label="" tickLabelFill="#6b7280"/></xAxis>
            <yAxis><NumberAxis label="" tickLabelFill="#6b7280"/></yAxis>
          </LineChart>
        </VBox>

        <!-- User growth chart -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
          <HBox alignment="CENTER_LEFT">
            <Label text="USER GROWTH"
                   style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          </HBox>
          <BarChart fx:id="userChart" prefHeight="200"
                    style="-fx-background-color:transparent;">
            <xAxis><CategoryAxis label="" tickLabelFill="#6b7280"/></xAxis>
            <yAxis><NumberAxis label="" tickLabelFill="#6b7280"/></yAxis>
          </BarChart>
          <HBox spacing="16">
            <VBox spacing="2">
              <Label text="TOTAL FANS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
              <Label fx:id="lblTotalFans" text="0"
                     style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
            </VBox>
            <Label fx:id="lblGrowthPct" text="+0%"
                   style="-fx-background-color:#16a34a;-fx-text-fill:white;-fx-font-size:11;-fx-font-weight:bold;-fx-background-radius:12;-fx-padding:3 8;"
                   alignment="CENTER"/>
          </HBox>
        </VBox>
      </HBox>

      <!-- ── SECTION E: Recent Activity ── -->
      <HBox spacing="16">
        <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>

        <!-- Recent fights table -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
          <Label text="RECENT ACTIVITY"
                 style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          <TableView fx:id="recentTable" prefHeight="220" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="colEvent"  text="EVENT / NAME" prefWidth="200"/>
              <TableColumn fx:id="colBoxers" text="BOXERS"       prefWidth="200"/>
              <TableColumn fx:id="colStatus" text="STATUS"       prefWidth="100"/>
            </columns>
            <placeholder><Label text="No recent fights" styleClass="text-muted"/></placeholder>
          </TableView>
        </VBox>

        <!-- Right stats panel -->
        <VBox styleClass="card" spacing="16" minWidth="200">
          <Label text="SYSTEM STATS"
                 style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          <VBox spacing="4">
            <Label text="EVENTS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblEventCount" text="0"
                   style="-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          </VBox>
          <VBox spacing="4">
            <Label text="FIGHTS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblFightCount" text="0"
                   style="-fx-font-size:24;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          </VBox>
          <VBox spacing="4">
            <Label text="ENGINE STATUS" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label text="● ACTIVE"
                   style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#16a34a;"/>
          </VBox>
          <VBox spacing="4">
            <Label text="UPTIME" style="-fx-font-size:10;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label text="99.9%"
                   style="-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
          </VBox>
        </VBox>
      </HBox>

    </VBox>
  </content>
</ScrollPane>
