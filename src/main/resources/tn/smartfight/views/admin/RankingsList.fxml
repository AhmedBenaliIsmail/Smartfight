<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.RankingsListController"
      style="-fx-background-color:#0d0d0d;" spacing="0">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="24" bottom="16" left="24" right="24"/></padding>
        <VBox spacing="4">
            <Label text="WORLD RANKINGS" styleClass="page-title"/>
            <Label text="Global fighter standings across all weight divisions and organizations"
                   styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="EXPORT PDF"      styleClass="button"     onAction="#onExportPdf"/>
        <Button text="RECOMPUTE ALL"   styleClass="btn-danger"  onAction="#onRecomputeAll"/>
    </HBox>

    <!-- Filter bar -->
    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="0" bottom="0" left="24" right="24"/></padding>
        <TextField fx:id="searchField" styleClass="search-field"
                   promptText="Search fighters by name..." prefWidth="260"
                   onAction="#onRefresh"/>
        <ComboBox fx:id="orgFilter" promptText="Organization" prefWidth="140"/>
        <ComboBox fx:id="divFilter" promptText="All Divisions" prefWidth="180"/>
        <Button text="APPLY" styleClass="btn-primary" onAction="#onRefresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="caption"/>
    </HBox>

    <!-- Rankings table -->
    <TableView fx:id="rankTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colPos"      text="RANK"           prefWidth="70"/>
            <TableColumn fx:id="colOrg"      text="ORGANIZATION"   prefWidth="120"/>
            <TableColumn fx:id="colDivision" text="DIVISION"       prefWidth="180"/>
            <TableColumn fx:id="colFighter"  text="FIGHTER"        prefWidth="220"/>
            <TableColumn fx:id="colPoints"   text="TOTAL RATING"   prefWidth="120"/>
        </columns>
        <placeholder><Label text="No rankings found — click RECOMPUTE ALL to generate" styleClass="text-muted"/></placeholder>
    </TableView>
</VBox>
