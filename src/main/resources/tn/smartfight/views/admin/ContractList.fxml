<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.ContractListController"
      spacing="12" styleClass="content-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Fighter Contracts" styleClass="h2"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="New Contract" onAction="#onNew" styleClass="btn-primary"/>
        <Button text="Pay Selected" onAction="#onPay" styleClass="btn-outline"/>
        <Button text="Toggle Missed Weight" onAction="#onToggleMissed" styleClass="btn-outline"/>
        <Button text="Delete" onAction="#onDelete" styleClass="btn-danger"/>
        <Button text="Export PDF" onAction="#onExportPdf" styleClass="btn-outline"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="btn-outline"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFighter"   text="Fighter"         prefWidth="160"/>
            <TableColumn fx:id="colEvent"     text="Event"           prefWidth="180"/>
            <TableColumn fx:id="colBase"      text="Base Pay ($)"    prefWidth="100"/>
            <TableColumn fx:id="colBonus"     text="Win Bonus ($)"   prefWidth="110"/>
            <TableColumn fx:id="colPayout"    text="Payout ($)"      prefWidth="100"/>
            <TableColumn fx:id="colPaid"      text="Paid"            prefWidth="60"/>
            <TableColumn fx:id="colMissed"    text="Missed Wt"       prefWidth="90"/>
            <TableColumn fx:id="colFee"       text="Mgr Fee %"       prefWidth="80"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" styleClass="caption" text="Loading..."/>
</VBox>
