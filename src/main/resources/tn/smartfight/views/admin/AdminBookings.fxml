<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.smartfight.controller.AdminBookingsController"
      style="-fx-background-color:#0d0d0d;" spacing="0">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="24" bottom="16" left="24" right="24"/></padding>
        <VBox spacing="4">
            <Label text="EVENT BOOKINGS" styleClass="page-title"/>
            <Label text="Fan ticket management and booking archive" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ CREATE BOOKING" styleClass="btn-primary" onAction="#onCreateBooking"/>
    </HBox>

    <!-- Stats bar -->
    <HBox spacing="16" style="-fx-background-color:#111111;-fx-border-color:#2d2d2d;-fx-border-width:0 0 1 0;">
        <padding><Insets top="12" bottom="12" left="24" right="24"/></padding>
        <VBox alignment="CENTER" style="-fx-background-color:#1a1a1a;-fx-background-radius:6;-fx-padding:8 20;">
            <Label text="TOTAL BOOKINGS" style="-fx-font-size:9;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblTotal" text="0" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#fff;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-background-color:#1a1a1a;-fx-background-radius:6;-fx-padding:8 20;">
            <Label text="GROSS REVENUE" style="-fx-font-size:9;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblRevenue" text="0" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#16a34a;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-background-color:#1a1a1a;-fx-background-radius:6;-fx-padding:8 20;">
            <Label text="CONFIRMED" style="-fx-font-size:9;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblConfirmed" text="0" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#16a34a;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-background-color:#1a1a1a;-fx-background-radius:6;-fx-padding:8 20;">
            <Label text="CANCELLED" style="-fx-font-size:9;-fx-text-fill:#6b7280;-fx-font-weight:bold;"/>
            <Label fx:id="lblCancelled" text="0" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#dc2626;"/>
        </VBox>
    </HBox>

    <!-- Filter bar -->
    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="0" bottom="0" left="24" right="24"/></padding>
        <ComboBox fx:id="eventFilter" promptText="All Events" prefWidth="240"/>
        <ComboBox fx:id="statusFilter" promptText="All Status" prefWidth="150">
            <items>
                <javafx.collections.FXCollections fx:factory="observableArrayList">
                    <String fx:value="ALL"/>
                    <String fx:value="CONFIRMED"/>
                    <String fx:value="PENDING"/>
                    <String fx:value="CANCELLED"/>
                </javafx.collections.FXCollections>
            </items>
        </ComboBox>
        <Button text="FILTER" styleClass="btn-primary" onAction="#onFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="caption"/>
    </HBox>

    <!-- Bookings table -->
    <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colUser"   text="USER"    prefWidth="120"/>
            <TableColumn fx:id="colEvent"  text="EVENT"   prefWidth="200"/>
            <TableColumn fx:id="colType"   text="TYPE"    prefWidth="140"/>
            <TableColumn fx:id="colEmail"  text="EMAIL"   prefWidth="180"/>
            <TableColumn fx:id="colAmount" text="AMOUNT"  prefWidth="90"/>
            <TableColumn fx:id="colQty"    text="QTY"     prefWidth="60"/>
            <TableColumn fx:id="colStatus" text="STATUS"  prefWidth="110"/>
            <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="150"/>
        </columns>
        <placeholder><Label text="No bookings found" styleClass="text-muted"/></placeholder>
    </TableView>
</VBox>
